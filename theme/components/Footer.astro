---
import {
  getTranslations,
  getLocaleFromUrl,
  getLocalizedUrl,
} from "@theme/i18n/utils";
import LanguageSwitcher from "@theme/components/LanguageSwitcher.astro";

import config from "~/config/config.json";
import siteSettings from "~/config/site-settings.json";

import Facebook from "./SVGs/Facebook.astro";
import Linkedin from "./SVGs/Linkedin.astro";
import Twitter from "./SVGs/Twitter.astro";
import Pinterest from "./SVGs/Pinterest.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const socialLogos: Record<string, any> = {
  facebook: Facebook,
  linkedin: Linkedin,
  twitter: Twitter,
  pinterest: Pinterest,
};

const getSocialLogoMarkup = (name: string) =>
  socialLogos[name.toLowerCase()] ?? null;

// Color mappings for stats section
const statsColorMap: Record<string, string> = {
  sky: "text-sky-400",
  green: "text-emerald-400",
  purple: "text-purple-400",
  amber: "text-amber-400",
};

const statsBorderMap: Record<string, string> = {
  sky: "hover:border-sky-500/30",
  green: "hover:border-emerald-500/30",
  purple: "hover:border-purple-500/30",
  amber: "hover:border-amber-500/30",
};

// All footer data from config — fully dynamic
const linkColumns = siteSettings.footer?.linkColumns || [];
const linkSections = siteSettings.footer?.linkSections || [];
const footerDescription =
  t.footer_desc || siteSettings.footer?.description || t.footer_description;
const newsletter = siteSettings.footer?.newsletter || {
  title: "Stay Updated",
  text: "",
  buttonText: "Subscribe →",
  placeholder: "you@email.com",
};
const statsSection = siteSettings.footer?.statsSection || {
  title: "",
  items: [],
};
const copyrightText =
  t["Built with ❤️ by"] ||
  siteSettings.footer?.copyrightText ||
  "Built with ❤️ by";
const brandName = siteSettings.footer?.brandName || "";
---

<footer class="relative mt-8 md:mt-16 overflow-hidden">
  <!-- Gradient top accent -->
  <div class="h-1 bg-gradient-to-r from-sky-500 via-blue-500 to-indigo-500">
  </div>

  <div class="bg-gradient-to-b from-slate-900 to-slate-950 relative">
    <!-- Subtle pattern -->
    <div
      class="absolute inset-0 opacity-[0.02]"
      style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>

    <div class="relative z-10">
      <!-- ═══ ROW 1: Brand + Link Columns ═══ -->
      <div class="max-w-7xl mx-auto px-8 pt-16 pb-14">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
          <!-- Brand Column -->
          <div class="lg:col-span-3">
            <a
              href={getLocalizedUrl("/", locale)}
              class="inline-flex items-center gap-3 mb-6 group"
            >
              <img
                src="/images/logo.png"
                width="44"
                height="44"
                alt={t["Footer Logo"]}
                loading="lazy"
                class="group-hover:scale-105 transition-transform duration-300"
              />
              <span class="font-bold text-white text-xl tracking-tight"
                >{t.site_title}</span
              >
            </a>
            <p class="text-slate-400 text-sm leading-relaxed mb-8">
              {footerDescription}
            </p>

            <!-- Social Icons -->
            {
              config.social.find((item) => !!item.url) && (
                <div class="flex gap-3">
                  {config.social.map((item) => {
                    if (!item.url) return null;
                    const IconMarkup = getSocialLogoMarkup(item.name);
                    if (!IconMarkup) return null;
                    return (
                      <a
                        href={item.url}
                        title={item.name}
                        class="w-10 h-10 rounded-xl bg-slate-800/50 border border-slate-700/40 flex items-center justify-center hover:bg-sky-600 hover:border-sky-500 transition-all duration-300 group"
                      >
                        <IconMarkup class="w-5 h-5 text-slate-400 group-hover:text-white transition-colors" />
                      </a>
                    );
                  })}
                </div>
              )
            }
          </div>

          <!-- Dynamic Link Columns -->
          {
            linkColumns.map((col) => (
              <div class="lg:col-span-3">
                <h3 class="text-sm font-semibold text-white mb-5 pb-3 border-b border-slate-800">
                  {t[col.title] || col.title}
                </h3>
                <ul class="space-y-3.5">
                  {col.links.map((link) => (
                    <li>
                      <a
                        href={getLocalizedUrl(link.url, locale)}
                        class="text-slate-400 hover:text-white text-sm transition-colors duration-200 inline-flex items-center gap-2 group"
                      >
                        <span class="w-1 h-1 rounded-full bg-sky-500/60 group-hover:bg-sky-400 transition-colors" />
                        {t[link.name] || link.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ═══ ROW 2: Dynamic Sections, Newsletter, Stats ═══ -->
      <div class="border-t border-slate-800/60">
        <div class="max-w-7xl mx-auto px-8 py-14">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-14">
            <!-- Dynamic Link Sections (Support, Legal, etc.) -->
            {
              linkSections.map((section) => (
                <div class="lg:col-span-2">
                  <h3 class="text-sm font-semibold text-white mb-5 pb-3 border-b border-slate-800">
                    {t[section.title] || section.title}
                  </h3>
                  <ul class="space-y-3.5">
                    {section.links.map((link) => (
                      <li>
                        <a
                          href={getLocalizedUrl(link.url, locale)}
                          class="text-slate-400 hover:text-white text-sm transition-colors duration-200 inline-flex items-center gap-2 group"
                        >
                          <span class="w-1 h-1 rounded-full bg-sky-500/60 group-hover:bg-sky-400 transition-colors" />
                          {t[link.name] || link.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }

            <!-- Newsletter -->
            <div class="lg:col-span-3">
              <h3
                class="text-sm font-semibold text-white mb-5 pb-3 border-b border-slate-800"
              >
                {t[newsletter.title] || newsletter.title}
              </h3>
              <p class="text-slate-400 text-sm mb-5 leading-relaxed">
                {t.footer_newsletter_text || newsletter.text}
              </p>
              <form class="space-y-3" onsubmit="return false;">
                <input
                  type="email"
                  placeholder={newsletter.placeholder}
                  class="w-full bg-slate-800/60 border border-slate-700/50 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500/40 focus:border-sky-500/50 transition-all"
                />
                <button
                  type="submit"
                  class="w-full bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white font-medium py-3 rounded-lg text-sm transition-all duration-300 shadow-lg shadow-sky-900/25 hover:shadow-sky-800/40"
                >
                  {t[newsletter.buttonText] || newsletter.buttonText}
                </button>
              </form>
            </div>

            <!-- Stats -->
            {
              statsSection.items && statsSection.items.length > 0 && (
                <div class="lg:col-span-5">
                  <h3 class="text-sm font-semibold text-white mb-5 pb-3 border-b border-slate-800">
                    {t[statsSection.title] || statsSection.title}
                  </h3>
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    {statsSection.items.map((stat) => {
                      const textColor =
                        statsColorMap[stat.color] || "text-sky-400";
                      const borderColor =
                        statsBorderMap[stat.color] || "hover:border-slate-600";
                      return (
                        <div
                          class={`bg-slate-800/30 rounded-xl p-5 border border-slate-700/25 text-center transition-colors ${borderColor}`}
                        >
                          <p class={`text-2xl font-bold mb-1 ${textColor}`}>
                            {stat.value}
                          </p>
                          <p class="text-xs text-slate-500">
                            {t[stat.label] || stat.label}
                          </p>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </div>

      <!-- ═══ Copyright Bar ═══ -->
      <div class="border-t border-slate-800/40">
        <div
          class="max-w-7xl mx-auto px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <p class="text-slate-500 text-xs">
            &copy; {new Date().getFullYear()}
            {t.site_title}. {copyrightText}
            <span
              class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent font-medium"
              >{brandName}</span
            >.
          </p>
          <LanguageSwitcher />
        </div>
      </div>
    </div>
  </div>
</footer>
