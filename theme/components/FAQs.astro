---
import { getTranslations, getLocaleFromUrl } from '@theme/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

interface FAQ {
  question: string;
  answer: string;
  display?: boolean;
}

const { faqs } = Astro.props as { faqs: FAQ[] };
---

{
  faqs.length > 0 && (
    <section class="bg-white shadow-sm mt-8 p-6 rounded-xl">
      <h2 class="font-semibold text-slate-900 text-xl">{t['Frequently Asked Questions']}</h2>
      <div class="space-y-3 mt-4">
        {faqs.map((faq: FAQ) => faq.display !== false && (
          <details class="p-4 border border-slate-200 rounded-xl">
            <summary class="-m-4 -mb-0 p-4 pb-0 font-medium text-slate-900 cursor-pointer">{faq.question}</summary>
            <div class="mt-2 text-slate-700">{faq.answer}</div>
          </details>
        ))}
      </div>
    </section>
  )
}
