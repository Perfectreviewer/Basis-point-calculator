---
import { getTranslations, getLocaleFromUrl } from "@theme/i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

interface FAQ {
  question: string;
  answer: string;
  display?: boolean;
}

const { faqs } = Astro.props as { faqs: FAQ[] };
---

{
  faqs.length > 0 && (
    <section class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-2xl rounded-3xl p-8 shadow-[0_8px_32px_rgba(0,0,0,0.04)] dark:shadow-none border border-white/60 dark:border-slate-800 transition-all ring-1 ring-white/50 mt-12">
      <h2 class="font-bold text-slate-900 dark:text-white text-2xl font-serif tracking-tight mb-8">
        {t["Frequently Asked Questions"]}
      </h2>
      <div class="space-y-4">
        {faqs.map(
          (faq: FAQ) =>
            faq.display !== false && (
              <details class="group border border-slate-200 dark:border-slate-700/50 rounded-2xl bg-white/50 dark:bg-slate-800/50 overflow-hidden transition-all hover:border-indigo-200 dark:hover:border-indigo-900/50 hover:shadow-md">
                <summary class="flex justify-between items-center p-5 font-bold text-slate-800 dark:text-white cursor-pointer select-none hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                  <span class="text-[15px]">{faq.question}</span>
                  <span class="transition-transform duration-300 group-open:rotate-180 bg-slate-100 dark:bg-slate-700 p-1.5 rounded-full text-slate-500 dark:text-slate-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </span>
                </summary>
                <div class="px-5 pb-5 pt-0 text-slate-600 dark:text-slate-300 leading-relaxed text-sm">
                  <div class="pt-4 border-t border-slate-100 dark:border-slate-700/50">
                    {faq.answer}
                  </div>
                </div>
              </details>
            ),
        )}
      </div>
    </section>
  )
}
