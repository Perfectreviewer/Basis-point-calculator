---
import siteSettings from "~/config/site-settings.json";

const cp = siteSettings.contactPage || {};
const accessKey = cp.formAccessKey || "";
const directEmail = cp.directEmail || "";
const directEmailText = cp.directEmailText || "Or email us directly";
const submitText = cp.submitButtonText || "Send";
const successMsg = cp.successMessage || "Form submitted successfully.";
const errorMsg = cp.errorMessage || "Error submitting form. Please try again.";
const fields = cp.fields || [];
---

<form
  id="contact-form"
  class="space-y-4 bg-white shadow mt-6 p-6 rounded-xl"
  data-success={successMsg}
  data-error={errorMsg}
>
  {
    fields.map((field: any) => (
      <div>
        <label class="block mb-1 text-slate-700 text-sm" for={field.name}>
          {field.label}
        </label>
        {field.type === "textarea" ? (
          <textarea
            required={field.required}
            id={field.name}
            name={field.name}
            rows={field.rows || 4}
            placeholder={field.placeholder}
            class="px-4 py-2 border border-slate-200 rounded-lg w-full"
          />
        ) : (
          <input
            required={field.required}
            id={field.name}
            name={field.name}
            type={field.type || "text"}
            placeholder={field.placeholder}
            class="px-4 py-2 border border-slate-200 rounded-lg w-full"
          />
        )}
      </div>
    ))
  }

  <!-- Web3Forms access key -->
  <input type="hidden" name="access_key" value={accessKey} />

  <div class="flex justify-between items-center">
    <button
      type="submit"
      class="bg-sky-600 hover:bg-sky-700 px-5 py-2 rounded-lg text-white"
    >
      {submitText}
    </button>
    {
      directEmail && (
        <a class="text-sky-600" href={`mailto:${directEmail}`}>
          {directEmailText}
        </a>
      )
    }
  </div>

  <span id="form-result" class="text-slate-600 text-sm"></span>
</form>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const resultEl = document.getElementById("form-result");

    if (!form || !resultEl) return;

    const successMsg =
      form.getAttribute("data-success") || "Form submitted successfully.";
    const errorMsg =
      form.getAttribute("data-error") ||
      "Error submitting form. Please try again.";

    form.addEventListener("submit", async function (event) {
      event.preventDefault();
      resultEl.textContent = "Sending...";

      const formData = new FormData(form);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          resultEl.textContent = successMsg;
          form.reset();
        } else {
          resultEl.textContent = errorMsg;
        }
      } catch (error) {
        resultEl.textContent = "Network error. Please try again.";
      }
    });
  })();
</script>
