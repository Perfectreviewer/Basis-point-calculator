---
import adsConfig from "~/config/ads-settings.json";

interface Props {
  slot: string;
  class?: string;
}

const { slot, class: className } = Astro.props;
const config = adsConfig as any;
const publisherId = config.publisherId;
const slotConfig = config.slots?.[slot];

// Don't render if no publisher ID or slot is disabled
const shouldRender = publisherId && slotConfig?.enabled && slotConfig?.slotId;

// Determine ad format and layout attributes
const format = slotConfig?.format || "auto";
let adFormat = "auto";
let adLayout = "";
let adLayoutKey = "";

if (format === "horizontal") {
  adFormat = "auto";
} else if (format === "rectangle") {
  adFormat = "auto";
} else if (format === "fluid") {
  adFormat = "fluid";
  adLayout = "in-article";
  adLayoutKey = "-fb+5w+4e-db+86";
}
---

{
  shouldRender && (
    <div class:list={["ad-slot", `ad-slot-${slot}`, className]}>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={`ca-pub-${publisherId}`}
        data-ad-slot={slotConfig.slotId}
        data-ad-format={adFormat}
        data-full-width-responsive="true"
        {...(adLayout ? { "data-ad-layout": adLayout } : {})}
        {...(adLayoutKey ? { "data-ad-layout-key": adLayoutKey } : {})}
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  )
}

<style>
  .ad-slot {
    text-align: center;
    overflow: hidden;
    margin: 16px 0;
  }
  .ad-slot-header_banner {
    margin: 0;
    padding: 8px 0;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
  }
  .ad-slot-footer_banner {
    margin: 0;
    padding: 8px 0;
    background: #f8fafc;
    border-top: 1px solid #f1f5f9;
  }
  .ad-slot-blog_sidebar {
    margin: 0 0 20px 0;
  }
  .ad-slot-homepage_mid {
    margin: 24px 0;
    max-width: 728px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
