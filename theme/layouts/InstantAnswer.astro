---
import Layout from "@theme/layouts/Layout.astro";
import FAQs from "@theme/components/FAQs.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils.ts";
import indexTranslations from "~/i18n/index.json";

interface Props {
  bps: number;
}

export async function getStaticPaths() {
  return Object.keys(indexTranslations).map((locale) => ({
    params: { lang: locale === "en" ? undefined : locale },
  }));
}

const { bps } = Astro.props;
const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const siteURL = Astro.url.origin;
const pageURL = Astro.url.href;

// Compute conversions
const pct = bps / 100;
const decimal = bps / 10000;
const permille = bps / 10;
const perHundredK = (bps / 10000) * 100000;
const perMillion = (bps / 10000) * 1000000;

const pctStr = pct.toFixed(2).replace(/\.?0+$/, "");
const decStr = decimal.toFixed(6).replace(/\.?0+$/, "");
const permilleStr = permille.toFixed(3).replace(/\.?0+$/, "");
const perHundredKStr = perHundredK.toLocaleString("en-US", {
  maximumFractionDigits: 2,
});
const perMillionStr = perMillion.toLocaleString("en-US", {
  maximumFractionDigits: 2,
});

const pageTitle = `${bps} Basis Points = ${pctStr}% | BPS to Percentage`;
const pageDescription = `${bps} basis points (bps) equals ${pctStr}% in percentage, ${decStr} in decimal. Convert ${bps} bps instantly with our free calculator.`;

// Real-world impact examples
const mortgageAmount = 400000;
const mortgageImpact = (mortgageAmount * decimal).toLocaleString("en-US", {
  maximumFractionDigits: 2,
});

const loanAmount = 250000;
const loanImpact = (loanAmount * decimal).toLocaleString("en-US", {
  maximumFractionDigits: 2,
});

const portfolioAmount = 1000000;
const portfolioImpact = (portfolioAmount * decimal).toLocaleString("en-US", {
  maximumFractionDigits: 2,
});

// Nearby values for related conversions
const nearbyValues = [
  { bps: Math.max(1, bps - 15), label: "" },
  { bps: Math.max(1, bps - 10), label: "" },
  { bps: Math.max(1, bps - 5), label: "" },
  { bps: bps + 5, label: "" },
  { bps: bps + 10, label: "" },
  { bps: bps + 15, label: "" },
].filter((v) => v.bps !== bps && v.bps > 0);

// FAQs
const faqs = [
  {
    question: `What is ${bps} basis points in percentage?`,
    answer: `${bps} basis points equals ${pctStr}%. To convert, divide basis points by 100: ${bps} ÷ 100 = ${pctStr}%.`,
  },
  {
    question: `What is ${bps} bps in decimal?`,
    answer: `${bps} basis points equals ${decStr} in decimal form. To convert, divide basis points by 10,000: ${bps} ÷ 10,000 = ${decStr}.`,
  },
  {
    question: `How much is ${bps} basis points on a $${mortgageAmount.toLocaleString()} mortgage?`,
    answer: `A ${bps} basis point change on a $${mortgageAmount.toLocaleString()} mortgage equals $${mortgageImpact} per year in additional interest.`,
  },
  {
    question: `How do you calculate ${bps} basis points?`,
    answer: `To calculate ${bps} basis points: divide by 100 to get percentage (${pctStr}%), or divide by 10,000 to get the decimal (${decStr}). Multiply the decimal by any amount to find the dollar impact.`,
  },
  {
    question: `Is ${bps} basis points a lot?`,
    answer:
      bps <= 10
        ? `${bps} basis points (${pctStr}%) is a small change, but can be significant on large amounts. On $1 million, ${bps} bps equals $${perMillionStr}.`
        : bps <= 50
          ? `${bps} basis points (${pctStr}%) is a moderate change. The Federal Reserve often moves rates by 25 bps. On a $1M portfolio, ${bps} bps equals $${perMillionStr} per year.`
          : `${bps} basis points (${pctStr}%) is a significant change. On a $1 million portfolio, this equals $${perMillionStr} per year.`,
  },
];

// Related calculators
const relatedCalculators = [
  {
    name: t.bp_to_pct_title || "BPS to Percentage Calculator",
    url: "/bps-calculators/basis-point-to-percentage/",
  },
  {
    name: t.pct_to_bp_title || "Percentage to BPS Calculator",
    url: "/bps-calculators/percentage-to-basis-point/",
  },
  {
    name: t.bp_examples_title || "Basis Point Examples",
    url: "/bps-calculators/basis-point-examples/",
  },
];
---

<Layout title={`${pageTitle} | ${t.site_title}`} description={pageDescription}>
  <!-- Instant Answer Schema -->
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: pageTitle,
      url: pageURL,
      applicationCategory: "FinanceApplication",
      operatingSystem: "All",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      description: pageDescription,
      publisher: {
        "@type": "Organization",
        name: t.site_title,
        url: siteURL,
      },
    })}
  />

  <!-- FAQ Schema -->
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    })}
  />

  <!-- Dynamic UI Styles -->
  <style>
    @keyframes valueGlow {
      0% {
        color: inherit;
      }
      30% {
        color: #0284c7;
        transform: scale(1.05);
      }
      100% {
        color: inherit;
        transform: scale(1);
      }
    }
    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .val-animate {
      transition: all 0.3s ease;
      display: inline-block;
    }
    .val-animate.flash {
      animation: valueGlow 0.5s ease-out;
    }
    .ia-input-wrapper {
      position: relative;
      transition:
        box-shadow 0.3s ease,
        border-color 0.3s ease;
    }
    .ia-input-wrapper:focus-within {
      box-shadow:
        0 0 0 3px rgba(56, 189, 248, 0.3),
        0 8px 25px rgba(56, 189, 248, 0.12);
      border-color: #38bdf8;
    }
    .ia-input {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      transition: all 0.2s ease;
    }
    .impact-card {
      transition: all 0.3s ease;
    }
    .impact-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }
    .impact-val {
      font-size: 1.25rem;
      font-weight: 700;
      transition: all 0.3s ease;
      display: inline-block;
    }
    .impact-val.flash {
      animation: valueGlow 0.5s ease-out;
    }
    .nearby-row {
      transition: all 0.3s ease;
    }
    .nearby-row:hover {
      background: #f0f9ff;
    }
    .nearby-row.is-current {
      background: linear-gradient(to right, #e0f2fe, #ede9fe);
      font-weight: 700;
    }
    .conv-value {
      font-size: 1.125rem;
      font-weight: 700;
      transition: all 0.3s ease;
      display: inline-block;
    }
    .conv-value.flash {
      animation: valueGlow 0.5s ease-out;
    }
    .hero-answer {
      transition: all 0.3s ease;
    }
    .quick-answer-val {
      transition: all 0.3s ease;
    }
    .slider-track {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 6px;
      background: linear-gradient(to right, #bae6fd, #818cf8);
      border-radius: 99px;
      outline: none;
    }
    .slider-track::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: linear-gradient(135deg, #0ea5e9, #6366f1);
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(99, 102, 241, 0.4);
      transition: transform 0.15s ease;
    }
    .slider-track::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }
    .slider-track::-moz-range-thumb {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: linear-gradient(135deg, #0ea5e9, #6366f1);
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(99, 102, 241, 0.4);
      border: none;
    }
  </style>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Hero Answer Box with Integrated Input -->
      <section class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div
          class="bg-gradient-to-r from-sky-600 to-indigo-600 px-6 py-4 flex items-center justify-between"
        >
          <p class="text-sky-100 text-sm font-medium">Instant Answer</p>
          <span class="text-xs text-sky-200 bg-white/10 px-3 py-1 rounded-full"
            >Live Calculator</span
          >
        </div>
        <div class="p-6">
          <div
            class="flex flex-col sm:flex-row items-start sm:items-center gap-3"
          >
            <div
              class="ia-input-wrapper flex items-center border-2 border-slate-200 rounded-xl px-4 py-2 bg-slate-50 w-full sm:w-auto"
            >
              <input
                id="ia-bps"
                type="number"
                inputmode="decimal"
                class="ia-input w-24 bg-transparent border-none outline-none text-slate-800"
                placeholder="40"
              />
              <span class="text-slate-400 font-medium ml-1">bps</span>
            </div>
            <span class="text-2xl text-slate-300 hidden sm:block">=</span>
            <h1
              class="hero-answer text-3xl md:text-4xl font-bold text-slate-800 tracking-tight"
            >
              <span id="hero-pct" class="val-animate text-sky-700"
                >{pctStr}%</span
              >
            </h1>
          </div>
          <p class="text-slate-500 mt-3" id="hero-subtitle">
            <span id="hero-bps-label" class="val-animate">{bps}</span> bps =
            <span id="hero-pct2" class="val-animate">{pctStr}%</span> =
            <span id="hero-dec" class="val-animate">{decStr}</span> (decimal) =
            <span id="hero-pml" class="val-animate">{permilleStr}‰</span> (permille)
          </p>

          <!-- Slider -->
          <div class="mt-4">
            <input
              id="ia-slider"
              type="range"
              min="1"
              max="500"
              class="slider-track"
            />
            <div class="flex justify-between text-xs text-slate-400 mt-1">
              <span>1 bps</span>
              <span>250 bps</span>
              <span>500 bps</span>
            </div>
          </div>

          <div class="mt-4 p-4 bg-sky-50 rounded-xl border border-sky-100">
            <p class="text-slate-700 text-sm">
              <strong>Formula:</strong>
              <span id="hero-formula" class="val-animate"
                >{bps} basis points ÷ 100 = {pctStr}%</span
              >
            </p>
          </div>
        </div>
      </section>

      <!-- Live Conversion Table -->
      <section class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-semibold text-slate-800">
          <span id="conv-title" class="val-animate">{bps}</span> Basis Points — All
          Conversions
        </h2>
        <div class="mt-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div
              class="flex items-center justify-between p-4 bg-sky-50/50 rounded-xl border border-sky-100/50"
            >
              <span class="text-slate-500 font-medium text-sm">Percentage</span>
              <span id="conv-pct" class="conv-value text-sky-700"
                >{pctStr}%</span
              >
            </div>
            <div
              class="flex items-center justify-between p-4 bg-indigo-50/50 rounded-xl border border-indigo-100/50"
            >
              <span class="text-slate-500 font-medium text-sm">Decimal</span>
              <span id="conv-dec" class="conv-value text-indigo-700"
                >{decStr}</span
              >
            </div>
            <div
              class="flex items-center justify-between p-4 bg-violet-50/50 rounded-xl border border-violet-100/50"
            >
              <span class="text-slate-500 font-medium text-sm"
                >Permille (‰)</span
              >
              <span id="conv-pml" class="conv-value text-violet-700"
                >{permilleStr}‰</span
              >
            </div>
            <div
              class="flex items-center justify-between p-4 bg-emerald-50/50 rounded-xl border border-emerald-100/50"
            >
              <span class="text-slate-500 font-medium text-sm"
                >Per $100,000</span
              >
              <span id="conv-100k" class="conv-value text-emerald-700"
                >${perHundredKStr}</span
              >
            </div>
          </div>
          <div
            class="mt-3 flex items-center justify-between p-5 bg-gradient-to-r from-sky-50 to-indigo-50 rounded-xl border border-sky-100"
          >
            <span class="text-slate-600 font-semibold">Per $1,000,000</span>
            <span id="conv-1m" class="text-2xl font-bold text-sky-700"
              >${perMillionStr}</span
            >
          </div>
        </div>
      </section>

      <!-- Real-World Impact (Dynamic) -->
      <section class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-semibold text-slate-800">
          Real-World Impact of <span
            id="impact-title"
            class="val-animate text-sky-700">{bps}</span
          > Basis Points
        </h2>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div
            class="impact-card p-5 bg-gradient-to-br from-blue-50 to-sky-50 rounded-xl border border-sky-100"
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="text-2xl">🏠</span>
              <h3 class="font-semibold text-slate-800">Mortgage</h3>
            </div>
            <p class="impact-val text-sky-700" id="impact-mortgage">
              ${mortgageImpact}
            </p>
            <p class="text-xs text-slate-500 mt-1">per year on $400K</p>
          </div>
          <div
            class="impact-card p-5 bg-gradient-to-br from-indigo-50 to-violet-50 rounded-xl border border-indigo-100"
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="text-2xl">🚗</span>
              <h3 class="font-semibold text-slate-800">Auto Loan</h3>
            </div>
            <p class="impact-val text-indigo-700" id="impact-loan">
              ${loanImpact}
            </p>
            <p class="text-xs text-slate-500 mt-1">per year on $250K</p>
          </div>
          <div
            class="impact-card p-5 bg-gradient-to-br from-emerald-50 to-teal-50 rounded-xl border border-emerald-100"
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="text-2xl">📈</span>
              <h3 class="font-semibold text-slate-800">Portfolio</h3>
            </div>
            <p class="impact-val text-emerald-700" id="impact-portfolio">
              ${portfolioImpact}
            </p>
            <p class="text-xs text-slate-500 mt-1">per year on $1M</p>
          </div>
        </div>
      </section>

      <!-- Nearby Conversions (Dynamic) -->
      <section class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-semibold text-slate-800">
          Related BPS Conversions
        </h2>
        <div class="mt-4 overflow-x-auto" id="nearby-table-wrap">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50">
                <th class="text-left py-2 px-3 font-medium text-slate-600"
                  >Basis Points</th
                >
                <th class="text-left py-2 px-3 font-medium text-slate-600"
                  >Percentage</th
                >
                <th class="text-left py-2 px-3 font-medium text-slate-600"
                  >Decimal</th
                >
                <th
                  class="text-left py-2 px-3 font-medium text-slate-600 hidden sm:table-cell"
                  >Per $1M</th
                >
              </tr>
            </thead>
            <tbody id="nearby-tbody" class="text-slate-700"> </tbody>
          </table>
        </div>
      </section>

      <!-- FAQs -->
      <FAQs faqs={faqs} />
    </div>

    <!-- Sidebar -->
    <aside class="space-y-6">
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h3 class="font-semibold text-lg mb-4">
          {t.related_calculators || "Related Calculators"}
        </h3>
        <ul class="space-y-2">
          {
            relatedCalculators.map((calc) => (
              <li>
                <a
                  href={getLocalizedUrl(calc.url, locale)}
                  class="text-sky-600 hover:text-sky-800 hover:underline flex items-center gap-2"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                  {calc.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Quick Info -->
      <div class="bg-white rounded-2xl shadow p-6">
        <h3 class="font-semibold">
          {t.quick_relations_title || "Quick Relations"}
        </h3>
        <ul class="list-disc pl-6 mt-2 text-sm text-slate-700 space-y-1">
          <li>1 bps = 0.01% = 0.1‰ = 0.0001</li>
          <li>10 bps = 0.10% = 1‰ = 0.001</li>
          <li>100 bps = 1.00% = 10‰ = 0.01</li>
          <li>250 bps = 2.50% = 25‰ = 0.025</li>
        </ul>
      </div>

      <!-- Quick Answer Card (Dynamic) -->
      <div
        class="bg-gradient-to-br from-sky-500 to-indigo-600 rounded-2xl shadow-lg p-6 text-white"
      >
        <h3 class="font-bold text-lg mb-3">Quick Answer</h3>
        <div class="space-y-2 text-sm">
          <p class="text-lg">
            <strong id="qa-bps">{bps} bps</strong> = <strong id="qa-pct"
              >{pctStr}%</strong>
          </p>
          <p>Divide by 100 → percentage</p>
          <p>Divide by 10,000 → decimal</p>
        </div>
      </div>
    </aside>
  </div>

  <script define:vars={{ bps }}>
    // Helpers
    const fmt = (n, d) => n.toFixed(d).replace(/\.?0+$/, "");
    const fmtUSD = (n) =>
      n.toLocaleString("en-US", { maximumFractionDigits: 2 });

    function flash(el) {
      if (!el) return;
      el.classList.remove("flash");
      void el.offsetWidth; // trigger reflow
      el.classList.add("flash");
    }

    function setVal(id, val) {
      const el = document.getElementById(id);
      if (el && el.textContent !== val) {
        el.textContent = val;
        flash(el);
      }
    }

    // DOM refs
    const $input = document.getElementById("ia-bps");
    const $slider = document.getElementById("ia-slider");
    const $tbody = document.getElementById("nearby-tbody");

    function buildNearby(v) {
      const offsets = [-15, -10, -5, 0, 5, 10, 15];
      const rows = offsets.map((o) => v + o).filter((b) => b > 0);

      $tbody.innerHTML = rows
        .map((b) => {
          const isCurrent = b === v;
          const p = fmt(b / 100, 2);
          const d = fmt(b / 10000, 6);
          const m = fmtUSD((b / 10000) * 1000000);
          return `<tr class="nearby-row border-b border-slate-100 ${isCurrent ? "is-current" : ""}">
            <td class="py-2 px-3 ${isCurrent ? "font-bold" : ""}">${b} bps${isCurrent ? " ←" : ""}</td>
            <td class="py-2 px-3">${p}%</td>
            <td class="py-2 px-3">${d}</td>
            <td class="py-2 px-3 hidden sm:table-cell">$${m}</td>
          </tr>`;
        })
        .join("");
    }

    function updateAll() {
      const v = parseFloat($input.value);
      if (isNaN(v) || v < 0) return;

      const p = v / 100;
      const d = v / 10000;
      const pml = v / 10;
      const per100k = d * 100000;
      const per1m = d * 1000000;

      // Hero
      setVal("hero-pct", fmt(p, 2) + "%");
      setVal("hero-bps-label", String(v));
      setVal("hero-pct2", fmt(p, 2) + "%");
      setVal("hero-dec", fmt(d, 6));
      setVal("hero-pml", fmt(pml, 3) + "‰");
      setVal("hero-formula", `${v} basis points ÷ 100 = ${fmt(p, 2)}%`);

      // Conversion cards
      setVal("conv-title", String(v));
      setVal("conv-pct", fmt(p, 2) + "%");
      setVal("conv-dec", fmt(d, 6));
      setVal("conv-pml", fmt(pml, 3) + "‰");
      setVal("conv-100k", "$" + fmtUSD(per100k));
      setVal("conv-1m", "$" + fmtUSD(per1m));

      // Real-world impact
      setVal("impact-title", String(v));
      setVal("impact-mortgage", "$" + fmtUSD(d * 400000));
      setVal("impact-loan", "$" + fmtUSD(d * 250000));
      setVal("impact-portfolio", "$" + fmtUSD(d * 1000000));

      // Quick answer sidebar
      setVal("qa-bps", v + " bps");
      setVal("qa-pct", fmt(p, 2) + "%");

      // Nearby table
      buildNearby(v);

      // Sync slider ↔ input
      $slider.value = Math.min(v, 500);
    }

    // Events
    $input.addEventListener("input", updateAll);
    $slider.addEventListener("input", () => {
      $input.value = $slider.value;
      updateAll();
    });

    // Initialize
    $input.value = String(bps);
    $slider.value = Math.min(bps, 500);
    updateAll();
  </script>
</Layout>
