---
import Layout from "@theme/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import indexTranslations from "~/i18n/index.json";

export interface Props {
  [key: string]: any;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const posts = await getCollection("blog");
const entry = posts.find((post) => post.id === Astro.params.id);

if (!entry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);

// Get related posts (same category, exclude current)
const relatedPosts = posts
  .filter(
    (post) =>
      post.data.category === entry.data.category && post.id !== entry.id,
  )
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);

// Calculate reading time (approx 200 words per minute)
const wordCount = entry.body ? entry.body.split(/\s+/g).length : 0;
const readTime = Math.ceil(wordCount / 200);

const siteURL = Astro.url.origin;
const canonical = `${siteURL}/blog/${entry.id}/`;
const imageUrl = `${siteURL}${entry.data.image}`;

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  img={entry.data.image}
  title={entry.data.title + " | " + indexTranslations.en.site_title}
  description={entry.data.description}
>
  <!-- Schema.org JSON-LD -->
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      mainEntityOfPage: canonical,
      headline: entry.data.title,
      description: entry.data.description,
      image: [imageUrl],
      datePublished: entry.data.date.toISOString(),
      dateModified: entry.data.date.toISOString(), // Should be updated if modified date exists
      author: {
        "@type": "Person",
        name: entry.data.author,
      },
      publisher: {
        "@type": "Organization",
        name: indexTranslations.en.site_title,
        logo: {
          "@type": "ImageObject",
          url: `${siteURL}/images/logo.png`,
        },
      },
    })}
  />

  <main class="bg-gray-50 min-h-screen pb-20">
    <!-- Hero Section -->
    <header
      class="relative bg-white pt-32 pb-16 lg:pt-40 lg:pb-24 overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,rgba(255,255,255,0.6))] -z-10"
      >
      </div>
      <div class="container mx-auto px-6 max-w-5xl text-center">
        <!-- Category Pill -->
        <a
          href={`/blog/category/${entry.data.category.toLowerCase()}`}
          class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-50 text-blue-600 mb-6 hover:bg-blue-100 transition-colors"
        >
          {entry.data.category}
        </a>

        <!-- Title -->
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight mb-8 leading-[1.1]"
        >
          {entry.data.title}
        </h1>

        <!-- Meta Info -->
        <div
          class="flex items-center justify-center gap-6 text-slate-500 text-sm font-medium"
        >
          <div class="flex items-center gap-2">
            <div
              class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-xs font-bold"
            >
              {entry.data.author.charAt(0)}
            </div>
            <span>{entry.data.author}</span>
          </div>
          <span class="w-1 h-1 rounded-full bg-slate-300"></span>
          <time datetime={entry.data.date.toISOString()}
            >{dateFormat.format(entry.data.date)}</time
          >
          <span class="w-1 h-1 rounded-full bg-slate-300"></span>
          <span>{readTime} min read</span>
        </div>
      </div>

      <!-- Featured Image -->
      <div class="container mx-auto px-6 max-w-6xl mt-12 md:mt-16">
        <div
          class="relative aspect-[21/9] rounded-2xl overflow-hidden shadow-xl ring-1 ring-slate-900/5"
        >
          <img
            src={entry.data.image}
            alt={`Featured image: ${entry.data.title}`}
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    <!-- Content Layout -->
    <div
      class="container mx-auto px-6 max-w-7xl mt-12 lg:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-12"
    >
      <!-- Main Content -->
      <div class="lg:col-span-8 lg:col-start-3 content-wrapper">
        <article
          class="prose prose-lg prose-slate max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 hover:prose-a:text-blue-700 prose-img:rounded-xl prose-img:shadow-lg"
        >
          <Content />
        </article>

        <!-- Divider -->
        <hr class="my-12 border-slate-200" />

        <!-- Author Bio -->
        <div
          class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm flex flex-col sm:flex-row gap-6 items-center sm:items-start text-center sm:text-left"
        >
          <div
            class="w-20 h-20 rounded-full bg-gradient-to-br from-blue-100 to-indigo-100 flex items-center justify-center flex-shrink-0 text-3xl"
          >
            👨‍💻
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              About {entry.data.author}
            </h3>
            <p class="text-slate-600 leading-relaxed">
              {entry.data.author} is a content creator and financial expert at {
                indexTranslations.en.site_title
              }. Passionate about making complex financial topics accessible to
              everyone.
            </p>
          </div>
        </div>

        <!-- Share Buttons (Mobile) -->
        <div class="mt-8 flex gap-4 justify-center lg:hidden">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-full bg-sky-50 text-sky-500 hover:bg-sky-100 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.84 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
              ></path></svg
            >
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-full bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.791-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path></svg
            >
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Reading Progress & Sticky Sidebar -->
      <aside
        class="hidden lg:block lg:col-span-2 lg:col-start-1 sticky top-32 h-fit"
      >
        <div class="flex flex-col gap-6">
          <!-- Share -->
          <div class="flex flex-col gap-3">
            <span
              class="text-xs font-bold text-slate-400 uppercase tracking-wider"
              >Share</span
            >
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(canonical)}`}
              target="_blank"
              class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-sky-500 hover:border-sky-500 transition-all group"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.84 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
                ></path></svg
              >
            </a>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`}
              target="_blank"
              class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-blue-600 hover:border-blue-600 transition-all group"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.791-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                ></path></svg
              >
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
              target="_blank"
              class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-indigo-600 hover:border-indigo-600 transition-all group"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </aside>

      <!-- TOC Sidebar (Right) -->
      <aside
        class="hidden lg:block lg:col-span-2 lg:col-start-11 sticky top-32 h-fit"
      >
        {
          headings.length > 0 && (
            <div class="flex flex-col gap-4">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                On this page
              </span>
              <nav class="flex flex-col gap-3 relative border-l border-slate-200 pl-4">
                {headings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class={`text-sm text-slate-500 hover:text-slate-900 transition-colors ${heading.depth === 3 ? "pl-4" : ""}`}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          )
        }

        <!-- CTA -->
        <div
          class="bg-blue-600 rounded-xl p-6 mt-8 text-white shadow-lg shadow-blue-600/20"
        >
          <h4 class="font-bold mb-2">Need a custom quote?</h4>
          <p class="text-sm text-blue-100 mb-4">
            Use our advanced calculators to get precise estimates.
          </p>
          <a
            href="/calculators/"
            class="block w-full text-center bg-white text-blue-600 font-bold py-2 px-4 rounded-lg text-sm hover:bg-blue-50 transition-colors"
          >
            Explore Calculators
          </a>
        </div>
      </aside>
    </div>

    <!-- Related Posts -->
    {
      relatedPosts.length > 0 && (
        <section class="container mx-auto px-6 max-w-7xl mt-24">
          <h2 class="text-2xl font-bold text-slate-900 mb-8">
            Related Articles
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {relatedPosts.map((post) => (
              <a href={`/blog/${post.id}/`} class="group block h-full">
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all h-full overflow-hidden flex flex-col">
                  <div class="aspect-[16/9] bg-slate-100 relative overflow-hidden">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                  <div class="p-6 flex flex-col flex-1">
                    <div class="text-xs font-medium text-blue-600 mb-2">
                      {post.data.category}
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors line-clamp-2">
                      {post.data.title}
                    </h3>
                    <p class="text-slate-500 text-sm line-clamp-2 mb-4 flex-1">
                      {post.data.description}
                    </p>
                    <div class="text-xs text-slate-400">
                      {dateFormat.format(post.data.date)}
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>

<style is:global>
  /* Custom Prose Styling */
  .prose {
    max-width: 65ch;
    margin: 0 auto;
    color: #334155;
  }
  .prose > * + * {
    margin-top: 1.5em;
  }
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    color: #0f172a;
    font-weight: 700;
    line-height: 1.3;
  }
  .prose h1 {
    font-size: 2.25em;
    margin-top: 0;
    margin-bottom: 0.8888889em;
  }
  .prose h2 {
    font-size: 1.75em;
    margin-top: 1.5em;
    margin-bottom: 0.8em;
  }
  .prose h3 {
    font-size: 1.3em;
    margin-top: 1.5em;
    margin-bottom: 0.6em;
  }
  .prose p {
    leading-height: 1.75;
    margin-bottom: 1.25em;
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.625em;
    margin-bottom: 1.25em;
  }
  .prose ol {
    list-style-type: decimal;
    padding-left: 1.625em;
    margin-bottom: 1.25em;
  }
  .prose blockquote {
    border-left: 4px solid #3b82f6;
    padding-left: 1em;
    font-style: italic;
    color: #475569;
    margin: 1.6em 0;
  }
  .prose img {
    width: 100%;
    border-radius: 0.75rem;
    margin-top: 2em;
    margin-bottom: 2em;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  .prose code {
    color: #ec4899;
    font-weight: 600;
    font-size: 0.875em;
    padding: 0.25em 0.3em;
    background-color: #f1f5f9;
    border-radius: 0.25rem;
  }
  .prose pre {
    overflow-x: auto;
    background-color: #1e293b;
    color: #e2e8f0;
    padding: 1em;
    border-radius: 0.5rem;
    margin-top: 1.6em;
    margin-bottom: 1.6em;
  }
  .prose pre code {
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    font-weight: 400;
    color: inherit;
    font-size: inherit;
    font-family: inherit;
    line-height: inherit;
  }
  .prose strong {
    color: #0f172a;
    font-weight: 700;
  }
  .prose a {
    color: #2563eb;
    text-decoration: underline;
    font-weight: 500;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    color: #1d4ed8;
  }
</style>
