---
import Layout from "@theme/layouts/Layout.astro";
import AdSlot from "@theme/components/AdSlot.astro";
import { getCollection, render } from "astro:content";
import indexTranslations from "~/i18n/index.json";

export interface Props {
  [key: string]: any;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const posts = await getCollection("blog");
const entry = posts.find((post) => post.id === Astro.params.id);

if (!entry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);

// Get related posts (same category, exclude current)
const relatedPosts = posts
  .filter(
    (post) =>
      post.data.category === entry.data.category && post.id !== entry.id,
  )
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);

// Calculate reading time (approx 200 words per minute)
const wordCount = entry.body ? entry.body.split(/\s+/g).length : 0;
const readTime = Math.ceil(wordCount / 200);

const siteURL = Astro.url.origin;
const canonical = `${siteURL}/guides/${entry.id}/`;
const imageUrl = entry.data.image
  ? entry.data.image.startsWith("http")
    ? entry.data.image
    : `${siteURL}${entry.data.image}`
  : `${siteURL}/images/og-image.jpg`;

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  img={entry.data.image || "/images/og-image.jpg"}
  title={entry.data.title + " | " + indexTranslations.en.site_title}
  description={entry.data.description}
>
  <!-- Schema.org JSON-LD -->
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      mainEntityOfPage: canonical,
      headline: entry.data.title,
      description: entry.data.description,
      image: [imageUrl],
      datePublished: entry.data.date.toISOString(),
      dateModified: entry.data.date.toISOString(),
      author: {
        "@type": "Person",
        name: entry.data.author,
      },
      publisher: {
        "@type": "Organization",
        name: indexTranslations.en.site_title,
        logo: {
          "@type": "ImageObject",
          url: `${siteURL}/images/logo.png`,
        },
      },
    })}
  />

  <!-- Reading Progress Bar -->
  <div class="sp-progress" id="progress-bar"></div>

  <main class="sp-main">
    <!-- ═══ HERO ═══ -->
    <header class="sp-hero">
      <div class="sp-hero-accent"></div>
      <div class="sp-hero-orb sp-hero-orb-1"></div>
      <div class="sp-hero-orb sp-hero-orb-2"></div>
      <div class="sp-hero-orb sp-hero-orb-3"></div>
      <div class="sp-hero-inner">
        <!-- Breadcrumb -->
        <nav class="sp-breadcrumb sp-reveal" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            width="12"
            height="12"><polyline points="9 18 15 12 9 6"></polyline></svg
          >
          <a href="/guides/">Guides</a>
        </nav>

        <!-- Title -->
        <h1 class="sp-title sp-reveal" style="--delay:.1s">
          {entry.data.title}
        </h1>

        {
          entry.data.description && (
            <p class="sp-subtitle sp-reveal" style="--delay:.15s">
              {entry.data.description}
            </p>
          )
        }

        <!-- Author & Meta -->
        <div class="sp-meta">
          <div class="sp-author-chip">
            <div class="sp-avatar">{entry.data.author.charAt(0)}</div>
            <div class="sp-author-text">
              <span class="sp-author-name">{entry.data.author}</span>
              <span class="sp-publish-info">
                <time datetime={entry.data.date.toISOString()}
                  >{dateFormat.format(entry.data.date)}</time
                >
                <span class="sp-dot">·</span>
                {readTime} min read
              </span>
            </div>
          </div>
        </div>
      </div>
    </header>

    {/* ─── Featured Image Banner ─── */}
    {
      entry.data.image && (
        <div class="sp-featured-img sp-reveal" style="--delay:.25s">
          <img src={entry.data.image} alt={entry.data.title} loading="eager" />
        </div>
      )
    }

    <!-- ═══ CONTENT GRID ═══ -->
    <div class="sp-grid">
      <!-- LEFT: Share Sidebar -->
      <aside class="sp-share-col">
        <div class="sp-share-rail">
          <span class="sp-share-label">Share</span>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="sp-share-btn"
            title="Share on X"
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path></svg
            >
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="sp-share-btn"
            title="Share on Facebook"
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.791-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path></svg
            >
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="sp-share-btn"
            title="Share on LinkedIn"
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
          </a>
          <button class="sp-share-btn" title="Copy link" id="copy-link-btn">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              width="16"
              height="16"
            >
              <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"
              ></path>
              <path
                d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"
              ></path>
            </svg>
          </button>
        </div>
      </aside>

      <!-- CENTER: Article -->
      <div class="sp-article-col">
        <article class="sp-prose">
          <Content />
        </article>

        <AdSlot slot="blog_in_article" />

        <!-- Divider -->
        <div class="sp-divider"></div>

        <!-- Author Bio -->
        <div class="sp-bio sp-reveal">
          <div class="sp-bio-avatar">
            <span>{entry.data.author.charAt(0)}</span>
          </div>
          <div class="sp-bio-body">
            <div class="sp-bio-header">
              <h3>Written by {entry.data.author}</h3>
              <span class="sp-bio-badge">Author</span>
            </div>
            <p>
              {entry.data.author} is a content creator and financial expert at {
                indexTranslations.en.site_title
              }. Passionate about making complex financial topics accessible to
              everyone.
            </p>
          </div>
        </div>

        <!-- Mobile Share -->
        <div class="sp-mobile-share">
          <span class="sp-share-label">Share this article</span>
          <div class="sp-mobile-btns">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(canonical)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="sp-share-btn"
              title="X"
            >
              <svg
                width="16"
                height="16"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path></svg
              >
            </a>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="sp-share-btn"
              title="Facebook"
            >
              <svg
                width="16"
                height="16"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.791-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                ></path></svg
              >
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="sp-share-btn"
              title="LinkedIn"
            >
              <svg
                width="16"
                height="16"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>

      <!-- RIGHT: TOC + CTA -->
      <aside class="sp-toc-col">
        {
          headings.length > 0 && (
            <div class="sp-toc-card">
              <div class="sp-toc-title">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  width="14"
                  height="14"
                >
                  <line x1="8" y1="6" x2="21" y2="6" />
                  <line x1="8" y1="12" x2="21" y2="12" />
                  <line x1="8" y1="18" x2="21" y2="18" />
                  <line x1="3" y1="6" x2="3.01" y2="6" />
                  <line x1="3" y1="12" x2="3.01" y2="12" />
                  <line x1="3" y1="18" x2="3.01" y2="18" />
                </svg>
                On this page
              </div>
              <nav class="sp-toc-nav" id="toc-nav">
                {headings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class={`sp-toc-link ${heading.depth === 3 ? "sp-toc-sub" : ""}`}
                    data-heading={heading.slug}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          )
        }

        <!-- CTA -->
        <div class="sp-cta">
          <div class="sp-cta-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              width="24"
              height="24"
            >
              <rect x="4" y="4" width="16" height="16" rx="2"></rect>
              <path d="M9 9h6v6H9z"></path>
              <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"
              ></path>
            </svg>
          </div>
          <h4>Try Our Calculators</h4>
          <p>
            Get precise basis point conversions and financial estimates
            instantly.
          </p>
          <a href="/calculators/" class="sp-cta-btn">
            Explore Calculators
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              width="14"
              height="14"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <AdSlot slot="blog_sidebar" />
      </aside>
    </div>

    <AdSlot slot="blog_after_post" />

    <!-- ═══ RELATED POSTS ═══ -->
    {
      relatedPosts.length > 0 && (
        <section class="sp-related sp-reveal">
          <div class="sp-related-top">
            <h2>Related Articles</h2>
            <a href="/guides/" class="sp-related-all">
              View all
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                width="14"
                height="14"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>
          <div class="sp-related-grid">
            {relatedPosts.map((post) => (
              <a href={`/guides/${post.id}/`} class="sp-related-card">
                <div class="sp-related-thumb">
                  {post.data.image ? (
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                    />
                  ) : null}
                  <div
                    class="sp-related-ph"
                    style={post.data.image ? "display:none" : ""}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      width="28"
                      height="28"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                      <circle cx="8.5" cy="8.5" r="1.5" />
                      <polyline points="21 15 16 10 5 21" />
                    </svg>
                  </div>
                </div>
                <div class="sp-related-info">
                  <span class="sp-related-cat">{post.data.category}</span>
                  <h3>{post.data.title}</h3>
                  {post.data.description && <p>{post.data.description}</p>}
                  <span class="sp-related-date">
                    {dateFormat.format(post.data.date)}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>

<style is:global>
  /* ═══════════════════════════════════════
     PREMIUM EDITORIAL SINGLE POST — v2
     ═══════════════════════════════════════ */

  /* ─── Keyframe Animations ─── */
  @keyframes sp-float-1 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -20px) scale(1.05);
    }
    66% {
      transform: translate(-15px, 15px) scale(0.97);
    }
  }
  @keyframes sp-float-2 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(-25px, 18px) scale(1.03);
    }
    66% {
      transform: translate(20px, -25px) scale(0.96);
    }
  }
  @keyframes sp-float-3 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(15px, 25px) scale(1.04);
    }
  }
  @keyframes sp-pulse-glow {
    0%,
    100% {
      box-shadow: 0 0 12px rgba(99, 102, 241, 0.5);
    }
    50% {
      box-shadow:
        0 0 20px rgba(139, 92, 246, 0.7),
        0 0 40px rgba(99, 102, 241, 0.2);
    }
  }
  @keyframes sp-fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Scroll Reveal ─── */
  .sp-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }
  .sp-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── Progress Bar ─── */
  .sp-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: linear-gradient(90deg, #6366f1, #8b5cf6, #a78bfa, #38bdf8);
    background-size: 300% 100%;
    animation: sp-pulse-glow 2s ease-in-out infinite;
    z-index: 9999;
    transition: width 0.08s linear;
  }

  /* ─── Main ─── */
  .sp-main {
    min-height: 100vh;
    padding-bottom: 80px;
  }

  /* ─── Hero ─── */
  .sp-hero {
    position: relative;
    padding: 72px 0 48px;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      #f8fafc 0%,
      #eef2ff 30%,
      #f0f4ff 50%,
      #f8fafc 100%
    );
  }
  .sp-hero-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #6366f1, #8b5cf6, #a78bfa, #38bdf8);
    background-size: 200% 100%;
    animation: sp-shimmer 3s linear infinite;
  }
  @keyframes sp-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  /* Floating Orbs */
  .sp-hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
    pointer-events: none;
  }
  .sp-hero-orb-1 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, #818cf8, transparent 70%);
    top: -60px;
    right: 10%;
    animation: sp-float-1 8s ease-in-out infinite;
  }
  .sp-hero-orb-2 {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, #c084fc, transparent 70%);
    bottom: -40px;
    left: 5%;
    animation: sp-float-2 10s ease-in-out infinite;
  }
  .sp-hero-orb-3 {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, #38bdf8, transparent 70%);
    top: 30%;
    left: 60%;
    animation: sp-float-3 12s ease-in-out infinite;
  }
  .sp-hero-inner {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  /* Featured Image Banner */
  .sp-featured-img {
    max-width: 860px;
    margin: -20px auto 32px;
    padding: 0 24px;
  }
  .sp-featured-img img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    border-radius: 16px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    transition: transform 0.4s ease;
  }
  .sp-featured-img img:hover {
    transform: scale(1.01);
  }

  /* Breadcrumb */
  .sp-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    font-size: 12.5px;
    font-weight: 500;
    color: #94a3b8;
  }
  .sp-breadcrumb a {
    color: #6366f1;
    text-decoration: none;
    transition: color 0.15s;
  }
  .sp-breadcrumb a:hover {
    color: #4338ca;
  }
  .sp-breadcrumb svg {
    color: #cbd5e1;
    flex-shrink: 0;
  }

  /* Category Badge */
  .sp-category-badge {
    display: inline-block;
    padding: 5px 16px;
    background: linear-gradient(
      135deg,
      rgba(238, 242, 255, 0.8),
      rgba(224, 231, 255, 0.8)
    );
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #4f46e5;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    border-radius: 20px;
    margin-bottom: 16px;
    border: 1px solid rgba(199, 210, 254, 0.6);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .sp-category-badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
  }

  /* Title */
  .sp-title {
    font-size: clamp(26px, 5vw, 44px);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.6px;
    line-height: 1.15;
    margin-bottom: 14px;
    background: linear-gradient(135deg, #0f172a 0%, #334155 50%, #1e293b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .sp-subtitle {
