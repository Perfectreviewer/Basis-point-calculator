---
import AdminLayout from "@admin/components/AdminLayout.astro";

export const prerender = false;
---

<AdminLayout title="Menu Management" activeNav="menus">
  <div class="page-header">
    <h1>Menu Management</h1>
    <p class="text-muted">
      Manage navigation menus with drag-and-drop — supports mega menus with deep
      nesting.
    </p>
  </div>

  <!-- Sticky save bar -->
  <div class="save-bar">
    <div class="save-bar-left">
      <div class="menu-tabs">
        <button class="menu-tab active" data-tab="header">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"></path></svg
          >
          Header Menu
        </button>
        <button class="menu-tab" data-tab="footer">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><rect x="3" y="14" width="18" height="7" rx="2"></rect><path
              d="M3 7V5a2 2 0 012-2h14a2 2 0 012 2v2"></path></svg
          >
          Footer Menu
        </button>
      </div>
    </div>
    <div class="save-bar-right">
      <span id="save-status" class="save-status">No unsaved changes</span>
      <button id="save-menu-btn" class="btn-primary success" disabled>
        <span class="btn-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path
              d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
            ></path><polyline points="17,21 17,13 7,13 7,21"
            ></polyline><polyline points="7,3 7,8 15,8"></polyline></svg
          >
        </span>
        <span class="btn-text">Save Menu</span>
      </button>
    </div>
  </div>

  <div class="menu-workspace">
    <!-- Left: Add Items Panel -->
    <div class="add-panel">
      <!-- Add Custom Link -->
      <div class="add-card card">
        <div class="add-card-header">
          <div class="add-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><line x1="12" y1="5" x2="12" y2="19"></line><line
                x1="5"
                y1="12"
                x2="19"
                y2="12"></line></svg
            >
          </div>
          <div>
            <h3>Add Menu Item</h3>
            <p class="text-muted text-sm">Create a new navigation link</p>
          </div>
        </div>
        <form id="add-link-form" class="add-form">
          <div class="form-group">
            <label for="link-label">Label</label>
            <input
              type="text"
              id="link-label"
              class="form-input"
              placeholder="e.g. Home"
              required
            />
          </div>
          <div class="form-group">
            <label for="link-url">URL</label>
            <input
              type="text"
              id="link-url"
              class="form-input"
              placeholder="e.g. / or /about-us/"
              required
            />
          </div>
          <button type="submit" class="btn-primary w-full">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              style="width:16px;height:16px"
              ><line x1="12" y1="5" x2="12" y2="19"></line><line
                x1="5"
                y1="12"
                x2="19"
                y2="12"></line></svg
            >
            Add to Menu
          </button>
        </form>
      </div>

      <!-- Quick guide -->
      <div class="guide-card card">
        <h4>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            style="width:16px;height:16px"
            ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"
            ></path><path d="M12 8h.01"></path></svg
          >
          How it works
        </h4>
        <div class="guide-items">
          <div class="guide-item">
            <span class="guide-kbd">☰</span>
            <span>Drag the handle to reorder items</span>
          </div>
          <div class="guide-item">
            <span class="guide-kbd">↳</span>
            <span>Drag into another item to create dropdowns</span>
          </div>
          <div class="guide-item">
            <span class="guide-kbd">▸</span>
            <span>Click the arrow to expand/collapse children</span>
          </div>
          <div class="guide-item">
            <span class="guide-kbd">✎</span>
            <span>Click the edit icon to modify label &amp; URL</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Menu Tree Editor -->
    <div class="tree-panel">
      <div class="tree-header">
        <div class="tree-title">
          <span id="tree-title-text">Header Menu</span>
          <span id="menu-item-count" class="item-count-badge">0 items</span>
        </div>
        <div class="tree-actions">
          <button
            id="expand-all-btn"
            class="tree-action-btn"
            title="Expand all"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><polyline points="15 3 21 3 21 9"></polyline><polyline
                points="9 21 3 21 3 15"></polyline><line
                x1="21"
                y1="3"
                x2="14"
                y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg
            >
          </button>
          <button
            id="collapse-all-btn"
            class="tree-action-btn"
            title="Collapse all"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><polyline points="4 14 10 14 10 20"></polyline><polyline
                points="20 10 14 10 14 4"></polyline><line
                x1="14"
                y1="10"
                x2="21"
                y2="3"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg
            >
          </button>
        </div>
      </div>
      <div class="tree-body card">
        <div id="header-editor" class="menu-editor active">
          <div class="loading-state">
            <div class="spinner"></div><p>Loading header menu…</p>
          </div>
        </div>
        <div id="footer-editor" class="menu-editor" style="display:none;">
          <div class="loading-state">
            <div class="spinner"></div><p>Loading footer menu…</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast"></div>
</AdminLayout>

<!-- ═══════════════════════ STYLES ═══════════════════════ -->
<style is:global>
  .page-header {
    margin-bottom: 24px;
    animation: fadeIn 0.4s ease-out;
  }
  .page-header h1 {
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 8px;
    background: linear-gradient(135deg, #fff 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ─── Loading ─── */
  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 0;
    color: var(--text-muted);
    gap: 16px;
  }
  .spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--border-subtle);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ─── Save Bar ─── */
  .save-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 24px;
    position: sticky;
    top: 65px;
    z-index: 30;
    backdrop-filter: blur(12px);
    flex-wrap: wrap;
    gap: 12px;
  }
  .save-bar-left {
    display: flex;
    align-items: center;
  }
  .save-bar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .menu-tabs {
    display: flex;
    gap: 4px;
  }
  .menu-tab {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .menu-tab svg {
    width: 15px;
    height: 15px;
  }
  .menu-tab:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }
  .menu-tab.active {
    background: rgba(56, 152, 236, 0.1);
    color: var(--accent-blue);
    border-color: rgba(56, 152, 236, 0.25);
  }

  .save-status {
    font-size: 13px;
    color: var(--text-muted);
  }
  .save-status.unsaved {
    color: var(--accent-amber, #f59e0b);
    font-weight: 600;
  }
  .save-status.saved {
    color: var(--accent-green);
    font-weight: 600;
  }

  .btn-icon {
    display: flex;
    align-items: center;
  }
  .btn-icon svg {
    width: 15px;
    height: 15px;
  }

  /* ─── Workspace Grid ─── */
  .menu-workspace {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* ─── Add Panel ─── */
  .add-panel {
    position: sticky;
    top: 130px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .add-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .add-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(56, 152, 236, 0.12);
    color: var(--accent-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .add-icon svg {
    width: 18px;
    height: 18px;
  }
  .add-card-header h3 {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .add-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .add-form .form-group label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 5px;
  }

  /* Guide card */
  .guide-card {
    background: var(--bg-surface) !important;
    border: 1px solid var(--border-subtle) !important;
    padding: 16px !important;
  }
  .guide-card h4 {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
  }
  .guide-items {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .guide-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .guide-kbd {
    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
  }

  /* ─── Tree Panel ─── */
  .tree-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .tree-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .item-count-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    background: rgba(56, 152, 236, 0.12);
    color: var(--accent-blue);
  }
  .tree-actions {
    display: flex;
    gap: 4px;
  }
  .tree-action-btn {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }
  .tree-action-btn svg {
    width: 14px;
    height: 14px;
  }
  .tree-action-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
    background: var(--bg-hover);
  }

  .tree-body {
    min-height: 200px;
    border: 1px solid var(--border-subtle) !important;
    padding: 16px !important;
  }

  /* ─── Sortable Lists ─── */
  .sortable-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 40px;
  }

  /* ─── Menu Item ─── */
  .menu-item {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    transition: all 0.2s;
  }
  .menu-item:hover {
    border-color: var(--border-medium);
  }
  .menu-item.editing {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 2px rgba(56, 152, 236, 0.15);
  }

  .item-row {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0;
    min-height: 44px;
  }

  /* Drag handle */
  .item-handle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 44px;
    flex-shrink: 0;
    color: var(--text-muted);
    cursor: grab;
    opacity: 0.5;
    transition: opacity 0.15s;
    border-right: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.08);
  }
  .item-handle:hover {
    opacity: 1;
  }
  .item-handle svg {
    width: 14px;
    height: 14px;
  }

  /* Info area */
  .item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 6px 12px;
    min-width: 0;
    gap: 1px;
  }
  .item-name {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .item-url {
    font-size: 11px;
    color: var(--text-muted);
    font-family: monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Badges */
  .item-badges {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-right: 4px;
  }
  .mega-badge {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 7px;
    border-radius: 4px;
    background: rgba(168, 85, 247, 0.15);
    color: #a855f7;
  }
  .child-count {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Item action buttons */
  .item-actions {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .item-action-btn {
    width: 36px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-left: 1px solid var(--border-subtle);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
    font-size: 14px;
  }
  .item-action-btn svg {
    width: 14px;
    height: 14px;
  }
  .item-action-btn:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }
  .item-action-btn.expand-btn.expanded {
    transform: rotate(90deg);
  }
  .item-action-btn.edit-btn.active {
    color: var(--accent-blue);
    background: rgba(56, 152, 236, 0.08);
  }
  .item-action-btn.delete-btn:hover {
    color: var(--accent-red, #ef4444);
    background: rgba(239, 68, 68, 0.08);
  }

  /* Edit panel */
  .item-edit-panel {
    display: none;
    padding: 14px 16px;
    background: rgba(56, 152, 236, 0.04);
    border-top: 1px solid var(--border-subtle);
    animation: slideDown 0.2s ease-out;
  }
  .item-edit-panel.open {
    display: block;
  }
  .edit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
  }
  .edit-grid label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 4px;
  }
  .edit-footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .edit-close-btn {
    padding: 5px 14px;
    border-radius: 6px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .edit-close-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  /* Delete confirmation bar */
  .delete-bar {
    display: none;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(239, 68, 68, 0.06);
    border-top: 1px solid rgba(239, 68, 68, 0.2);
    animation: slideDown 0.2s ease-out;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .delete-bar.open {
    display: flex;
  }
  .delete-bar span {
    flex: 1;
  }
  .delete-confirm {
    padding: 5px 14px;
    border-radius: 6px;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: var(--accent-red, #ef4444);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .delete-confirm:hover {
    background: rgba(239, 68, 68, 0.2);
  }
  .delete-cancel {
    padding: 5px 14px;
    border-radius: 6px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .delete-cancel:hover {
    color: var(--text-primary);
  }

  /* Children container */
  .children-list {
    list-style: none;
    margin: 0;
    padding: 8px 0 8px 24px;
    border-top: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.06);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 30px;
  }
  .children-list.collapsed {
    display: none;
  }

  /* Tree connector lines */
  .children-list::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--border-subtle);
  }
  .children-list > .menu-item {
    position: relative;
  }
  .children-list > .menu-item::before {
    content: "";
    position: absolute;
    left: -12px;
    top: 50%;
    width: 12px;
    height: 1px;
    background: var(--border-subtle);
  }

  /* Level 3 nesting (deeper children) */
  .children-list .children-list {
    padding-left: 20px;
    background: rgba(0, 0, 0, 0.04);
  }
  .children-list .children-list::before {
    left: 10px;
  }
  .children-list .children-list > .menu-item::before {
    left: -10px;
    width: 10px;
  }

  /* Empty state for drop zones */
  .sortable-list:empty::after,
  .children-list:empty::after {
    content: "Drag items here";
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    font-size: 12px;
    color: var(--text-muted);
    border: 1px dashed var(--border-subtle);
    border-radius: 6px;
    opacity: 0.6;
  }
  .children-list:empty::after {
    content: "Drag items here to create dropdown";
    padding: 10px;
  }

  /* SortableJS ghosts */
  .sortable-ghost {
    opacity: 0.4;
    background: rgba(56, 152, 236, 0.08) !important;
    border-color: var(--accent-blue) !important;
  }
  .sortable-drag {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    border-color: var(--accent-blue);
    transform: scale(1.02);
    z-index: 1000;
  }

  /* Animations */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Toast ─── */
  .toast {
    position: fixed;
    bottom: 30px;
    right: 30px;
    padding: 14px 24px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    z-index: 999;
    transform: translateY(100px);
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }
  .toast.show {
    transform: translateY(0);
    opacity: 1;
  }
  .toast.success {
    background: linear-gradient(135deg, #059669, #10b981);
  }
  .toast.error {
    background: linear-gradient(135deg, #dc2626, #ef4444);
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .menu-workspace {
      grid-template-columns: 1fr;
    }
    .add-panel {
      position: static;
    }
    .save-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .save-bar-right {
      justify-content: space-between;
    }
    .edit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- ═══════════════════════ SCRIPT ═══════════════════════ -->
<script>
  import Sortable from "sortablejs";

  let menuData: any = { header: [], footer: [] };
  let activeTab = "header";
  let hasChanges = false;

  // DOM
  const headerEditor = document.getElementById("header-editor")!;
  const footerEditor = document.getElementById("footer-editor")!;
  const addForm = document.getElementById("add-link-form")!;
  const labelInput = document.getElementById("link-label") as HTMLInputElement;
  const urlInput = document.getElementById("link-url") as HTMLInputElement;
  const saveBtn = document.getElementById("save-menu-btn") as HTMLButtonElement;
  const saveStatus = document.getElementById("save-status")!;
  const treeTitleText = document.getElementById("tree-title-text")!;
  const itemCountBadge = document.getElementById("menu-item-count")!;

  // ─── Init ───
  async function init() {
    await fetchMenuData();
    renderMenu("header", menuData.header, headerEditor);
    renderMenu("footer", menuData.footer, footerEditor);
    updateItemCount();
    setupTabs();
    setupForm();
    setupSave();
    setupExpandCollapse();
  }

  async function fetchMenuData() {
    try {
      const res = await fetch("/api/admin/menu/");
      if (res.ok) {
        menuData = await res.json();
      } else {
        showLoadError("Server returned " + res.status);
      }
    } catch (e) {
      showLoadError("Network error");
    }
  }

  function showLoadError(msg: string) {
    const err = `<div class="loading-state" style="color:var(--accent-red)"><p>Error: ${msg}</p></div>`;
    headerEditor.innerHTML = err;
    footerEditor.innerHTML = err;
  }

  // ─── Tabs ───
  function setupTabs() {
    document.querySelectorAll(".menu-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".menu-tab")
          .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeTab = btn.getAttribute("data-tab") || "header";

        headerEditor.style.display = activeTab === "header" ? "block" : "none";
        footerEditor.style.display = activeTab === "footer" ? "block" : "none";

        treeTitleText.textContent =
          activeTab === "header" ? "Header Menu" : "Footer Menu";
        updateItemCount();
      });
    });
  }

  // ─── Add Form ───
  function setupForm() {
    addForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const label = labelInput.value.trim();
      const url = urlInput.value.trim();
      if (!label || !url) return;

      const newItem = createMenuItem(label, url);
      const editor = activeTab === "header" ? headerEditor : footerEditor;
      let list = editor.querySelector(
        ".sortable-list.root-list",
      ) as HTMLElement;

      if (!list) {
        editor.innerHTML = "";
        list = document.createElement("ul");
        list.className = "sortable-list root-list";
        editor.appendChild(list);
        initSortable(list);
      }

      list.appendChild(newItem);
      labelInput.value = "";
      urlInput.value = "";
      markDirty();
      updateItemCount();
    });
  }

  // ─── Dirty state ───
  function markDirty() {
    hasChanges = true;
    saveBtn.disabled = false;
    saveStatus.textContent = "● Unsaved changes";
    saveStatus.className = "save-status unsaved";
  }

  // ─── Create Menu Item ───
  function esc(str: string) {
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }

  function createMenuItem(
    name: string,
    url: string,
    children: any[] = [],
  ): HTMLLIElement {
    const li = document.createElement("li");
    li.className = "menu-item";

    const hasKids = children && children.length > 0;
    const totalDescendants = countDescendants(children);
    const isMega = totalDescendants >= 6;

    // ── Item row ──
    const row = document.createElement("div");
    row.className = "item-row";

    // Handle
    const handle = document.createElement("div");
    handle.className = "item-handle";
    handle.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="18" x2="16" y2="18"/></svg>`;
    row.appendChild(handle);

    // Info
    const info = document.createElement("div");
    info.className = "item-info";
    info.innerHTML = `<span class="item-name">${esc(name)}</span><span class="item-url">${esc(url)}</span>`;
    row.appendChild(info);

    // Badges
    const badges = document.createElement("div");
    badges.className = "item-badges";
    if (isMega) badges.innerHTML += `<span class="mega-badge">Mega</span>`;
    if (hasKids)
      badges.innerHTML += `<span class="child-count">${totalDescendants}</span>`;
    row.appendChild(badges);

    // Actions
    const actions = document.createElement("div");
    actions.className = "item-actions";

    if (hasKids) {
      const expBtn = document.createElement("button");
      expBtn.type = "button";
      expBtn.className = "item-action-btn expand-btn";
      expBtn.title = "Toggle children";
      expBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>`;
      actions.appendChild(expBtn);
    }

    const editBtn = document.createElement("button");
    editBtn.type = "button";
    editBtn.className = "item-action-btn edit-btn";
    editBtn.title = "Edit";
    editBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`;
    actions.appendChild(editBtn);

    const delBtn = document.createElement("button");
    delBtn.type = "button";
    delBtn.className = "item-action-btn delete-btn";
    delBtn.title = "Delete";
    delBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>`;
    actions.appendChild(delBtn);

    row.appendChild(actions);
    li.appendChild(row);

    // ── Edit panel ──
    const editPanel = document.createElement("div");
    editPanel.className = "item-edit-panel";
    editPanel.innerHTML = `
      <div class="edit-grid">
        <div>
          <label>Navigation Label</label>
          <input type="text" class="form-input edit-label" value="${esc(name)}">
        </div>
        <div>
          <label>URL</label>
          <input type="text" class="form-input edit-url" value="${esc(url)}">
        </div>
      </div>
      <div class="edit-footer">
        <button type="button" class="edit-close-btn">Done</button>
      </div>
    `;
    li.appendChild(editPanel);

    // ── Delete bar ──
    const deleteBar = document.createElement("div");
    deleteBar.className = "delete-bar";
    deleteBar.innerHTML = `
      <span>Delete this item and its children?</span>
      <button type="button" class="delete-confirm">Delete</button>
      <button type="button" class="delete-cancel">Cancel</button>
    `;
    li.appendChild(deleteBar);

    // ── Children ──
    const childrenList = document.createElement("ul");
    childrenList.className = "sortable-list children-list";
    if (hasKids) {
      children.forEach((child) => {
        childrenList.appendChild(
          createMenuItem(child.name, child.url, child.children || []),
        );
      });
    }
    li.appendChild(childrenList);
    initSortable(childrenList);

    // ── Interactions ──
    const nameDisplay = info.querySelector(".item-name")!;
    const urlDisplay = info.querySelector(".item-url")!;
    const editLabelInput = editPanel.querySelector(
      ".edit-label",
    ) as HTMLInputElement;
    const editUrlInput = editPanel.querySelector(
      ".edit-url",
    ) as HTMLInputElement;

    // Edit toggle
    editBtn.addEventListener("click", () => {
      const isOpen = editPanel.classList.contains("open");
      editPanel.classList.toggle("open");
      editBtn.classList.toggle("active");
      li.classList.toggle("editing");
      if (!isOpen) editLabelInput.focus();
    });

    editPanel
      .querySelector(".edit-close-btn")!
      .addEventListener("click", () => {
        editPanel.classList.remove("open");
        editBtn.classList.remove("active");
        li.classList.remove("editing");
      });

    // Live update
    editLabelInput.addEventListener("input", () => {
      nameDisplay.textContent = editLabelInput.value;
      markDirty();
    });
    editUrlInput.addEventListener("input", () => {
      urlDisplay.textContent = editUrlInput.value;
      markDirty();
    });

    // Expand/collapse children
    const expandBtn = actions.querySelector(".expand-btn");
    if (expandBtn) {
      expandBtn.classList.add("expanded");
      expandBtn.addEventListener("click", () => {
        const isCollapsed = childrenList.classList.contains("collapsed");
        childrenList.classList.toggle("collapsed");
        expandBtn.classList.toggle("expanded");
      });
    }

    // Delete
    delBtn.addEventListener("click", () => {
      deleteBar.classList.add("open");
    });
    deleteBar
      .querySelector(".delete-confirm")!
      .addEventListener("click", () => {
        li.remove();
        markDirty();
        updateItemCount();
      });
    deleteBar.querySelector(".delete-cancel")!.addEventListener("click", () => {
      deleteBar.classList.remove("open");
    });

    return li;
  }

  function countDescendants(children: any[]): number {
    if (!children || !children.length) return 0;
    let count = children.length;
    children.forEach((c) => {
      count += countDescendants(c.children || []);
    });
    return count;
  }

  function updateItemCount() {
    const editor = activeTab === "header" ? headerEditor : footerEditor;
    const items = editor.querySelectorAll(".menu-item");
    itemCountBadge.textContent =
      items.length + " item" + (items.length !== 1 ? "s" : "");
  }

  // ─── Render ───
  function renderMenu(type: string, data: any[], container: HTMLElement) {
    container.innerHTML = "";
    const ul = document.createElement("ul");
    ul.className = "sortable-list root-list";

    if (data && data.length > 0) {
      data.forEach((item) => {
        ul.appendChild(
          createMenuItem(item.name, item.url, item.children || []),
        );
      });
    }

    container.appendChild(ul);
    initSortable(ul);
  }

  function initSortable(el: HTMLElement) {
    new Sortable(el, {
      group: "nested",
      animation: 200,
      fallbackOnBody: true,
      swapThreshold: 0.65,
      handle: ".item-handle",
      ghostClass: "sortable-ghost",
      dragClass: "sortable-drag",
      onEnd: () => {
        markDirty();
        updateItemCount();
        // Update badges after drag
        updateAllBadges();
      },
    });
  }

  function updateAllBadges() {
    document.querySelectorAll(".menu-item").forEach((item) => {
      const childrenList = item.querySelector(":scope > .children-list");
      const badges = item.querySelector(".item-badges");
      if (!badges || !childrenList) return;

      const directChildren = childrenList.querySelectorAll(
        ":scope > .menu-item",
      );
      const totalDesc = childrenList.querySelectorAll(".menu-item").length;

      badges.innerHTML = "";
      if (totalDesc >= 6)
        badges.innerHTML += `<span class="mega-badge">Mega</span>`;
      if (directChildren.length > 0)
        badges.innerHTML += `<span class="child-count">${totalDesc}</span>`;

      // Update expand button visibility
      const actions = item.querySelector(".item-actions");
      let expandBtn = actions?.querySelector(".expand-btn");

      if (directChildren.length > 0 && !expandBtn) {
        expandBtn = document.createElement("button");
        expandBtn.className = "item-action-btn expand-btn expanded";
        (expandBtn as HTMLElement).title = "Toggle children";
        expandBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>`;

        expandBtn.addEventListener("click", () => {
          childrenList.classList.toggle("collapsed");
          expandBtn!.classList.toggle("expanded");
        });

        actions?.insertBefore(expandBtn, actions.firstChild);
      } else if (directChildren.length === 0 && expandBtn) {
        expandBtn.remove();
      }
    });
  }

  // ─── Expand / Collapse All ───
  function setupExpandCollapse() {
    document.getElementById("expand-all-btn")!.addEventListener("click", () => {
      const editor = activeTab === "header" ? headerEditor : footerEditor;
      editor
        .querySelectorAll(".children-list")
        .forEach((el) => el.classList.remove("collapsed"));
      editor
        .querySelectorAll(".expand-btn")
        .forEach((btn) => btn.classList.add("expanded"));
    });
    document
      .getElementById("collapse-all-btn")!
      .addEventListener("click", () => {
        const editor = activeTab === "header" ? headerEditor : footerEditor;
        editor
          .querySelectorAll(".children-list")
          .forEach((el) => el.classList.add("collapsed"));
        editor
          .querySelectorAll(".expand-btn")
          .forEach((btn) => btn.classList.remove("expanded"));
      });
  }

  // ─── Save ───
  function setupSave() {
    saveBtn.addEventListener("click", async () => {
      saveBtn.disabled = true;
      const btnText = saveBtn.querySelector(".btn-text")!;
      btnText.textContent = "Saving...";

      const headerData = serializeMenu(headerEditor);
      const footerData = serializeMenu(footerEditor);

      try {
        const res = await fetch("/api/admin/menu/", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ header: headerData, footer: footerData }),
        });

        if (res.ok) {
          hasChanges = false;
          saveStatus.textContent = "✓ Menu saved";
          saveStatus.className = "save-status saved";
          showToast("Menu saved successfully!", "success");
          setTimeout(() => {
            saveStatus.textContent = "No unsaved changes";
            saveStatus.className = "save-status";
          }, 3000);
        } else {
          showToast("Failed to save menu", "error");
          saveBtn.disabled = false;
        }
      } catch (e) {
        showToast("Network error", "error");
        saveBtn.disabled = false;
      } finally {
        btnText.textContent = "Save Menu";
      }
    });
  }

  // ─── Serialize ───
  function serializeMenu(container: HTMLElement) {
    const rootUl = container.querySelector(".root-list");
    if (!rootUl) return [];
    return serializeList(rootUl as HTMLElement);
  }

  function serializeList(ul: HTMLElement): any[] {
    const items: any[] = [];
    const directChildren = Array.from(ul.children).filter(
      (c: any) => c.tagName === "LI",
    );

    directChildren.forEach((li: any) => {
      const nameInput = li.querySelector(
        ":scope > .item-edit-panel .edit-label",
      ) as HTMLInputElement;
      const urlInput = li.querySelector(
        ":scope > .item-edit-panel .edit-url",
      ) as HTMLInputElement;

      const item: any = {
        name: nameInput?.value || "",
        url: urlInput?.value || "",
      };

      const childList = li.querySelector(":scope > .children-list");
      if (childList) {
        const childItems = Array.from(childList.children).filter(
          (c: any) => c.tagName === "LI",
        );
        if (childItems.length > 0) {
          item.children = serializeList(childList as HTMLElement);
        }
      }

      items.push(item);
    });

    return items;
  }

  // ─── Toast ───
  function showToast(msg: string, type: "success" | "error") {
    const toast = document.getElementById("toast")!;
    toast.textContent = msg;
    toast.className = `toast ${type} show`;
    setTimeout(() => {
      toast.classList.remove("show");
    }, 3000);
  }

  // Run
  init();
</script>
