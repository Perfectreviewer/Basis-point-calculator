  }

  /* Tabs */
  .editor-tabs {
    display: flex;
    gap: 4px;
    padding: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
  }
  .editor-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .editor-tab:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
