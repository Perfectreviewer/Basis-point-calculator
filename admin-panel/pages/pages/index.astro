---
import AdminLayout from "@admin/components/AdminLayout.astro";
import {
  readJSON,
  ensureDataDir,
  getSeoConfigPath,
} from "@admin/utils/storage";
import { getSessionFromCookies, validateSessionToken } from "@admin/utils/auth";
import { hasPermission } from "@admin/utils/roles";
import type { Role } from "@admin/utils/roles";
import { join } from "node:path";
import { readdirSync, statSync } from "node:fs";

export const prerender = false;

const session = getSessionFromCookies(Astro.request.headers.get("cookie"));
let user = null;
if (session) user = await validateSessionToken(session);
if (!user) return Astro.redirect("/admin/login/");
const canWrite = hasPermission(user.role as Role, "pages:write");

ensureDataDir();
const seoFile = getSeoConfigPath();
const seoData = readJSON<Record<string, any>>(seoFile);

// â”€â”€â”€ Dynamic page discovery â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
interface PageInfo {
  route: string;
  filepath: string;
}

function scanPages(dir: string, prefix = ""): PageInfo[] {
  const results: PageInfo[] = [];
  try {
    const entries = readdirSync(dir);
    for (const entry of entries) {
      const full = join(dir, entry);
      const st = statSync(full);
      if (st.isDirectory()) {
        results.push(...scanPages(full, `${prefix}${entry}/`));
      } else if (entry.endsWith(".astro")) {
        const name = entry.replace(/\.astro$/, "");
        // Skip dynamic routes like [...id], [...page], [...lang]
        if (name.startsWith("[")) continue;
        const route = name === "index" ? `/${prefix}` : `/${prefix}${name}/`;
        results.push({ route, filepath: full });
      }
    }
  } catch {
    /* directory may not exist */
  }
  return results;
}

// Scan pages inside [...lang]/ (the main site pages) and top-level pages
const projectRoot = import.meta.url
  ? new URL(".", import.meta.url).pathname.replace(/^\/([A-Z]:)/, "$1")
  : "";
const pagesRoot = join(projectRoot, "../../../pages/[...lang]");
const topLevelRoot = join(projectRoot, "../../../pages");

const langPages = scanPages(pagesRoot);
const topLevelExclude = new Set(["404", "sitemap", "design_preview"]);
const topLevelPages: PageInfo[] = [];

try {
  for (const entry of readdirSync(topLevelRoot)) {
    if (!entry.endsWith(".astro")) continue;
    const name = entry.replace(/\.astro$/, "");
    if (name === "index" || name.startsWith("[") || topLevelExclude.has(name))
      continue;
    topLevelPages.push({
      route: `/${name}/`,
      filepath: join(topLevelRoot, entry),
    });
  }
} catch {}

const discoveredPages = [...langPages, ...topLevelPages];

// Combine configured data with inferred data
const combinedSeoData: Record<string, any> = { ...seoData };
const pageMap: Record<string, { label: string; icon: string }> = {};

for (const p of discoveredPages) {
  const info = getPageInfo(p.route);
  pageMap[p.route] = info;
}

// Auto-categorize pages (Helper)
function getPageInfo(path: string): { label: string; icon: string } {
  const iconMap: Record<string, string> = {
    "bps-calculators": "calc",
    "bond-calculators": "calc",
    "interest-rate-calculators": "calc",
    "loan-calculators": "calc",
    "investment-calculators": "calc",
    calculators: "calc",
    guides: "book",
    faq: "help",
    legal: "shield",
  };

  for (const [dir, icon] of Object.entries(iconMap)) {
    if (path.startsWith(`/${dir}/`) || path === `/${dir}/`) {
      const segments = path.replace(/^\/|\/$/g, "").split("/");
      const last = segments[segments.length - 1] || segments[0];
      const label =
        last === "index" || segments.length === 1
          ? dir
              .split("-")
              .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
              .join(" ")
          : last
              .split("-")
              .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
              .join(" ");
      return { label, icon };
    }
  }

  if (path === "/") return { label: "Homepage", icon: "home" };
  if (path === "/blog/") return { label: "Blog", icon: "edit" };
  if (path.includes("about")) return { label: "About", icon: "info" };
  if (path.includes("contact")) return { label: "Contact", icon: "info" };
  if (path.includes("privacy"))
    return { label: "Privacy Policy", icon: "shield" };
  if (path.includes("terms"))
    return { label: "Terms of Service", icon: "shield" };

  const name =
    path
      .replace(/^\/|\/$/g, "")
      .split("/")
      .pop() || path;
  const label = name
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
  return { label, icon: "file" };
}

const defaultPages = Object.keys(pageMap);
const allPages = [
  ...new Set([...defaultPages, ...Object.keys(seoData)]),
].sort();
const configuredCount = allPages.filter((p) => seoData[p]).length;
