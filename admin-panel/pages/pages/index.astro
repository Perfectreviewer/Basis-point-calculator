    <!-- Page List Sidebar -->
    <div class="page-sidebar">
      <div class="sidebar-search">
        <svg
          class="search-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
          ></path></svg
        >
        <input
          type="text"
          class="search-input"
          id="pageSearch"
          placeholder="Search pages..."
        />
      </div>
      <div class="sidebar-stats">
        <div class="stat-chip">
          <span class="stat-chip-num">{allPages.length}</span><span>Total</span>
        </div>
        <div class="stat-chip configured">
          <span class="stat-chip-num">{configuredCount}</span><span
            >Configured</span
          >
        </div>
        <div class="stat-chip pending">
          <span class="stat-chip-num">{allPages.length - configuredCount}</span
          ><span>Pending</span>
        </div>
      </div>
      <div class="page-items" id="pageList">
        {
          allPages.map((path) => {
            const info = pageMap[path];
            const configured = !!seoData[path];
            return (
              <button
                class="page-item"
                data-path={path}
                data-label={info?.label || path}
