    </div>
  </div>
  <div id="toast" class="toast"></div>

  <script is:inline define:vars={{ seoData: JSON.stringify(combinedSeoData) }}>
    const data = JSON.parse(seoData);
    let currentPath = "";

    // DOM refs
    const titleInput = document.getElementById("seoTitle");
    const descInput = document.getElementById("seoDescription");
    const kwInput = document.getElementById("seoKeywords");
    const schemaInput = document.getElementById("seoSchema");
    const canonicalInput = document.getElementById("seoCanonical");
    const robotsIndex = document.getElementById("robotsIndex");
    const robotsFollow = document.getElementById("robotsFollow");
    const ogTitleInput = document.getElementById("ogTitle");
    const ogDescInput = document.getElementById("ogDescription");
    const ogImageInput = document.getElementById("ogImage");
    const customHeadInput = document.getElementById("customHeadTags");

    // Search
    document.getElementById("pageSearch")?.addEventListener("input", (e) => {
      const q = e.target.value.toLowerCase();
      document.querySelectorAll(".page-item").forEach((item) => {
        const match =
          item.dataset.path.toLowerCase().includes(q) ||
          (item.dataset.label || "").toLowerCase().includes(q);
        item.style.display = match ? "" : "none";
      });
    });

    // Page selection
    document.querySelectorAll(".page-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".page-item")
          .forEach((b) => b.classList.remove("selected"));
        btn.classList.add("selected");
        currentPath = btn.dataset.path;
        loadPageSeo(currentPath);
      });
    });

    // Editor tabs
    document.querySelectorAll(".editor-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        document
          .querySelectorAll(".editor-tab")
          .forEach((t) => t.classList.remove("active"));
        document.querySelectorAll(".tab-panel").forEach((p) => {
          p.style.display = "none";
          p.classList.remove("active");
        });
        tab.classList.add("active");
        const panel = document.getElementById("panel-" + tab.dataset.tab);
        if (panel) {
          panel.style.display = "flex";
          panel.classList.add("active");
        }
      });
    });

    function str(v) {
      if (v == null) return "";
      if (typeof v === "string") return v;
      if (typeof v === "object")
        return v.en || v["en"] || Object.values(v)[0] || "";
      return String(v);
    }

    function loadPageSeo(path) {
      document.getElementById("editorEmpty").style.display = "none";
      document.getElementById("editorForm").style.display = "flex";
      document.getElementById("editorPath").textContent = path;

      const seo = data[path] || {};
      titleInput.value = str(seo.title);
      descInput.value = str(seo.description);
      kwInput.value = str(seo.keywords);
      schemaInput.value = seo.schema ? JSON.stringify(seo.schema, null, 2) : "";
      canonicalInput.value = str(seo.canonicalUrl);
      robotsIndex.checked = seo.robots?.index !== false;
      robotsFollow.checked = seo.robots?.follow !== false;
      ogTitleInput.value = str(seo.ogTitle);
      ogDescInput.value = str(seo.ogDescription);
      ogImageInput.value = str(seo.ogImage);
      customHeadInput.value = str(seo.customHeadTags);

      updatePreview();
      updateCounts();
      updateScore();
      updateSocialPreview();
    }

    // Live updates
    [
      titleInput,
      descInput,
      kwInput,
      schemaInput,
      canonicalInput,
      ogTitleInput,
      ogDescInput,
      ogImageInput,
      customHeadInput,
    ].forEach((el) => {
      el?.addEventListener("input", () => {
        updatePreview();
        updateCounts();
        updateScore();
        updateSocialPreview();
      });
    });
    [robotsIndex, robotsFollow].forEach((el) => {
      el?.addEventListener("change", () => updateScore());
    });

    function updatePreview() {
      document.getElementById("serpTitle").textContent =
        titleInput.value ||
        "Basis Point Calculator â€“ Accurate Basis Points...";
      document.getElementById("serpUrl").textContent =
        "basispointcalculator.com" + currentPath;
      document.getElementById("serpDesc").textContent =
        descInput.value || "Page description will appear hereâ€¦";
    }

    function updateSocialPreview() {
      document.getElementById("spTitle").textContent =
        ogTitleInput.value || titleInput.value || "Page Title";
      document.getElementById("spDesc").textContent =
        ogDescInput.value || descInput.value || "Page descriptionâ€¦";
      document.getElementById("spDomain").textContent =
        "basispointcalculator.com";
      const imgEl = document.getElementById("spImage");
      if (ogImageInput.value) {
        imgEl.style.backgroundImage = `url(${ogImageInput.value})`;
        imgEl.style.backgroundSize = "cover";
        imgEl.style.backgroundPosition = "center";
        imgEl.innerHTML = "";
      } else {
        imgEl.style.backgroundImage = "";
        imgEl.innerHTML =
          '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>';
      }
    }

    function updateCounts() {
      const tLen = titleInput.value.length,
        dLen = descInput.value.length;
      document.getElementById("titleCount").textContent = tLen;
      document.getElementById("descCount").textContent = dLen;
      const tPct = Math.min((tLen / 60) * 100, 100),
        dPct = Math.min((dLen / 160) * 100, 100);
      const tFill = document.getElementById("titleProgress"),
        dFill = document.getElementById("descProgress");
      tFill.style.width = tPct + "%";
      dFill.style.width = dPct + "%";
      tFill.className = "char-fill " + (tLen > 60 ? "over" : "");
      dFill.className = "char-fill " + (dLen > 160 ? "over" : "");
    }

    function updateScore() {
      let score = 0;
      const total = 6;
      const checks = {
        "chk-title":
          titleInput.value.length > 0 && titleInput.value.length <= 60,
        "chk-desc": descInput.value.length > 0 && descInput.value.length <= 160,
        "chk-kw": kwInput.value.trim().length > 0,
        "chk-og":
          ogTitleInput.value.trim().length > 0 ||
          ogDescInput.value.trim().length > 0,
        "chk-canonical": canonicalInput.value.trim().length > 0,
        "chk-schema": schemaInput.value.trim().length > 0,
      };
      Object.entries(checks).forEach(([id, ok]) => {
        const el = document.getElementById(id);
        if (el) el.className = "score-check " + (ok ? "pass" : "fail");
        if (ok) score++;
      });
      // 0 to 100
      const pct = Math.round((score / total) * 100);

      const scoreNum = document.getElementById("scoreNum");
      if (scoreNum) {
        scoreNum.textContent = score; // Just the raw score per the screenshot it shows a raw number, but we can display the value 17 like screenshot or percentage. Let's show raw out of up to max, or pct? 17 looks like an arbitrary score, we'll keep the percentage or a formula based score up to 100. Let's use `score * (100/6)` mapping.
        scoreNum.textContent = Math.round(score * (100 / 6));
      }

      const ring = document.getElementById("scoreRingFill");
      if (ring) {
        ring.style.strokeDashoffset = 163.36 - (pct / 100) * 163.36;
        // color mapping
        const color =
          pct >= 80
            ? "var(--accent-green)"
            : pct >= 50
              ? "#fbbf24"
              : "var(--accent-red)";
        ring.style.stroke = color;
      }
    }

    // Save
    document
      .getElementById("saveSeoBtn")
      ?.addEventListener("click", async () => {
        const btn = document.getElementById("saveSeoBtn");
        btn.disabled = true;
        btn.innerHTML = '<span class="save-spinner"></span> Saving...';

        let schema = null;
        const schemaStr = schemaInput.value.trim();
        if (schemaStr) {
          try {
            schema = JSON.parse(schemaStr);
          } catch {
            showToast("Invalid JSON in schema field", "error");
            btn.disabled = false;
            btn.innerHTML =
              '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Save Changes';
            return;
          }
        }

        try {
          const res = await fetch("/api/pages/save/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              path: currentPath,
              title: titleInput.value,
              description: descInput.value,
              keywords: kwInput.value,
              schema,
              canonicalUrl: canonicalInput.value,
              robots: {
                index: robotsIndex.checked,
                follow: robotsFollow.checked,
              },
              ogTitle: ogTitleInput.value,
              ogDescription: ogDescInput.value,
              ogImage: ogImageInput.value,
              customHeadTags: customHeadInput.value,
            }),
          });
          if (res.ok) {
            data[currentPath] = {
              title: titleInput.value,
              description: descInput.value,
              keywords: kwInput.value,
              schema,
              canonicalUrl: canonicalInput.value,
              robots: {
                index: robotsIndex.checked,
                follow: robotsFollow.checked,
              },
              ogTitle: ogTitleInput.value,
              ogDescription: ogDescInput.value,
              ogImage: ogImageInput.value,
              customHeadTags: customHeadInput.value,
            };
            showToast("âœ“ Settings saved successfully", "success");
            const item = document.querySelector(
              `.page-item[data-path="${currentPath}"]`,
            );
            if (item) {
              const badge = item.querySelector(".seo-badge");
              if (badge) {
                badge.className = "seo-badge ok";
                badge.innerHTML =
                  '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>';
              }
            }
          } else {
            const d = await res.json();
            showToast(d.error || "Failed to save", "error");
          }
        } catch {
          showToast("Network error", "error");
        }
        btn.disabled = false;
        btn.innerHTML =
          '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Save Changes';
      });

    // Add page
    document.getElementById("addPageBtn")?.addEventListener("click", () => {
      const input = document.getElementById("newPagePath");
      let path = input.value.trim();
      if (!path) return;
      if (!path.startsWith("/")) path = "/" + path;
      if (!path.endsWith("/")) path += "/";
      const btn = document.createElement("button");
      btn.className = "page-item";
      btn.dataset.path = path;
      btn.dataset.label = path;
      btn.innerHTML = `<div class="page-item-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/></svg></div><div class="page-item-text"><span class="page-item-label">${path}</span><span class="page-item-path">${path}</span></div><div class="page-item-status"><span class="seo-badge missing"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="1"/></svg></span></div>`;
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".page-item")
          .forEach((b) => b.classList.remove("selected"));
        btn.classList.add("selected");
        currentPath = path;
        loadPageSeo(path);
      });
      document.getElementById("pageList").appendChild(btn);
      input.value = "";
    });

    function showToast(msg, type) {
      const t = document.getElementById("toast");
      t.textContent = msg;
      t.className = `toast ${type} show`;
      setTimeout(() => t.classList.remove("show"), 3500);
    }
  </script>
</AdminLayout>

<style is:global>
