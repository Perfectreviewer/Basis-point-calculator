                    <span class="seo-badge missing" title="Not configured">
                      <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                      >
                        <circle cx="12" cy="12" r="1" />
                      </svg>
                    </span>
                  )}
                </div>
              </button>
            );
          })
        }
