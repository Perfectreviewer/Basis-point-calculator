---
// Admin Login Page — standalone, premium design
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Login — BasisPoint</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: #060a12;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
        position: relative;
      }

      /* Animated background orbs */
      .bg-orb {
        position: fixed;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.15;
        animation: float 20s infinite ease-in-out;
        pointer-events: none;
      }
      .bg-orb-1 {
        width: 500px;
        height: 500px;
        background: #3898ec;
        top: -100px;
        left: -100px;
        animation-delay: 0s;
      }
      .bg-orb-2 {
        width: 400px;
        height: 400px;
        background: #7c5bf0;
        bottom: -80px;
        right: -80px;
        animation-delay: -7s;
        animation-duration: 25s;
      }
      .bg-orb-3 {
        width: 300px;
        height: 300px;
        background: #34d399;
        top: 50%;
        left: 60%;
        animation-delay: -14s;
        animation-duration: 22s;
        opacity: 0.08;
      }
      @keyframes float {
        0%,
        100% {
          transform: translate(0, 0) scale(1);
        }
        25% {
          transform: translate(30px, -40px) scale(1.05);
        }
        50% {
          transform: translate(-20px, 20px) scale(0.95);
        }
        75% {
          transform: translate(40px, 30px) scale(1.02);
        }
      }

      /* Grid dot pattern */
      .bg-grid {
        position: fixed;
        inset: 0;
        background-image: radial-gradient(
          rgba(56, 152, 236, 0.06) 1px,
          transparent 1px
        );
        background-size: 32px 32px;
        pointer-events: none;
      }

      /* Login Card */
      .login-card {
        position: relative;
        z-index: 10;
        background: rgba(19, 28, 46, 0.75);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(99, 130, 190, 0.15);
        border-radius: 20px;
        padding: 44px 40px 36px;
        width: 100%;
        max-width: 420px;
        margin: 20px;
        box-shadow:
          0 25px 60px -12px rgba(0, 0, 0, 0.5),
          0 0 40px rgba(56, 152, 236, 0.05),
          inset 0 1px 0 rgba(255, 255, 255, 0.03);
        animation: cardIn 0.5s ease-out;
      }
      @keyframes cardIn {
        from {
          opacity: 0;
          transform: translateY(20px) scale(0.97);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .accent-bar {
        height: 3px;
        background: linear-gradient(90deg, #3898ec, #7c5bf0, #34d399);
        border-radius: 20px 20px 0 0;
        margin: -44px -40px 36px -40px;
      }

      /* Logo */
      .logo {
        text-align: center;
        margin-bottom: 32px;
      }
      .logo-icon-wrap {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg, #3898ec, #7c5bf0);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        box-shadow: 0 8px 24px rgba(56, 152, 236, 0.25);
      }
      .logo-icon-wrap svg {
        width: 28px;
        height: 28px;
        color: white;
      }
      .logo h1 {
        color: #f0f4fc;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }
      .logo p {
        color: #5a6e8f;
        font-size: 14px;
        margin-top: 6px;
      }

      /* Form */
      .form-group {
        margin-bottom: 20px;
      }
      label {
        display: block;
        color: #8b9dc3;
        font-size: 12.5px;
        font-weight: 600;
        margin-bottom: 8px;
        letter-spacing: 0.3px;
      }
      .input-wrap {
        position: relative;
      }
      .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #5a6e8f;
        pointer-events: none;
        transition: color 0.2s;
      }
      .input-icon svg {
        width: 18px;
        height: 18px;
      }
      input {
        width: 100%;
        padding: 12px 14px 12px 44px;
        background: rgba(8, 12, 20, 0.6);
        border: 1px solid rgba(99, 130, 190, 0.12);
        border-radius: 10px;
        color: #f0f4fc;
        font-size: 14px;
        font-family: inherit;
        outline: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }
      input:focus {
        border-color: #3898ec;
        box-shadow: 0 0 0 3px rgba(56, 152, 236, 0.12);
      }
      input:focus + .input-icon,
      input:focus ~ .input-icon {
        color: #3898ec;
      }
      input::placeholder {
        color: #3d4f6e;
      }

      /* Submit Button */
      .btn {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #3898ec, #7c5bf0);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 16px rgba(56, 152, 236, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        letter-spacing: -0.2px;
      }
      .btn:hover {
        box-shadow: 0 6px 24px rgba(56, 152, 236, 0.35);
        transform: translateY(-1px);
      }
      .btn:active {
        transform: translateY(0);
      }
      .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
      }
      .btn svg {
        width: 18px;
        height: 18px;
      }

      /* Error */
      .error {
        background: rgba(248, 113, 113, 0.08);
        border: 1px solid rgba(248, 113, 113, 0.2);
        color: #f87171;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13px;
        margin-bottom: 16px;
        display: none;
        font-weight: 500;
      }
      .error.show {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .error svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }

      /* Forgot password */
      .forgot-wrap {
        text-align: center;
        margin-top: 14px;
      }
      .forgot-link {
        background: none;
        border: none;
        color: #5a6e8f;
        font-size: 13px;
        font-family: inherit;
        cursor: pointer;
        transition: color 0.2s;
        padding: 0;
      }
      .forgot-link:hover {
        color: #3898ec;
      }
      .reset-info {
        display: none;
        background: rgba(56, 152, 236, 0.07);
        border: 1px solid rgba(56, 152, 236, 0.18);
        border-radius: 10px;
        padding: 12px 16px;
        margin-top: 12px;
        color: #8bb8e8;
        font-size: 13px;
        line-height: 1.5;
      }
      .reset-info.show {
        display: block;
      }
      .reset-info a {
        color: #3898ec;
        text-decoration: none;
      }
      .reset-info a:hover {
        text-decoration: underline;
      }

      /* Footer */
      .login-footer {
        text-align: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(99, 130, 190, 0.08);
      }
      .login-footer a {
        color: #5a6e8f;
        font-size: 13px;
        text-decoration: none;
        transition: color 0.2s;
      }
      .login-footer a:hover {
        color: #3898ec;
      }
    </style>
  </head>
  <body>
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>
    <div class="bg-orb bg-orb-3"></div>
    <div class="bg-grid"></div>

    <div class="login-card">
      <div class="accent-bar"></div>
      <div class="logo">
        <div class="logo-icon-wrap">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5"></path>
            <path d="M2 12l10 5 10-5"></path>
          </svg>
        </div>
        <h1>BasisPoint</h1>
        <p>Sign in to the admin panel</p>
      </div>

      <div class="error" id="errorMsg">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><circle cx="12" cy="12" r="10"></circle><line
            x1="15"
            y1="9"
            x2="9"
            y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg
        >
        <span id="errorText"></span>
      </div>

      <form id="loginForm">
        <div class="form-group">
          <label for="username">Username</label>
          <div class="input-wrap">
            <input
              type="text"
              id="username"
              name="username"
              placeholder="Enter your username"
              required
              autocomplete="username"
            />
            <span class="input-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"
                ></path><circle cx="12" cy="7" r="4"></circle></svg
              >
            </span>
          </div>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter your password"
              required
              autocomplete="current-password"
            />
            <span class="input-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                ></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg
              >
            </span>
          </div>
        </div>
        <button type="submit" class="btn" id="loginBtn">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"></path><polyline
              points="10 17 15 12 10 7"></polyline><line
              x1="15"
              y1="12"
              x2="3"
              y2="12"></line></svg
          >
          Sign In
        </button>
      </form>

      <div class="forgot-wrap">
        <button class="forgot-link" id="forgotBtn">Forgot password?</button>
        <div class="reset-info" id="resetInfo">
          To reset your password, contact the site admin at
          <a href="mailto:perfecttechreviewer@gmail.com">perfecttechreviewer@gmail.com</a>
        </div>
      </div>

      <div class="login-footer">
        <a href="/">← Back to site</a>
      </div>
    </div>

    <script is:inline>
      document.getElementById("forgotBtn").addEventListener("click", () => {
        const info = document.getElementById("resetInfo");
        info.classList.toggle("show");
      });

      document
        .getElementById("loginForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const btn = document.getElementById("loginBtn");
          const errorEl = document.getElementById("errorMsg");
          const errorText = document.getElementById("errorText");
          const username = document.getElementById("username").value;
          const password = document.getElementById("password").value;

          btn.disabled = true;
          btn.innerHTML = '<span style="opacity:0.7">Signing in...</span>';
          errorEl.classList.remove("show");

          try {
            const res = await fetch("/api/auth/login/", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ username, password }),
            });
            const data = await res.json();

            if (res.ok) {
              window.location.href = "/admin/";
            } else {
              errorText.textContent = data.error || "Login failed";
              errorEl.classList.add("show");
            }
          } catch (err) {
            errorText.textContent = "Network error. Please try again.";
            errorEl.classList.add("show");
          } finally {
            btn.disabled = false;
            btn.innerHTML =
              '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Sign In';
          }
        });
    </script>
  </body>
</html>
