---
// Blog Management — WordPress-like Editor with Image Upload
import AdminLayout from '@admin/components/AdminLayout.astro';
import { listBlogFiles, readBlogFile, ensureDataDir } from '@admin/utils/storage';
import { getSessionFromCookies, validateSessionToken } from '@admin/utils/auth';
import { hasPermission } from '@admin/utils/roles';
import type { Role } from '@admin/utils/roles';
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

const session = getSessionFromCookies(Astro.request.headers.get('cookie'));
let user: any = null;
if (session) user = await validateSessionToken(session);
if (!user) return Astro.redirect('/admin/login/');

const canWrite = hasPermission(user.role as Role, 'blog:write');
const canDelete = hasPermission(user.role as Role, 'blog:delete');

ensureDataDir();
const files = listBlogFiles();

// Read managed categories
let blogCategories: { id: string; name: string; slug: string }[] = [];
try {
  const catPath = path.join(process.cwd(), 'src', 'config', 'blog-categories.json');
  blogCategories = JSON.parse(fs.readFileSync(catPath, 'utf-8'));
} catch { /* empty */ }

function parseFrontmatter(content: string) {
  const normalized = content.replace(/\r\n/g, '\n');
  const match = normalized.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (!match) return {};
  const fm: Record<string, string> = {};
  for (const line of match[1].split('\n')) {
    const i = line.indexOf(':');
    if (i > 0) {
      const key = line.substring(0, i).trim();
      let val = line.substring(i + 1).trim();
      if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) val = val.slice(1, -1);
      fm[key] = val;
    }
  }
  return fm;
}

const posts: any[] = files.map(f => {
  const content = readBlogFile(f);
  const fm = parseFrontmatter(content);
  return { filename: f, ...fm };
});

// Check if we should open editor
const url = new URL(Astro.request.url);
const editFile = url.searchParams.get('edit');
const isNew = url.searchParams.get('new') === '1';
const showEditor = editFile || isNew;

let editContent = '';
let editFrontmatter: Record<string, string> = {};
if (editFile) {
  const raw = readBlogFile(editFile);
  const match = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (match) {
    editFrontmatter = parseFrontmatter(raw);
    editContent = match[2];
  }
}
---

<AdminLayout title={showEditor ? (editFile ? 'Edit Post' : 'New Post') : 'Blog Posts'} activeNav="blog">
  {showEditor ? (
    <!-- WordPress-Like Blog Editor -->
    <div class="editor-wrap">
      <div class="editor-topbar mb-24">
        <a href="/admin/blog/" class="btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          Back to posts
        </a>
        <div class="flex items-center gap-12">
          <div id="saveMsg" style="display: none;"></div>
          <button type="submit" form="postForm" class="btn-primary" id="saveBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17,21 17,13 7,13 7,21"/><polyline points="7,3 7,8 15,8"/></svg>
            {editFrontmatter.status === 'draft' ? 'Save Draft' : 'Publish'}
          </button>
        </div>
      </div>

      <form id="postForm" class="editor-grid">
        <!-- Content Editor (main area) -->
        <div class="editor-main">
          <!-- Title -->
          <input type="text" class="title-input" id="postTitle" value={editFrontmatter.title || ''} placeholder="Post title..." required />

          <!-- Content -->
          <div class="content-card">
            <div class="content-toolbar">
              <div class="toolbar-group">
                <button type="button" class="toolbar-btn" title="Bold" data-insert="**" data-wrap="true"><strong>B</strong></button>
                <button type="button" class="toolbar-btn" title="Italic" data-insert="*" data-wrap="true"><em>I</em></button>
                <button type="button" class="toolbar-btn" title="Link" data-insert="[text](url)" data-wrap="false">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                </button>
                <button type="button" class="toolbar-btn" title="Heading" data-insert="## " data-wrap="false">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h8M4 18V6M12 18V6M17 10l3 3v1M20 10l-3 3"/></svg>
                </button>
                <div class="toolbar-sep"></div>
                <button type="button" class="toolbar-btn" title="Bullet List" data-insert="- " data-wrap="false">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                </button>
                <button type="button" class="toolbar-btn" title="Quote" data-insert="> " data-wrap="false">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3z"/></svg>
                </button>
                <div class="toolbar-sep"></div>
                <button type="button" class="toolbar-btn" id="insertImageBtn" title="Insert Image">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                </button>
              </div>
              <span class="toolbar-badge">Markdown</span>
            </div>
            <textarea class="form-input content-editor" id="postContent" placeholder="Write your blog post in Markdown...">{editContent}</textarea>
          </div>
        </div>

        <!-- Settings Sidebar (WordPress-like panels) -->
        <div class="editor-sidebar">
          <!-- Publish Panel -->
          <div class="settings-panel">
            <div class="panel-toggle active" data-panel="publish">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17,21 17,13 7,13 7,21"/><polyline points="7,3 7,8 15,8"/></svg>
              Publish
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="panel-body" id="panel-publish">
              <div class="setting-row">
                <label class="setting-label">Status</label>
                <select class="form-input setting-input" id="postStatus">
                  <option value="published" selected={editFrontmatter.status !== 'draft'}>Published</option>
                  <option value="draft" selected={editFrontmatter.status === 'draft'}>Draft</option>
                </select>
              </div>
              <div class="setting-row">
                <label class="setting-label">Visibility</label>
                <select class="form-input setting-input" id="postVisibility">
                  <option value="public" selected={editFrontmatter.visibility !== 'private'}>Public</option>
                  <option value="private" selected={editFrontmatter.visibility === 'private'}>Private</option>
                </select>
              </div>
              <div class="setting-row">
                <label class="setting-label">Date</label>
                <input type="date" class="form-input setting-input" id="postDate" value={editFrontmatter.date?.split('T')[0] || new Date().toISOString().split('T')[0]} />
              </div>
              <div class="setting-row">
                <label class="setting-label">Slug</label>
                <input type="text" class="form-input setting-input" id="postSlug" value={editFile?.replace(/\.(md|mdx)$/, '') || ''} placeholder="post-slug" required />
              </div>
            </div>
          </div>

          <!-- Category & Tags Panel -->
          <div class="settings-panel">
            <div class="panel-toggle active" data-panel="taxonomy">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              Categories & Tags
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="panel-body" id="panel-taxonomy">
              <div class="setting-row">
                <label class="setting-label">Category</label>
                <select class="form-input setting-input" id="postCategory">
                  <option value="">— Select Category —</option>
                  {blogCategories.map((cat) => (
                    <option value={cat.name} selected={editFrontmatter.category === cat.name}>{cat.name}</option>
                  ))}
                </select>
              </div>
              <div class="setting-row">
                <label class="setting-label">Tags</label>
                <input type="text" class="form-input setting-input" id="postTags" value={editFrontmatter.tags || ''} placeholder="tag1, tag2, tag3" />
                <span class="setting-hint">Comma separated</span>
              </div>
            </div>
          </div>

          <!-- Author Panel -->
          <div class="settings-panel">
            <div class="panel-toggle active" data-panel="author">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Author
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="panel-body" id="panel-author">
              <div class="setting-row">
                <label class="setting-label">Author</label>
                <input type="text" class="form-input setting-input" id="postAuthor" value={editFrontmatter.author || user.username} placeholder="Author name" />
              </div>
              <div class="setting-row">
                <label class="setting-label">Description</label>
                <textarea class="form-input setting-input" id="postDescription" placeholder="SEO description" style="min-height:60px;">{editFrontmatter.description || ''}</textarea>
              </div>
              <div class="setting-row">
                <label class="setting-label">Excerpt</label>
                <textarea class="form-input setting-input" id="postExcerpt" placeholder="Custom excerpt for blog listing" style="min-height:60px;">{editFrontmatter.excerpt || ''}</textarea>
              </div>
            </div>
          </div>

          <!-- Featured Image Panel -->
          <div class="settings-panel">
            <div class="panel-toggle active" data-panel="featured">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              Featured Image
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="panel-body" id="panel-featured">
              <div id="featuredImageWrap">
                <div id="featuredPreview" class="featured-preview" style={editFrontmatter.image ? '' : 'display:none'}>
                  <img id="featuredImg" src={editFrontmatter.image || ''} alt="Featured" />
                  <button type="button" class="remove-featured" id="removeFeatured">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                    Remove
                  </button>
                </div>
                <div id="featuredUploadArea" class="upload-area" style={editFrontmatter.image ? 'display:none' : ''}>
                  <input type="file" id="featuredFileInput" accept="image/*" style="display:none" />
                  <div class="upload-content">
                    <dotlottie-player
                      src="https://lottie.host/8cd7b355-be23-45f8-ad23-bf193f4112e5/zD38rS9z0Q.json"
                      background="transparent"
                      speed="1"
                      style="width: 80px; height: 80px; margin: 0 auto; opacity: 0.8; pointer-events: none;"
                      loop
                      autoplay
                      id="uploadLottieAnimationMain"
                    ></dotlottie-player>
                    <span class="upload-text">Click to upload or drag & drop</span>
                    <span class="upload-hint">JPG, PNG, WebP, GIF — Max 5MB</span>
                  </div>
                </div>
                <input type="hidden" id="postImage" value={editFrontmatter.image || ''} />
                <div class="upload-or">
                  <span>or enter URL</span>
                </div>
                <input type="text" class="form-input setting-input" id="postImageUrl" value={editFrontmatter.image || ''} placeholder="https://example.com/image.jpg" />
              </div>
            </div>
          </div>

          <!-- SEO Panel -->
          <div class="settings-panel">
            <div class="panel-toggle" data-panel="seo">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              SEO Settings
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="panel-body" id="panel-seo" style="display:none;">
              <div class="setting-row">
                <label class="setting-label">Meta Title <span class="setting-hint">(overrides post title)</span></label>
                <input type="text" class="form-input setting-input" id="postSeoTitle" value={editFrontmatter.seoTitle || ''} placeholder="Custom SEO title..." />
              </div>
              <div class="setting-row">
                <label class="setting-label">Meta Keywords</label>
                <input type="text" class="form-input setting-input" id="postSeoKeywords" value={editFrontmatter.seoKeywords || ''} placeholder="keyword1, keyword2" />
                <span class="setting-hint">Comma separated</span>
              </div>
              <div class="setting-row">
                <label class="setting-label">Canonical URL</label>
                <input type="text" class="form-input setting-input" id="postCanonicalUrl" value={editFrontmatter.canonicalUrl || ''} placeholder="https://..." />
              </div>
              <div class="setting-row">
                <label class="setting-label">Robots Directives</label>
                <div class="seo-toggle-row">
                  <label class="seo-checkbox"><input type="checkbox" id="postRobotsIndex" checked={editFrontmatter.robotsIndex !== 'false'} /> Index</label>
                  <label class="seo-checkbox"><input type="checkbox" id="postRobotsFollow" checked={editFrontmatter.robotsFollow !== 'false'} /> Follow</label>
                </div>
              </div>
              <div class="setting-row">
                <label class="setting-label">OG Title</label>
                <input type="text" class="form-input setting-input" id="postOgTitle" value={editFrontmatter.ogTitle || ''} placeholder="Social share title" />
              </div>
              <div class="setting-row">
                <label class="setting-label">OG Description</label>
                <textarea class="form-input setting-input" id="postOgDescription" placeholder="Social share description" style="min-height:60px;">{editFrontmatter.ogDescription || ''}</textarea>
              </div>
              <div class="setting-row">
                <label class="setting-label">OG Image URL</label>
                <input type="text" class="form-input setting-input" id="postOgImage" value={editFrontmatter.ogImage || ''} placeholder="https://...image.jpg" />
                <span class="setting-hint">Recommended: 1200×630px</span>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- Image Picker Modal -->
    <div class="modal-overlay" id="imageModal">
      <div class="modal-card" style="max-width: 700px;">
        <div class="modal-header">
          <h3>Insert Image</h3>
          <button class="modal-close" id="closeImageModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="modal-tabs">
          <button class="modal-tab active" data-tab="upload">Upload</button>
          <button class="modal-tab" data-tab="library">Media Library</button>
          <button class="modal-tab" data-tab="url">From URL</button>
        </div>

        <div class="modal-body">
          <!-- Upload Tab -->
          <div class="tab-content active" id="tab-upload">
            <div class="upload-area upload-area-lg" id="modalUploadArea">
              <input type="file" id="modalFileInput" accept="image/*" style="display:none" />
              <div class="upload-content">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="margin-bottom:12px; opacity:0.3;"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span class="upload-text">Click to upload or drag & drop</span>
                <span class="upload-hint">JPG, PNG, WebP, GIF, SVG — Max 5MB</span>
              </div>
            </div>
            <div id="uploadProgress" style="display:none;" class="upload-progress">
              <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
              <span class="progress-text" id="progressText">Uploading...</span>
            </div>
          </div>

          <!-- Library Tab -->
          <div class="tab-content" id="tab-library">
            <div id="mediaGrid" class="media-grid">
              <div class="loading-state">Loading media library...</div>
            </div>
          </div>

          <!-- URL Tab -->
          <div class="tab-content" id="tab-url">
            <div class="form-group">
              <label>Image URL</label>
              <input type="text" class="form-input" id="modalImageUrl" placeholder="https://example.com/image.jpg" />
            </div>
            <div id="urlPreview" class="url-preview" style="display:none;">
              <img id="urlPreviewImg" alt="Preview" />
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn-secondary" id="cancelImageModal">Cancel</button>
          <button class="btn-primary" id="insertImageConfirm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            Insert Image
          </button>
        </div>
      </div>
    </div>

  ) : (
    <!-- Blog Posts List -->
    <div>
      <div class="flex justify-between items-center mb-24">
        <p class="text-muted text-sm fw-600">{posts.length} post{posts.length !== 1 ? 's' : ''}</p>
        {canWrite && (
          <a href="/admin/blog/?new=1" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            New Post
          </a>
        )}
      </div>

      {posts.length === 0 ? (
        <div class="card">
          <div class="empty-state">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="opacity:0.2; margin-bottom: 12px;"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            <p style="margin-bottom: 16px;">No blog posts yet. Start creating content.</p>
            {canWrite && (
              <a href="/admin/blog/?new=1" class="btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                Create First Post
              </a>
            )}
          </div>
        </div>
      ) : (
        <div class="posts-list-grid">
          {posts.map((post, i) => (
            <div class="post-card" style={`--delay: ${i * 0.06}s`}>
              <div class="post-card-number">
                <span>{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="post-card-thumb-wrap">
                <div class={`post-thumb ${post.image ? 'has-img' : ''}`} style={post.image ? `background-image: url(${post.image})` : ''}>
                  {!post.image && (
                    <div class="thumb-placeholder">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                        <polyline points="14,2 14,8 20,8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                      </svg>
                    </div>
                  )}
                </div>
              </div>
              <div class="post-card-content">
                <div class="post-card-header">
                  <div class="post-badges">
                    {post.status === 'draft'
                      ? <span class="pbadge pbadge--draft"><span class="pbadge-dot"></span>Draft</span>
                      : <span class="pbadge pbadge--live"><span class="pbadge-dot"></span>Live</span>
                    }
                    {post.category && <span class="pbadge pbadge--cat">{post.category}</span>}
                  </div>
                  <span class="post-date">{post.date || '—'}{post.author && <>&nbsp;&middot;&nbsp;{post.author}</>}</span>
                </div>
                <h3 class="post-title">{post.title || post.filename}</h3>
                {post.description && <p class="post-excerpt">{post.description}</p>}
              </div>
              <div class="post-card-actions">
                {canWrite && (
                  <a href={`/admin/blog/?edit=${encodeURIComponent(post.filename)}`} class="act-btn act-edit" title="Edit">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                  </a>
                )}
                {canDelete && (
                  <button class="act-btn act-del delete-btn" data-filename={post.filename} title="Delete">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3,6 5,6 21,6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                  </button>
                )}
              </div>
              <div class="post-card-glow"></div>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  <script is:inline>
    // ── Auto-generate slug from title ──
    const titleInput = document.getElementById('postTitle');
    const slugInput = document.getElementById('postSlug');
    if (titleInput && slugInput && !slugInput.value) {
      titleInput.addEventListener('input', () => {
        slugInput.value = titleInput.value
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .substring(0, 60);
      });
    }

    // ── Panel Toggle (collapsible settings) ──
    document.querySelectorAll('.panel-toggle').forEach(toggle => {
      toggle.addEventListener('click', () => {
        toggle.classList.toggle('active');
        const panelId = 'panel-' + toggle.dataset.panel;
        const body = document.getElementById(panelId);
        if (body) body.style.display = toggle.classList.contains('active') ? 'block' : 'none';
      });
    });

    // ── Toolbar buttons ──
    document.querySelectorAll('.toolbar-btn[data-insert]').forEach(btn => {
      btn.addEventListener('click', () => {
        const editor = document.getElementById('postContent');
        const insert = btn.dataset.insert;
        const wrap = btn.dataset.wrap === 'true';
        const start = editor.selectionStart;
        const end = editor.selectionEnd;
        const selected = editor.value.substring(start, end);
        
        if (wrap && selected) {
          editor.value = editor.value.substring(0, start) + insert + selected + insert + editor.value.substring(end);
          editor.selectionStart = start;
          editor.selectionEnd = end + insert.length * 2;
        } else {
          editor.value = editor.value.substring(0, start) + insert + editor.value.substring(end);
          editor.selectionStart = editor.selectionEnd = start + insert.length;
        }
        editor.focus();
      });
    });

    // ── Featured Image Upload ──
    const featuredUploadArea = document.getElementById('featuredUploadArea');
    const featuredFileInput = document.getElementById('featuredFileInput');
    const featuredPreview = document.getElementById('featuredPreview');
    const featuredImg = document.getElementById('featuredImg');
    const postImageHidden = document.getElementById('postImage');
    const postImageUrl = document.getElementById('postImageUrl');

    featuredUploadArea?.addEventListener('click', () => featuredFileInput?.click());
    featuredUploadArea?.addEventListener('dragover', (e) => { e.preventDefault(); featuredUploadArea.classList.add('dragover'); });
    featuredUploadArea?.addEventListener('dragleave', () => featuredUploadArea.classList.remove('dragover'));
    featuredUploadArea?.addEventListener('drop', (e) => {
      e.preventDefault();
      featuredUploadArea.classList.remove('dragover');
      const file = e.dataTransfer?.files?.[0];
      if (file) uploadFeaturedImage(file);
    });

    featuredFileInput?.addEventListener('change', () => {
      const file = featuredFileInput.files?.[0];
      if (file) uploadFeaturedImage(file);
    });

    async function uploadFeaturedImage(file) {
      const fd = new FormData();
      fd.append('file', file);
      featuredUploadArea.querySelector('.upload-text').textContent = 'Uploading...';
      const lottie = document.getElementById('uploadLottieAnimationMain');
      if (lottie) lottie.setAttribute('src', 'https://lottie.host/81de3fca-a7db-4b44-b0c6-3d274530fc9c/QzY0kI8s9z.json');
      
      try {
        const res = await fetch('/api/upload/', { method: 'POST', body: fd });
        const data = await res.json();
        if (res.ok) {
          // Store the server URL for saving
          postImageHidden.value = data.url;
          postImageUrl.value = data.url;
          // Use a local blob URL for instant visual preview
          featuredImg.onerror = null;
          featuredImg.src = URL.createObjectURL(file);
          featuredPreview.style.display = 'block';
          featuredUploadArea.style.display = 'none';
        } else {
          alert(data.error || 'Upload failed');
        }
      } catch { alert('Upload failed'); }
      
      featuredUploadArea.querySelector('.upload-text').textContent = 'Click to upload or drag & drop';
      if (lottie) lottie.setAttribute('src', 'https://lottie.host/8cd7b355-be23-45f8-ad23-bf193f4112e5/zD38rS9z0Q.json');
    }

    function setFeaturedImage(url) {
      // Disable onerror so CDN lag doesn't nuke the value
      featuredImg.onerror = null;
      postImageHidden.value = url;
      postImageUrl.value = url;
      featuredImg.src = url;
      featuredPreview.style.display = 'block';
      featuredUploadArea.style.display = 'none';
    }

    // On initial page load, if the image is broken, fall back to upload area
    // but do NOT clear the hidden value (user may want to keep the URL)
    if (featuredImg) {
      featuredImg.onerror = function() {
        featuredPreview.style.display = 'none';
        featuredUploadArea.style.display = 'block';
      };
    }

    postImageUrl?.addEventListener('input', () => {
      const val = postImageUrl.value.trim();
      if (val) {
        setFeaturedImage(val);
      }
    });

    document.getElementById('removeFeatured')?.addEventListener('click', () => {
      postImageHidden.value = '';
      postImageUrl.value = '';
      featuredPreview.style.display = 'none';
      featuredUploadArea.style.display = 'block';
    });

    // ── Image Picker Modal ──
    const imageModal = document.getElementById('imageModal');
    let insertImageTarget = 'content'; // 'content' or 'featured'
    let selectedImageUrl = '';

    document.getElementById('insertImageBtn')?.addEventListener('click', () => {
      insertImageTarget = 'content';
      imageModal?.classList.add('show');
      loadMediaLibrary();
    });

    document.getElementById('closeImageModal')?.addEventListener('click', () => imageModal?.classList.remove('show'));
    document.getElementById('cancelImageModal')?.addEventListener('click', () => imageModal?.classList.remove('show'));
    imageModal?.addEventListener('click', (e) => { if (e.target === imageModal) imageModal.classList.remove('show'); });

    // Modal tabs
    document.querySelectorAll('.modal-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('tab-' + tab.dataset.tab)?.classList.add('active');
      });
    });

    // Modal upload
    const modalUploadArea = document.getElementById('modalUploadArea');
    const modalFileInput = document.getElementById('modalFileInput');

    modalUploadArea?.addEventListener('click', () => modalFileInput?.click());
    modalUploadArea?.addEventListener('dragover', (e) => { e.preventDefault(); modalUploadArea.classList.add('dragover'); });
    modalUploadArea?.addEventListener('dragleave', () => modalUploadArea.classList.remove('dragover'));
    modalUploadArea?.addEventListener('drop', (e) => {
      e.preventDefault();
      modalUploadArea.classList.remove('dragover');
      const file = e.dataTransfer?.files?.[0];
      if (file) uploadModalImage(file);
    });
    modalFileInput?.addEventListener('change', () => {
      const file = modalFileInput.files?.[0];
      if (file) uploadModalImage(file);
    });

    async function uploadModalImage(file) {
      const progress = document.getElementById('uploadProgress');
      const progressFill = document.getElementById('progressFill');
      const progressText = document.getElementById('progressText');
      progress.style.display = 'block';
      progressFill.style.width = '30%';
      progressText.textContent = 'Uploading...';

      const lottie = document.getElementById('uploadLottieAnimationModal');
      if (lottie) lottie.setAttribute('src', 'https://lottie.host/81de3fca-a7db-4b44-b0c6-3d274530fc9c/QzY0kI8s9z.json'); // active upload animation

      const fd = new FormData();
      fd.append('file', file);
      try {
        progressFill.style.width = '60%';
        const res = await fetch('/api/upload/', { method: 'POST', body: fd });
        const data = await res.json();
        progressFill.style.width = '100%';
        if (res.ok) {
          selectedImageUrl = data.url;
          progressText.textContent = 'Uploaded! Click "Insert Image" to add.';
          loadMediaLibrary(); // refresh library
        } else {
          progressText.textContent = data.error || 'Upload failed';
        }
      } catch {
        progressText.textContent = 'Upload failed';
      }
      
      if (lottie) lottie.setAttribute('src', 'https://lottie.host/8cd7b355-be23-45f8-ad23-bf193f4112e5/zD38rS9z0Q.json'); // idle animation
    }

    // Media library
    async function loadMediaLibrary() {
      const grid = document.getElementById('mediaGrid');
      try {
        const res = await fetch('/api/upload/');
        const data = await res.json();
        if (data.files?.length > 0) {
          grid.innerHTML = data.files.map(f => `
            <div class="media-item ${selectedImageUrl === f.url ? 'selected' : ''}" data-url="${f.url}">
              <img src="${f.url}" alt="${f.filename}" loading="lazy" />
              <div class="media-name">${f.filename.replace(/^\d+-/, '')}</div>
            </div>
          `).join('');
          grid.querySelectorAll('.media-item').forEach(item => {
            item.addEventListener('click', () => {
              grid.querySelectorAll('.media-item').forEach(i => i.classList.remove('selected'));
              item.classList.add('selected');
              selectedImageUrl = item.dataset.url;
            });
          });
        } else {
          grid.innerHTML = '<div class="empty-state" style="padding:40px 20px;"><p>No images uploaded yet. Use the Upload tab to add images.</p></div>';
        }
      } catch {
        grid.innerHTML = '<div class="empty-state" style="padding:40px 20px;"><p>Failed to load media library.</p></div>';
      }
    }

    // URL preview
    document.getElementById('modalImageUrl')?.addEventListener('input', () => {
      const val = document.getElementById('modalImageUrl').value.trim();
      const preview = document.getElementById('urlPreview');
      const img = document.getElementById('urlPreviewImg');
      if (val) {
        img.src = val;
        preview.style.display = 'block';
        selectedImageUrl = val;
      } else {
        preview.style.display = 'none';
      }
    });

    // Insert image
    document.getElementById('insertImageConfirm')?.addEventListener('click', () => {
      if (!selectedImageUrl) { alert('Please select or upload an image first.'); return; }
      if (insertImageTarget === 'content') {
        const editor = document.getElementById('postContent');
        const pos = editor.selectionStart;
        const md = `![Image description](${selectedImageUrl})\n`;
        editor.value = editor.value.substring(0, pos) + md + editor.value.substring(pos);
        editor.focus();
      }
      imageModal?.classList.remove('show');
      selectedImageUrl = '';
    });

    // ── Save Post ──
    document.getElementById('postForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('saveBtn');
      const msg = document.getElementById('saveMsg');
      btn.disabled = true;
      btn.innerHTML = '<span style="opacity:0.7">Saving...</span>';

      try {
        const res = await fetch('/api/blog/save/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug: document.getElementById('postSlug').value,
            title: document.getElementById('postTitle').value,
            description: document.getElementById('postDescription').value,
            category: document.getElementById('postCategory').value,
            author: document.getElementById('postAuthor').value,
            date: document.getElementById('postDate').value,
            image: document.getElementById('postImage').value,
            status: document.getElementById('postStatus').value,
            visibility: document.getElementById('postVisibility').value,
            tags: document.getElementById('postTags').value,
            excerpt: document.getElementById('postExcerpt').value,
            content: document.getElementById('postContent').value,
            seoTitle: document.getElementById('postSeoTitle')?.value || '',
            seoKeywords: document.getElementById('postSeoKeywords')?.value || '',
            canonicalUrl: document.getElementById('postCanonicalUrl')?.value || '',
            robotsIndex: document.getElementById('postRobotsIndex')?.checked !== false,
            robotsFollow: document.getElementById('postRobotsFollow')?.checked !== false,
            ogTitle: document.getElementById('postOgTitle')?.value || '',
            ogDescription: document.getElementById('postOgDescription')?.value || '',
            ogImage: document.getElementById('postOgImage')?.value || '',
          }),
        });
        const data = await res.json();
        if (res.ok) {
          msg.className = 'alert-success';
          msg.textContent = 'Post saved!';
          msg.style.display = 'block';
          setTimeout(() => window.location.href = '/admin/blog/', 1000);
        } else {
          msg.className = 'alert-error';
          msg.textContent = data.error || 'Failed to save';
          msg.style.display = 'block';
        }
      } catch (err) {
        msg.className = 'alert-error';
        msg.textContent = 'Network error';
        msg.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17,21 17,13 7,13 7,21"/><polyline points="7,3 7,8 15,8"/></svg> Publish';
      }
    });

    // ── Delete post ──
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const filename = btn.dataset.filename;
        if (!confirm(`Delete "${filename}"?`)) return;
        btn.disabled = true;
        try {
          const res = await fetch('/api/blog/delete/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename }),
          });
          if (res.ok) btn.closest('.post-card')?.remove();
          else alert('Failed to delete post');
        } catch { alert('Network error'); }
      });
    });

    // ── Glow mouse tracking ──
    document.querySelectorAll('.post-card').forEach(card => {
      card.addEventListener('mousemove', e => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  </script>
</AdminLayout>

<style is:global>
  /* ─── Editor Layout ─── */
  .editor-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 24px;
    align-items: start;
  }

  /* ─── Title Input ─── */
  .title-input {
    width: 100%;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.5px;
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 12px 0;
    margin-bottom: 20px;
    outline: none;
    font-family: inherit;
    transition: border-color var(--transition);
