    margin-bottom: 8px;
  }
  .progress-fill {
    height: 100%;
    background: var(--gradient-primary);
    border-radius: 2px;
    transition: width 0.3s;
  }
  .progress-text {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* ─── Media Grid ─── */
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
