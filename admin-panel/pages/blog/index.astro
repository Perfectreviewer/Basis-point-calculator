  }
  .remove-featured:hover { background: rgba(248, 113, 113, 0.2); }

  /* ─── Upload Progress ─── */
  .upload-progress {
    margin-top: 16px;
    text-align: center;
  }
  .progress-bar {
    height: 4px;
    background: var(--bg-deep);
