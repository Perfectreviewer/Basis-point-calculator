---
import AdminLayout from "@admin/components/AdminLayout.astro";

export const prerender = false;
---

<AdminLayout title="Technical SEO" activeNav="seo-settings">
  <div class="page-header">
    <h1>Technical SEO</h1>
    <p class="text-muted">
      Manage search console verification, robots.txt, sitemap settings, and meta
      robots directives.
    </p>
  </div>

  <div id="seo-loading" class="loading-state">
    <div class="spinner"></div>
    <p>Loading SEO settings...</p>
  </div>

  <div id="seo-container" style="display: none;">
    <!-- Save bar -->
    <div class="save-bar">
      <div class="save-bar-info">
        <span id="save-status" class="save-status">No unsaved changes</span>
      </div>
      <button id="save-all-btn" class="btn-primary success" disabled>
        <span class="btn-text">Save All Settings</span>
      </button>
    </div>

    <!-- ═══ Search Console Verification ═══ -->
    <div class="settings-section card">
      <div class="section-header">
        <div class="section-icon console-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div>
          <h3>Search Console Verification</h3>
          <p class="section-desc">
            Connect your site to search engines by adding verification codes
          </p>
        </div>
      </div>
      <div class="section-body">
        <div class="console-grid">
          <!-- Google -->
          <div class="console-card">
            <div class="console-card-header">
              <div class="console-logo google-logo">G</div>
              <div>
                <div class="console-name">Google Search Console</div>
                <span id="google-status" class="console-badge not-set"
                  >Not Set</span
                >
              </div>
            </div>
            <div class="form-group">
              <label for="sc-google">Verification Code</label>
              <input
                type="text"
                id="sc-google"
                class="form-input setting-input mono-sm"
                placeholder="e.g. hcS1B80segR023Bj_4E…"
              />
              <div class="help-text">
                <a
                  href="https://search.google.com/search-console"
                  target="_blank"
                  rel="noopener">Google Search Console</a
                > → Settings → Ownership verification → HTML tag
              </div>
            </div>
          </div>

          <!-- Bing -->
          <div class="console-card">
            <div class="console-card-header">
              <div class="console-logo bing-logo">B</div>
              <div>
                <div class="console-name">Bing Webmaster Tools</div>
                <span id="bing-status" class="console-badge not-set"
                  >Not Set</span
                >
              </div>
            </div>
            <div class="form-group">
              <label for="sc-bing">Verification Code</label>
              <input
                type="text"
                id="sc-bing"
                class="form-input setting-input mono-sm"
                placeholder="e.g. F18D0FE7C96C7E20…"
              />
              <div class="help-text">
                <a
                  href="https://www.bing.com/webmasters"
                  target="_blank"
                  rel="noopener">Bing Webmaster Tools</a
                > → Add site → HTML meta tag
              </div>
            </div>
          </div>

          <!-- Yandex -->
          <div class="console-card">
            <div class="console-card-header">
              <div class="console-logo yandex-logo">Y</div>
              <div>
                <div class="console-name">Yandex Webmaster</div>
                <span id="yandex-status" class="console-badge not-set"
                  >Not Set</span
                >
              </div>
            </div>
            <div class="form-group">
              <label for="sc-yandex">Verification Code</label>
              <input
                type="text"
                id="sc-yandex"
                class="form-input setting-input mono-sm"
                placeholder="e.g. 9332963b05ec7034"
              />
              <div class="help-text">
                <a
                  href="https://webmaster.yandex.com"
                  target="_blank"
                  rel="noopener">Yandex Webmaster</a
                > → Add site → Meta tag
              </div>
            </div>
          </div>

          <!-- Pinterest -->
          <div class="console-card">
            <div class="console-card-header">
              <div class="console-logo pinterest-logo">P</div>
              <div>
                <div class="console-name">Pinterest</div>
                <span id="pinterest-status" class="console-badge not-set"
                  >Not Set</span
                >
              </div>
            </div>
            <div class="form-group">
              <label for="sc-pinterest">Verification Code</label>
              <input
                type="text"
                id="sc-pinterest"
                class="form-input setting-input mono-sm"
                placeholder="e.g. d7f3e0a1b9c2…"
              />
              <div class="help-text">
                <a
                  href="https://www.pinterest.com/settings/claim"
                  target="_blank"
                  rel="noopener">Pinterest</a
                > → Settings → Claim → HTML tag
              </div>
            </div>
          </div>

          <!-- Baidu -->
          <div class="console-card">
            <div class="console-card-header">
              <div class="console-logo baidu-logo">百</div>
              <div>
                <div class="console-name">Baidu Webmaster</div>
                <span id="baidu-status" class="console-badge not-set"
                  >Not Set</span
                >
              </div>
            </div>
            <div class="form-group">
              <label for="sc-baidu">Verification Code</label>
              <input
                type="text"
                id="sc-baidu"
                class="form-input setting-input mono-sm"
                placeholder="e.g. code-abc123…"
              />
              <div class="help-text">
                <a
                  href="https://ziyuan.baidu.com"
                  target="_blank"
                  rel="noopener">Baidu Webmaster</a
                > → Site management → Verify
              </div>
            </div>
          </div>

          <!-- Norton -->
          <div class="console-card">
            <div class="console-card-header">
              <div class="console-logo norton-logo">N</div>
              <div>
                <div class="console-name">Norton Safe Web</div>
                <span id="norton-status" class="console-badge not-set"
                  >Not Set</span
                >
              </div>
            </div>
            <div class="form-group">
              <label for="sc-norton">Verification Code</label>
              <input
                type="text"
                id="sc-norton"
                class="form-input setting-input mono-sm"
                placeholder="e.g. xyz123…"
              />
              <div class="help-text">
                <a
                  href="https://safeweb.norton.com"
                  target="_blank"
                  rel="noopener">Norton Safe Web</a
                > → Add site → Meta tag
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ Robots.txt Configuration ═══ -->
    <div class="settings-section card">
      <div class="section-header">
        <div class="section-icon robots-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M12 2a2 2 0 012 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 017 7v1H3v-1a7 7 0 017-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 012-2z"
            ></path>
            <rect x="5" y="16" width="14" height="5" rx="1"></rect>
            <circle cx="8.5" cy="12.5" r="1"></circle>
            <circle cx="15.5" cy="12.5" r="1"></circle>
          </svg>
        </div>
        <div>
          <h3>Robots.txt Configuration</h3>
          <p class="section-desc">
            Control how search engines crawl your site — manage user-agent rules
            and directives
          </p>
        </div>
      </div>
      <div class="section-body">
        <div class="form-row-2col">
          <div class="form-group">
            <label for="sitemap-url">Sitemap URL</label>
            <input
              type="text"
              id="sitemap-url"
              class="form-input setting-input"
              placeholder="/sitemap-index.xml"
            />
          </div>
          <div class="form-group">
            <label>&nbsp;</label>
            <div class="help-text">
              Path appended to your site URL in robots.txt
            </div>
          </div>
        </div>

        <div class="ua-rules-section">
          <label class="section-label">User-Agent Rules</label>
          <div id="ua-rules-list" class="ua-rules-list"></div>
          <button type="button" class="btn-add" id="add-ua-btn"
            >+ Add User-Agent Rule</button
          >
        </div>

        <div class="form-group" style="margin-top: 16px;">
          <label for="custom-directives">Custom Directives</label>
          <textarea
            id="custom-directives"
            class="form-input form-textarea setting-input mono-input"
            rows="4"
            placeholder="# Additional robots.txt directives (one per line)
Crawl-delay: 10"
          ></textarea>
          <div class="help-text">
            Extra lines appended to the end of robots.txt (e.g. Host)
          </div>
        </div>

        <!-- URL Tester -->
        <div class="url-tester-section">
          <label class="section-label">URL Tester</label>
          <div class="help-text" style="margin-bottom: 10px;">
            Test if a URL path is allowed or blocked by your current robots.txt
            rules.
          </div>
          <div class="url-tester-row">
            <select id="tester-ua" class="form-input tester-ua-select">
              <option value="*">All User-Agents (*)</option>
            </select>
            <input
              type="text"
              id="tester-url"
              class="form-input mono-sm"
              placeholder="/example/path/"
            />
            <button type="button" class="btn-secondary" id="test-url-btn">
              Test
            </button>
          </div>
          <div id="tester-result" class="tester-result" style="display: none;">
          </div>
        </div>

        <div class="preview-section">
          <button type="button" class="btn-secondary" id="preview-robots-btn">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              width="14"
              height="14"
              ><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
              ></path><circle cx="12" cy="12" r="3"></circle></svg
            >
            Preview robots.txt
          </button>
          <pre id="robots-preview" class="code-preview" style="display: none;">
          </pre>
        </div>
      </div>
    </div>

    <!-- ═══ Sitemap Settings ═══ -->
    <div class="settings-section card">
      <div class="section-header">
        <div class="section-icon sitemap-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M6 3v12"></path>
            <circle cx="18" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <path d="M18 9a9 9 0 01-9 9"></path>
          </svg>
        </div>
        <div>
          <h3>Sitemap Settings</h3>
          <p class="section-desc">
            Configure which pages appear in your sitemap and their properties
          </p>
        </div>
      </div>
      <div class="section-body">
        <div class="form-row-2col">
          <div class="form-group">
            <label for="sitemap-changefreq">Default Change Frequency</label>
            <select id="sitemap-changefreq" class="form-input setting-input">
              <option value="always">Always</option>
              <option value="hourly">Hourly</option>
              <option value="daily">Daily</option>
              <option value="weekly">Weekly</option>
              <option value="monthly">Monthly</option>
              <option value="yearly">Yearly</option>
              <option value="never">Never</option>
            </select>
          </div>
          <div class="form-group">
            <label for="sitemap-priority">Default Priority</label>
            <select id="sitemap-priority" class="form-input setting-input">
              <option value="1.0">1.0 (Highest)</option>
              <option value="0.9">0.9</option>
              <option value="0.8">0.8</option>
              <option value="0.7">0.7 (Default)</option>
              <option value="0.6">0.6</option>
              <option value="0.5">0.5</option>
              <option value="0.4">0.4</option>
              <option value="0.3">0.3</option>
              <option value="0.2">0.2</option>
              <option value="0.1">0.1 (Lowest)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Exclude Patterns</label>
          <div class="help-text" style="margin-bottom: 10px;">
            URL patterns to exclude from the sitemap. Uses glob matching (e.g. <code
              >/admin/*</code
            >).
          </div>
          <div id="sitemap-excludes" class="tag-list"></div>
          <div class="tag-input-row">
            <input
              type="text"
              id="sitemap-exclude-input"
              class="form-input"
              placeholder="/path-to-exclude/*"
            />
            <button type="button" class="btn-secondary" id="add-exclude-btn"
              >Add</button
            >
          </div>
        </div>

        <!-- Per-Page Overrides -->
        <div class="overrides-section">
          <label class="section-label">Per-Page Overrides</label>
          <div class="help-text" style="margin-bottom: 12px;">
            Override the default priority and change frequency for specific
            pages.
          </div>
          <div class="overrides-table-wrap">
            <table class="overrides-table">
              <thead>
                <tr>
                  <th>URL Path</th>
                  <th>Priority</th>
                  <th>Change Freq</th>
                  <th style="width: 40px;"></th>
                </tr>
              </thead>
              <tbody id="overrides-body"></tbody>
            </table>
          </div>
          <button
            type="button"
            class="btn-add"
            id="add-override-btn"
            style="margin-top: 12px;">+ Add Page Override</button
          >
        </div>
      </div>
    </div>

    <!-- ═══ Meta Robots Settings ═══ -->
    <div class="settings-section card">
      <div class="section-header">
        <div class="section-icon meta-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <div>
          <h3>Meta Robots</h3>
          <p class="section-desc">
            Control the default meta robots tag and noindex patterns for your
            pages
          </p>
        </div>
      </div>
      <div class="section-body">
        <div class="form-group">
          <label for="meta-global-default">Global Default</label>
          <select id="meta-global-default" class="form-input setting-input">
            <option value="index, follow">index, follow (recommended)</option>
            <option value="index, nofollow">index, nofollow</option>
            <option value="noindex, follow">noindex, follow</option>
            <option value="noindex, nofollow">noindex, nofollow</option>
          </select>
          <div class="help-text">
            Applied to all pages unless overridden by a specific pattern below
          </div>
        </div>

        <div class="form-group">
          <label>Noindex Patterns</label>
          <div class="help-text" style="margin-bottom: 10px;">
            URL patterns that should have <code>noindex</code> meta tag.
          </div>
          <div id="noindex-patterns" class="tag-list"></div>
          <div class="tag-input-row">
            <input
              type="text"
              id="noindex-input"
              class="form-input"
              placeholder="/path-to-noindex/*"
            />
            <button type="button" class="btn-secondary" id="add-noindex-btn"
              >Add</button
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style is:global>
  .page-header {
    margin-bottom: 24px;
    animation: fadeIn 0.4s ease-out;
  }
  .page-header h1 {
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 8px;
    background: linear-gradient(135deg, #fff 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 0;
    color: var(--text-muted);
    gap: 16px;
  }
  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-subtle);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .save-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 24px;
    position: sticky;
    top: 65px;
    z-index: 30;
    backdrop-filter: blur(12px);
  }
  .save-status {
    font-size: 13px;
    color: var(--text-muted);
  }
  .save-status.unsaved {
    color: var(--accent-amber, #f59e0b);
    font-weight: 600;
  }
  .save-status.saved {
    color: var(--accent-green);
    font-weight: 600;
  }

  .settings-section {
    margin-bottom: 24px;
  }
  .section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .section-header h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }
  .section-desc {
    font-size: 13px;
    color: var(--text-muted);
  }
  .section-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .section-icon svg {
    width: 20px;
    height: 20px;
  }
  .console-icon {
    background: rgba(251, 191, 36, 0.12);
    color: #fbbf24;
  }
  .robots-icon {
    background: rgba(56, 152, 236, 0.12);
    color: var(--accent-blue);
  }
  .sitemap-icon {
    background: rgba(52, 211, 153, 0.12);
    color: var(--accent-green);
  }
  .meta-icon {
    background: rgba(124, 91, 240, 0.12);
    color: var(--accent-violet);
  }

  .section-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .form-textarea {
    resize: vertical;
    min-height: 70px;
    font-family: inherit;
  }
  .form-row-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .section-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .help-text {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 6px;
    line-height: 1.5;
  }
  .help-text code {
    background: var(--bg-deep);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 11px;
    color: var(--accent-blue);
  }
  .help-text a {
    color: var(--accent-blue);
    text-decoration: none;
  }
  .help-text a:hover {
    text-decoration: underline;
  }

  .mono-input {
    font-family: "SF Mono", "Consolas", "Menlo", monospace !important;
    font-size: 12.5px !important;
    line-height: 1.8 !important;
  }
  .mono-sm {
    font-family: "SF Mono", "Consolas", "Menlo", monospace !important;
    font-size: 12.5px !important;
  }

  /* ─── Search Console Grid ─── */
  .console-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
  .console-card {
    background: var(--bg-deep);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 20px;
    transition: all 0.15s;
  }
  .console-card:hover {
    border-color: var(--border-medium);
  }
  .console-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .console-logo {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
    color: white;
    flex-shrink: 0;
  }
  .google-logo {
    background: linear-gradient(135deg, #4285f4, #34a853);
  }
  .bing-logo {
    background: linear-gradient(135deg, #008373, #00b294);
  }
  .yandex-logo {
    background: linear-gradient(135deg, #fc3f1d, #ff6633);
  }
  .pinterest-logo {
    background: linear-gradient(135deg, #e60023, #ff4444);
  }
  .baidu-logo {
    background: linear-gradient(135deg, #2319dc, #4e6ef2);
    font-size: 14px;
  }
  .norton-logo {
    background: linear-gradient(135deg, #ffc72c, #e6a800);
    color: #333;
  }
  .console-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .console-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 2px;
  }
  .console-badge.connected {
    background: rgba(52, 211, 153, 0.15);
    color: var(--accent-green);
  }
  .console-badge.not-set {
    background: rgba(139, 157, 195, 0.12);
    color: var(--text-muted);
  }

  /* ─── User-Agent Rules ─── */
  .ua-rules-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 12px;
  }
  .ua-rule-block {
    background: var(--bg-deep);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 20px;
    position: relative;
  }
  .ua-rule-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .ua-rule-header label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }
  .ua-rule-header .form-input {
    flex: 1;
  }
  .ua-paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .ua-paths .form-group {
    margin-bottom: 0;
  }
  .crawl-delay-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding-top: 16px;
