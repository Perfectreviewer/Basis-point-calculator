<script>
  let data: any = {};
  let hasChanges = false;

  const saveBtn = document.getElementById("save-all-btn") as HTMLButtonElement;
  const saveStatus = document.getElementById("save-status")!;
  const loadingEl = document.getElementById("seo-loading")!;
  const containerEl = document.getElementById("seo-container")!;

  function markDirty() {
    hasChanges = true;
    saveBtn.disabled = false;
    saveStatus.textContent = "● Unsaved changes";
    saveStatus.className = "save-status unsaved";
  }

  function esc(str: string) {
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }

  /* ─── INIT ─── */
  async function init() {
    try {
      const res = await fetch("/api/admin/seo-settings/");
      if (res.ok) {
        data = await res.json();
      } else {
        alert("Failed to load SEO settings");
        return;
      }
    } catch (e) {
      alert("Network error loading SEO settings");
      return;
    }

    loadingEl.style.display = "none";
    containerEl.style.display = "block";

    // Search Console
    const sc = data.searchConsole || {};
    const consoles = [
      "google",
      "bing",
      "yandex",
      "pinterest",
      "baidu",
      "norton",
    ];
    consoles.forEach((key) => {
      const input = document.getElementById(`sc-${key}`) as HTMLInputElement;
      if (input) {
        input.value = sc[key] || "";
        updateConsoleBadge(key, sc[key]);
        input.addEventListener("input", () => {
          updateConsoleBadge(key, input.value);
          markDirty();
        });
      }
    });

    // Robots
    const robots = data.robots || {};
    (document.getElementById("sitemap-url") as HTMLInputElement).value =
      robots.sitemapUrl || "/sitemap-index.xml";
    (
      document.getElementById("custom-directives") as HTMLTextAreaElement
    ).value = robots.customDirectives || "";
    renderUARules(robots.userAgents || []);

    // Sitemap
    const sitemap = data.sitemap || {};
    (document.getElementById("sitemap-changefreq") as HTMLSelectElement).value =
      sitemap.changefreq || "weekly";
    (document.getElementById("sitemap-priority") as HTMLSelectElement).value =
      sitemap.priority || "0.7";
    renderTags("sitemap-excludes", sitemap.excludePatterns || []);
    renderPageOverrides(sitemap.pageOverrides || {});

    // Meta Robots
    const meta = data.metaRobots || {};
    (
      document.getElementById("meta-global-default") as HTMLSelectElement
    ).value = meta.globalDefault || "index, follow";
    renderTags("noindex-patterns", meta.noindexPatterns || []);

    // Attach change listener
    containerEl.addEventListener("input", markDirty);
    containerEl.addEventListener("change", markDirty);
    saveBtn.addEventListener("click", saveAll);

    // Add UA rule
    document.getElementById("add-ua-btn")!.addEventListener("click", () => {
      addUARule("", ["/"], [], "");
      markDirty();
    });

    // Exclude pattern
    document
      .getElementById("add-exclude-btn")!
      .addEventListener("click", () => {
        const input = document.getElementById(
          "sitemap-exclude-input",
        ) as HTMLInputElement;
        const val = input.value.trim();
        if (val) {
          addTag("sitemap-excludes", val);
          input.value = "";
          markDirty();
        }
      });
    (
      document.getElementById("sitemap-exclude-input") as HTMLInputElement
    ).addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        document.getElementById("add-exclude-btn")!.click();
      }
    });

    // Noindex pattern
    document
      .getElementById("add-noindex-btn")!
      .addEventListener("click", () => {
        const input = document.getElementById(
          "noindex-input",
        ) as HTMLInputElement;
        const val = input.value.trim();
        if (val) {
          addTag("noindex-patterns", val);
          input.value = "";
          markDirty();
        }
      });
    (
      document.getElementById("noindex-input") as HTMLInputElement
    ).addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        document.getElementById("add-noindex-btn")!.click();
      }
    });

    // Preview robots.txt
    document
      .getElementById("preview-robots-btn")!
      .addEventListener("click", () => {
        const preview = document.getElementById("robots-preview")!;
        if (preview.style.display === "none") {
          preview.textContent = generateRobotsPreview();
          preview.style.display = "block";
        } else {
          preview.style.display = "none";
        }
      });

    // URL Tester
    document.getElementById("test-url-btn")!.addEventListener("click", testUrl);
    (
      document.getElementById("tester-url") as HTMLInputElement
    ).addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        testUrl();
      }
    });

    // Add page override
    document
      .getElementById("add-override-btn")!
      .addEventListener("click", () => {
        addOverrideRow("", "0.7", "weekly");
        markDirty();
      });
  }

  /* ─── Search Console Badges ─── */
  function updateConsoleBadge(key: string, value: string) {
    const badge = document.getElementById(`${key}-status`);
    if (!badge) return;
    if (value && value.trim()) {
      badge.textContent = "Connected";
      badge.className = "console-badge connected";
    } else {
      badge.textContent = "Not Set";
      badge.className = "console-badge not-set";
    }
  }

  /* ─── USER-AGENT RULES ─── */
  function renderUARules(rules: any[]) {
    const container = document.getElementById("ua-rules-list")!;
    container.innerHTML = "";
    rules.forEach((rule) =>
      addUARule(
        rule.name,
        rule.allow || [],
        rule.disallow || [],
        rule.crawlDelay || "",
      ),
    );
    updateTesterUAOptions();
  }

  function addUARule(
    name: string,
    allow: string[],
    disallow: string[],
    crawlDelay: string,
  ) {
    const container = document.getElementById("ua-rules-list")!;
    const block = document.createElement("div");
    block.className = "ua-rule-block";
    block.innerHTML = `
      <div class="ua-rule-header">
        <label>User-Agent</label>
        <input type="text" class="form-input ua-name" value="${esc(name)}" placeholder="*" />
        <button type="button" class="remove-rule-btn">Remove</button>
      </div>
      <div class="ua-paths">
        <div class="form-group">
          <label>Allow</label>
          <div class="path-list allow-list"></div>
          <button type="button" class="btn-add-path add-allow-btn">+ Add Allow Path</button>
        </div>
        <div class="form-group">
          <label>Disallow</label>
          <div class="path-list disallow-list"></div>
          <button type="button" class="btn-add-path add-disallow-btn">+ Add Disallow Path</button>
        </div>
      </div>
      <div class="crawl-delay-row">
        <label>Crawl-Delay</label>
        <input type="number" class="form-input crawl-delay-input" value="${esc(crawlDelay)}" placeholder="—" min="0" step="1" />
        <span class="help-text">seconds between requests (leave empty to skip)</span>
      </div>
    `;

    const allowList = block.querySelector(".allow-list")!;
    allow.forEach((p) => addPathRow(allowList as HTMLElement, p));
    const disallowList = block.querySelector(".disallow-list")!;
    disallow.forEach((p) => addPathRow(disallowList as HTMLElement, p));

    block.querySelector(".remove-rule-btn")!.addEventListener("click", () => {
      block.remove();
      markDirty();
      updateTesterUAOptions();
    });
    block.querySelector(".add-allow-btn")!.addEventListener("click", () => {
      addPathRow(allowList as HTMLElement, "");
      markDirty();
    });
    block.querySelector(".add-disallow-btn")!.addEventListener("click", () => {
      addPathRow(disallowList as HTMLElement, "");
      markDirty();
    });
    block
      .querySelector(".ua-name")!
      .addEventListener("input", () => updateTesterUAOptions());

    container.appendChild(block);
    updateTesterUAOptions();
  }

  function addPathRow(container: HTMLElement, value: string) {
    const row = document.createElement("div");
    row.className = "path-row";
    row.innerHTML = `
      <input type="text" class="form-input path-input" value="${esc(value)}" placeholder="/" />
      <button type="button" class="remove-path-btn" title="Remove">×</button>
    `;
    row.querySelector(".remove-path-btn")!.addEventListener("click", () => {
      row.remove();
      markDirty();
    });
    container.appendChild(row);
  }

  /* ─── URL TESTER ─── */
  function updateTesterUAOptions() {
    const select = document.getElementById("tester-ua") as HTMLSelectElement;
    const currentVal = select.value;
    const blocks = document.querySelectorAll(".ua-rule-block");
    select.innerHTML = '<option value="*">All User-Agents (*)</option>';
    blocks.forEach((block) => {
      const name =
        (block.querySelector(".ua-name") as HTMLInputElement).value.trim() ||
        "*";
      if (name !== "*") {
        const opt = document.createElement("option");
        opt.value = name;
        opt.textContent = name;
        select.appendChild(opt);
      }
    });
    select.value = currentVal || "*";
  }

  function testUrl() {
    const ua = (document.getElementById("tester-ua") as HTMLSelectElement)
      .value;
    const url = (
      document.getElementById("tester-url") as HTMLInputElement
    ).value.trim();
    const resultEl = document.getElementById("tester-result")!;

    if (!url) {
      resultEl.style.display = "none";
      return;
    }

    const rules = collectUARules();
    // Find matching UA rule (exact match or wildcard)
    let matchingRule = rules.find((r) => r.name === ua);
    if (!matchingRule) matchingRule = rules.find((r) => r.name === "*");
    if (!matchingRule) {
      resultEl.style.display = "block";
      resultEl.className = "tester-result allowed";
      resultEl.textContent = "✓ Allowed — no matching rule found";
      return;
    }

    // Check disallow first, then allow
    let blocked = false;
    for (const d of matchingRule.disallow) {
      if (d && url.startsWith(d)) {
        blocked = true;
        break;
      }
    }
    if (blocked) {
      // Check if explicitly allowed
      for (const a of matchingRule.allow) {
        if (a && url.startsWith(a) && a.length > 1) {
          blocked = false;
          break;
        }
      }
    }

    resultEl.style.display = "block";
    if (blocked) {
      resultEl.className = "tester-result blocked";
      resultEl.textContent = `✗ Blocked — matched Disallow rule for ${ua}`;
    } else {
      resultEl.className = "tester-result allowed";
      resultEl.textContent = `✓ Allowed — no blocking rule for ${ua}`;
    }
  }

  /* ─── TAGS ─── */
  function renderTags(containerId: string, tags: string[]) {
    const container = document.getElementById(containerId)!;
    container.innerHTML = "";
    tags.forEach((tag) => addTag(containerId, tag));
  }

  function addTag(containerId: string, value: string) {
    const container = document.getElementById(containerId)!;
    const tag = document.createElement("div");
    tag.className = "tag-item";
    tag.innerHTML = `<span>${esc(value)}</span><button type="button" class="tag-remove" title="Remove">×</button>`;
    tag.querySelector(".tag-remove")!.addEventListener("click", () => {
      tag.remove();
      markDirty();
    });
    container.appendChild(tag);
  }

  /* ─── PAGE OVERRIDES ─── */
  function renderPageOverrides(overrides: Record<string, any>) {
    const tbody = document.getElementById("overrides-body")!;
    tbody.innerHTML = "";
    for (const [path, config] of Object.entries(overrides)) {
      addOverrideRow(
        path,
        config.priority || "0.7",
        config.changefreq || "weekly",
      );
    }
  }

  function addOverrideRow(path: string, priority: string, changefreq: string) {
    const tbody = document.getElementById("overrides-body")!;
    const row = document.createElement("tr");
    row.innerHTML = `
      <td><input type="text" class="form-input path-input-cell override-path" value="${esc(path)}" placeholder="/about/" /></td>
      <td>
        <select class="form-input override-priority">
          <option value="1.0" ${priority === "1.0" ? "selected" : ""}>1.0</option>
          <option value="0.9" ${priority === "0.9" ? "selected" : ""}>0.9</option>
          <option value="0.8" ${priority === "0.8" ? "selected" : ""}>0.8</option>
          <option value="0.7" ${priority === "0.7" ? "selected" : ""}>0.7</option>
          <option value="0.6" ${priority === "0.6" ? "selected" : ""}>0.6</option>
          <option value="0.5" ${priority === "0.5" ? "selected" : ""}>0.5</option>
          <option value="0.4" ${priority === "0.4" ? "selected" : ""}>0.4</option>
          <option value="0.3" ${priority === "0.3" ? "selected" : ""}>0.3</option>
          <option value="0.2" ${priority === "0.2" ? "selected" : ""}>0.2</option>
          <option value="0.1" ${priority === "0.1" ? "selected" : ""}>0.1</option>
        </select>
      </td>
      <td>
        <select class="form-input override-changefreq">
          <option value="always" ${changefreq === "always" ? "selected" : ""}>Always</option>
          <option value="hourly" ${changefreq === "hourly" ? "selected" : ""}>Hourly</option>
          <option value="daily" ${changefreq === "daily" ? "selected" : ""}>Daily</option>
          <option value="weekly" ${changefreq === "weekly" ? "selected" : ""}>Weekly</option>
          <option value="monthly" ${changefreq === "monthly" ? "selected" : ""}>Monthly</option>
          <option value="yearly" ${changefreq === "yearly" ? "selected" : ""}>Yearly</option>
          <option value="never" ${changefreq === "never" ? "selected" : ""}>Never</option>
        </select>
      </td>
      <td><button type="button" class="override-remove" title="Remove">×</button></td>
    `;
    row.querySelector(".override-remove")!.addEventListener("click", () => {
      row.remove();
      markDirty();
    });
    tbody.appendChild(row);
  }

  /* ─── PREVIEW ─── */
  function generateRobotsPreview() {
    const rules = collectUARules();
    const sitemapUrl = (
      document.getElementById("sitemap-url") as HTMLInputElement
    ).value.trim();
    const custom = (
      document.getElementById("custom-directives") as HTMLTextAreaElement
    ).value.trim();
    let output = "";
    for (const rule of rules) {
      output += `User-agent: ${rule.name || "*"}\n`;
      for (const a of rule.allow) {
        if (a) output += `Allow: ${a}\n`;
      }
      for (const d of rule.disallow) {
        if (d) output += `Disallow: ${d}\n`;
      }
      if (rule.crawlDelay) output += `Crawl-delay: ${rule.crawlDelay}\n`;
      output += "\n";
    }
    if (sitemapUrl)
      output += `Sitemap: ${window.location.origin}${sitemapUrl}\n`;
    if (custom) output += "\n" + custom + "\n";
    return output.trim();
  }

  /* ─── COLLECT DATA ─── */
  function collectUARules() {
    const blocks = document.querySelectorAll(".ua-rule-block");
    return Array.from(blocks).map((block) => {
      const name = (
        block.querySelector(".ua-name") as HTMLInputElement
      ).value.trim();
      const allow = Array.from(
        block.querySelectorAll(".allow-list .path-input"),
      ).map((el) => (el as HTMLInputElement).value.trim());
      const disallow = Array.from(
        block.querySelectorAll(".disallow-list .path-input"),
      ).map((el) => (el as HTMLInputElement).value.trim());
      const crawlDelay = (
        block.querySelector(".crawl-delay-input") as HTMLInputElement
      ).value.trim();
      return { name, allow, disallow, crawlDelay };
    });
  }

  function collectTags(containerId: string) {
    const container = document.getElementById(containerId)!;
    return Array.from(container.querySelectorAll(".tag-item span")).map(
      (el) => el.textContent || "",
    );
  }

  function collectPageOverrides(): Record<string, any> {
    const rows = document.querySelectorAll("#overrides-body tr");
    const result: Record<string, any> = {};
    rows.forEach((row) => {
      const path = (
        row.querySelector(".override-path") as HTMLInputElement
      ).value.trim();
      if (path) {
        result[path] = {
          priority: (
            row.querySelector(".override-priority") as HTMLSelectElement
          ).value,
          changefreq: (
            row.querySelector(".override-changefreq") as HTMLSelectElement
          ).value,
        };
      }
    });
    return result;
  }

  /* ─── SAVE ─── */
  async function saveAll() {
    saveBtn.disabled = true;
    const btnText = saveBtn.querySelector(".btn-text")!;
    btnText.textContent = "Saving...";

    const consoles = [
      "google",
      "bing",
      "yandex",
      "pinterest",
      "baidu",
      "norton",
    ];
    const searchConsole: Record<string, string> = {};
    consoles.forEach((key) => {
      searchConsole[key] = (
        document.getElementById(`sc-${key}`) as HTMLInputElement
      ).value.trim();
    });

    const payload = {
      searchConsole,
      robots: {
        userAgents: collectUARules(),
        customDirectives: (
          document.getElementById("custom-directives") as HTMLTextAreaElement
        ).value,
        sitemapUrl: (
          document.getElementById("sitemap-url") as HTMLInputElement
        ).value.trim(),
      },
      sitemap: {
        excludePatterns: collectTags("sitemap-excludes"),
        changefreq: (
          document.getElementById("sitemap-changefreq") as HTMLSelectElement
        ).value,
        priority: (
          document.getElementById("sitemap-priority") as HTMLSelectElement
        ).value,
        pageOverrides: collectPageOverrides(),
      },
      metaRobots: {
        globalDefault: (
          document.getElementById("meta-global-default") as HTMLSelectElement
        ).value,
        noindexPatterns: collectTags("noindex-patterns"),
      },
    };

    try {
      const res = await fetch("/api/admin/seo-settings/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        hasChanges = false;
        saveStatus.textContent = "✓ Settings saved";
        saveStatus.className = "save-status saved";
        btnText.textContent = "Save All Settings";
        setTimeout(() => {
          if (!hasChanges) {
            saveStatus.textContent = "No unsaved changes";
            saveStatus.className = "save-status";
          }
        }, 3000);
      } else {
        alert("Failed to save settings");
        btnText.textContent = "Save All Settings";
        saveBtn.disabled = false;
      }
    } catch (e) {
      alert("Network error saving settings");
      btnText.textContent = "Save All Settings";
      saveBtn.disabled = false;
    }
  }

  init();
</script>
