---
import Layout from "@theme/layouts/Layout.astro";
---

<Layout title="Design Preview" description="Preview of design variants">
  <div class="min-h-screen bg-slate-50 dark:bg-slate-950 py-20 px-4">
    <div class="max-w-7xl mx-auto space-y-24">
      <!-- Intro -->
      <div class="text-center">
        <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Design Variants
        </h1>
        <p class="text-slate-500">
          Please choose the style that best fits "Eye Catching and Easy to Use".
        </p>
      </div>

      <!-- Option 1: Neo-Glow -->
      <section>
        <h2
          class="text-2xl font-bold text-slate-400 mb-8 uppercase tracking-widest text-center"
        >
          Option 1: Neo-Glow
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
          <!-- Card 1 -->
          <div
            class="bg-slate-900 rounded-3xl p-8 border border-sky-500/30 shadow-[0_0_40px_rgba(14,165,233,0.15)] relative overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-sky-500/10 to-transparent pointer-events-none"
            >
            </div>
            <h3 class="text-2xl font-bold text-white mb-6 relative z-10">
              Basis Point Calculator
            </h3>
            <div class="space-y-4 relative z-10">
              <div>
                <label
                  class="text-xs font-bold text-sky-400 uppercase tracking-wider"
                  >Basis Points</label
                >
                <input
                  type="text"
                  value="100"
                  class="w-full bg-slate-800/50 border border-sky-500/30 rounded-xl px-4 py-3 text-2xl font-bold text-white focus:outline-none focus:border-sky-400 focus:shadow-[0_0_20px_rgba(14,165,233,0.3)] transition-all mt-2"
                />
              </div>
            </div>
          </div>
          <!-- Card 2 -->
          <div
            class="bg-slate-900 rounded-3xl p-8 border border-indigo-500/30 shadow-[0_0_40px_rgba(99,102,241,0.15)] relative overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-indigo-500/10 to-transparent pointer-events-none"
            >
            </div>
            <h3 class="text-2xl font-bold text-white mb-6 relative z-10">
              What is X bps of Y?
            </h3>
            <div class="space-y-4 relative z-10">
              <div
                class="bg-indigo-600 rounded-xl p-4 text-white shadow-lg shadow-indigo-500/20"
              >
                <div class="text-xs font-bold text-indigo-200 uppercase">
                  Result
                </div>
                <div class="text-3xl font-bold">9.75</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Option 2: Bold Professional -->
      <section>
        <h2
          class="text-2xl font-bold text-slate-400 mb-8 uppercase tracking-widest text-center"
        >
          Option 2: Bold Professional
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
          <!-- Card 1 -->
          <div
            class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden"
          >
            <div class="bg-slate-800 p-6">
              <h3 class="text-xl font-bold text-white flex items-center gap-2">
                <span>📊</span> Basis Point Calculator
              </h3>
            </div>
            <div class="p-8 space-y-6">
              <div>
                <label class="block text-sm font-bold text-slate-700 mb-2"
                  >Basis Points (bps)</label
                >
                <div class="flex">
                  <input
                    type="text"
                    value="100"
                    class="w-full bg-slate-50 border border-slate-300 rounded-l-lg px-4 py-3 text-xl font-bold text-slate-900 focus:ring-2 focus:ring-slate-500 outline-none"
                  />
                  <span
                    class="bg-slate-200 border border-slate-300 border-l-0 rounded-r-lg px-4 flex items-center font-bold text-slate-600"
                    >bps</span
                  >
                </div>
              </div>
            </div>
          </div>
          <!-- Card 2 -->
          <div
            class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden"
          >
            <div class="bg-indigo-700 p-6">
              <h3 class="text-xl font-bold text-white flex items-center gap-2">
                <span>🧮</span> Calculator
              </h3>
            </div>
            <div class="p-8 space-y-6">
              <div class="p-4 bg-indigo-50 border border-indigo-100 rounded-lg">
                <div class="text-sm text-indigo-800 font-bold mb-1">Answer</div>
                <div class="text-2xl text-indigo-700 font-bold">9.75 USD</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Option 3: Modern Glass -->
      <section>
        <h2
          class="text-2xl font-bold text-slate-400 mb-8 uppercase tracking-widest text-center"
        >
          Option 3: Modern Glass
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
          <!-- Card 1 -->
          <div
            class="bg-white/60 backdrop-blur-xl rounded-[2rem] p-8 border border-white/50 shadow-xl relative"
          >
            <div
              class="absolute -z-10 top-0 right-0 w-32 h-32 bg-sky-200 rounded-full blur-3xl opacity-50"
            >
            </div>
            <h3 class="text-2xl font-bold text-slate-800 mb-6">
              Unit Converter
            </h3>
            <div class="space-y-4">
              <div
                class="bg-white/80 rounded-2xl p-2 shadow-sm border border-white"
              >
                <label class="block text-xs font-bold text-slate-400 px-4 pt-2"
                  >BPS</label
                >
                <input
                  type="text"
                  value="100"
                  class="w-full bg-transparent border-none px-4 pb-2 text-3xl font-bold text-slate-800 focus:ring-0"
                />
              </div>
            </div>
          </div>
          <!-- Card 2 -->
          <div
            class="bg-white/60 backdrop-blur-xl rounded-[2rem] p-8 border border-white/50 shadow-xl relative"
          >
            <div
              class="absolute -z-10 top-0 right-0 w-32 h-32 bg-purple-200 rounded-full blur-3xl opacity-50"
            >
            </div>
            <h3 class="text-2xl font-bold text-slate-800 mb-6">
              Impact Calculator
            </h3>
            <div class="space-y-4">
              <div
                class="bg-gradient-to-r from-purple-500 to-indigo-500 rounded-2xl p-6 text-white shadow-lg shadow-indigo-500/30"
              >
                <div
                  class="text-white/80 text-xs font-bold uppercase tracking-wider"
                >
                  Total Value
                </div>
                <div class="text-3xl font-bold mt-1">$65,009.75</div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
