---
// Page SEO Editor — Premium Redesign
import AdminLayout from "@admin/components/AdminLayout.astro";
import {
  readJSON,
  ensureDataDir,
  getSeoConfigPath,
} from "@admin/utils/storage";
import { getSessionFromCookies, validateSessionToken } from "@admin/utils/auth";
import { hasPermission } from "@admin/utils/roles";
import type { Role } from "@admin/utils/roles";

export const prerender = false;

const session = getSessionFromCookies(Astro.request.headers.get("cookie"));
let user = null;
if (session) user = await validateSessionToken(session);
if (!user) return Astro.redirect("/admin/login/");

const canWrite = hasPermission(user.role as Role, "pages:write");

ensureDataDir();
const seoFile = getSeoConfigPath();
const seoData = readJSON<Record<string, any>>(seoFile);

// Common site pages with categories
const pageMap: Record<
  string,
  { label: string; icon: string; category: string }
> = {
  "/": { label: "Homepage", icon: "home", category: "Main" },
  "/calculators/": { label: "Calculators", icon: "calc", category: "Main" },
  "/guides/": { label: "Guides", icon: "book", category: "Main" },
  "/blog/": { label: "Blog", icon: "edit", category: "Main" },
  "/faq/": { label: "FAQ", icon: "help", category: "Main" },
  "/about/": { label: "About", icon: "info", category: "Main" },
  "/legal/": { label: "Legal", icon: "shield", category: "Main" },
  "/basis-point-calculators/": {
    label: "Basis Point Calcs",
    icon: "calc",
    category: "Calculators",
  },
  "/interest-rate-calculators/": {
    label: "Interest Rate Calcs",
    icon: "calc",
    category: "Calculators",
  },
  "/loan-calculators/": {
    label: "Loan Calculators",
    icon: "calc",
    category: "Calculators",
  },
  "/bond-calculators/": {
    label: "Bond Calculators",
    icon: "calc",
    category: "Calculators",
  },
  "/investment-calculators/": {
    label: "Investment Calcs",
    icon: "calc",
    category: "Calculators",
  },
};

const defaultPages = Object.keys(pageMap);
const allPages = [
  ...new Set([...defaultPages, ...Object.keys(seoData)]),
].sort();
const configuredCount = allPages.filter((p) => seoData[p]).length;
---

<AdminLayout title="Page SEO Settings" activeNav="pages">
  <div class="seo-layout">
    <!-- Page List Sidebar -->
    <div class="page-sidebar">
      <!-- Search -->
      <div class="sidebar-search">
        <svg
          class="search-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
          ></path></svg
        >
        <input
          type="text"
          class="search-input"
          id="pageSearch"
          placeholder="Search pages..."
        />
      </div>

      <!-- Stats Bar -->
      <div class="sidebar-stats">
        <div class="stat-chip">
          <span class="stat-chip-num">{allPages.length}</span>
          <span>Total</span>
        </div>
        <div class="stat-chip configured">
          <span class="stat-chip-num">{configuredCount}</span>
          <span>Configured</span>
        </div>
        <div class="stat-chip pending">
          <span class="stat-chip-num">{allPages.length - configuredCount}</span>
          <span>Pending</span>
        </div>
      </div>

      <!-- Page Items -->
      <div class="page-items" id="pageList">
        {
          allPages.map((path) => {
            const info = pageMap[path];
            const configured = !!seoData[path];
            return (
              <button
                class="page-item"
                data-path={path}
                data-label={info?.label || path}
              >
                <div class={`page-item-icon ${configured ? "configured" : ""}`}>
                  {info?.icon === "home" ? (
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                  ) : info?.icon === "calc" ? (
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <rect x="4" y="2" width="16" height="20" rx="2" />
                      <line x1="8" y1="6" x2="16" y2="6" />
                      <line x1="8" y1="10" x2="10" y2="10" />
                      <line x1="14" y1="10" x2="16" y2="10" />
                      <line x1="8" y1="14" x2="10" y2="14" />
                      <line x1="14" y1="14" x2="16" y2="14" />
                      <line x1="8" y1="18" x2="10" y2="18" />
                      <line x1="14" y1="18" x2="16" y2="18" />
                    </svg>
                  ) : info?.icon === "book" ? (
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M4 19.5A2.5 2.5 0 016.5 17H20" />
                      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" />
                    </svg>
                  ) : info?.icon === "edit" ? (
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M12 20h9" />
                      <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                    </svg>
                  ) : info?.icon === "help" ? (
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3" />
                      <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                  ) : info?.icon === "info" ? (
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <path d="M12 16v-4M12 8h.01" />
                    </svg>
                  ) : info?.icon === "shield" ? (
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                  ) : (
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                      <polyline points="14,2 14,8 20,8" />
                    </svg>
                  )}
                </div>
                <div class="page-item-text">
                  <span class="page-item-label">{info?.label || path}</span>
                  <span class="page-item-path">{path}</span>
                </div>
                <div class="page-item-status">
                  {configured ? (
                    <span class="seo-badge ok" title="SEO configured">
                      <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </span>
                  ) : (
                    <span class="seo-badge missing" title="SEO not configured">
                      <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                      >
                        <circle cx="12" cy="12" r="1" />
                      </svg>
                    </span>
                  )}
                </div>
              </button>
            );
          })
        }
      </div>

      <!-- Add Page -->
      {
        canWrite && (
          <div class="add-page-section">
            <div class="add-page-row">
              <input
                type="text"
                class="add-page-input"
                id="newPagePath"
                placeholder="/new-page/"
              />
              <button class="add-page-btn" id="addPageBtn" title="Add page">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </button>
            </div>
          </div>
        )
      }
    </div>

    <!-- SEO Editor -->
    <div class="seo-editor" id="seoEditor">
      <!-- Empty State -->
      <div class="editor-empty" id="editorEmpty">
        <div class="empty-icon-wrap">
          <svg
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"
            ></path></svg
          >
          <div class="empty-pulse"></div>
        </div>
        <h3 class="empty-title">Select a page to optimize</h3>
        <p class="empty-desc">
          Choose a page from the list to manage its SEO settings, preview search
          results, and improve your rankings.
        </p>
        <div class="empty-tips">
          <div class="empty-tip">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
            >
            Write compelling title tags under 60 characters
          </div>
          <div class="empty-tip">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
            >
            Include target keywords in meta descriptions
          </div>
          <div class="empty-tip">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
            >
            Add structured data for rich search results
          </div>
        </div>
      </div>

      <!-- Editor Form -->
      <div id="editorForm" style="display: none;">
        <!-- Header -->
        <div class="editor-top">
          <div class="editor-top-left">
            <div class="editor-breadcrumb">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><circle cx="11" cy="11" r="8"></circle><path
                  d="m21 21-4.35-4.35"></path></svg
              >
              <span>SEO Settings</span>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
              >
              <span class="editor-breadcrumb-page" id="editorPath"></span>
            </div>
          </div>
          <div class="editor-top-right">
            <div id="seoMsg" class="seo-msg" style="display: none;"></div>
            {
              canWrite && (
                <button class="save-btn" id="saveSeoBtn">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <>
                      <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                      <polyline points="17,21 17,13 7,13 7,21" />
                      <polyline points="7,3 7,8 15,8" />
                    </>
                  </svg>
                  Save Changes
                </button>
              )
            }
          </div>
        </div>

        <!-- SEO Score -->
        <div class="seo-score-card" id="seoScoreCard">
          <div class="score-ring-wrap">
            <svg class="score-ring" width="64" height="64" viewBox="0 0 64 64">
              <circle
                class="score-ring-bg"
                cx="32"
                cy="32"
                r="26"
                fill="none"
                stroke-width="5"></circle>
              <circle
                class="score-ring-fill"
                id="scoreRingFill"
                cx="32"
                cy="32"
                r="26"
                fill="none"
                stroke-width="5"
                stroke-dasharray="163.36"
                stroke-dashoffset="163.36"
                stroke-linecap="round"
                transform="rotate(-90 32 32)"></circle>
            </svg>
            <span class="score-num" id="scoreNum">0</span>
          </div>
          <div class="score-details">
            <div class="score-title">SEO Score</div>
            <div class="score-checks">
              <div class="score-check" id="check-title">
                <span class="score-check-icon"></span>
                <span>Meta title</span>
              </div>
              <div class="score-check" id="check-desc">
                <span class="score-check-icon"></span>
                <span>Meta description</span>
              </div>
              <div class="score-check" id="check-keywords">
                <span class="score-check-icon"></span>
                <span>Keywords</span>
              </div>
              <div class="score-check" id="check-schema">
                <span class="score-check-icon"></span>
                <span>Structured data</span>
              </div>
            </div>
          </div>
        </div>

        <!-- SERP Preview -->
        <div class="serp-section">
          <div class="section-label">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><circle cx="12" cy="12" r="10"></circle><path
                d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"
              ></path></svg
            >
            Google Search Preview
          </div>
          <div class="serp-card">
            <div class="serp-url-row">
              <div class="serp-favicon">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="2"
                  ><circle cx="12" cy="12" r="10"></circle><path
                    d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"
                  ></path></svg
                >
              </div>
              <div class="serp-url-text">
                <span class="serp-site-name">BasisPoint Calculator</span>
                <span class="serp-url" id="serpUrl"
                  >basispointcalculator.com ›</span
                >
              </div>
              <svg
                class="serp-dots"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#9aa0a6"
                stroke-width="2"
                ><circle cx="12" cy="5" r="1"></circle><circle
                  cx="12"
                  cy="12"
                  r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg
              >
            </div>
            <div class="serp-title" id="serpTitle">Page Title</div>
            <div class="serp-desc" id="serpDesc">
              Page description will appear here. Keep it under 160 characters
              for best results in search engine results pages.
            </div>
          </div>
        </div>

        <!-- Form Sections -->
        <div class="seo-form-sections">
          <!-- Meta Title -->
          <div class="form-section">
            <div class="section-label">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M4 7V4h16v3M9 20h6M12 4v16"></path></svg
              >
              Meta Title
            </div>
            <div class="input-wrap">
              <input
                type="text"
                class="seo-input"
                id="seoTitle"
                placeholder="Enter a compelling page title..."
              />
              <div class="input-meta">
                <div class="char-bar">
                  <div class="char-fill" id="titleProgress" style="width: 0%">
                  </div>
                </div>
                <span class="char-label"
                  ><span id="titleCount">0</span> / 60 characters</span
                >
              </div>
            </div>
          </div>

          <!-- Meta Description -->
          <div class="form-section">
            <div class="section-label">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"
                ></path><polyline points="14,2 14,8 20,8"></polyline><line
                  x1="16"
                  y1="13"
                  x2="8"
                  y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
                ></line></svg
              >
              Meta Description
            </div>
            <div class="input-wrap">
              <textarea
                class="seo-input seo-textarea"
                id="seoDescription"
                placeholder="Write a concise description that entices users to click..."
              ></textarea>
              <div class="input-meta">
                <div class="char-bar">
                  <div class="char-fill" id="descProgress" style="width: 0%">
                  </div>
                </div>
                <span class="char-label"
                  ><span id="descCount">0</span> / 160 characters</span
                >
              </div>
            </div>
          </div>

          <!-- Keywords -->
          <div class="form-section">
            <div class="section-label">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"
                ></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg
              >
              Meta Keywords
            </div>
            <div class="input-wrap">
              <input
                type="text"
                class="seo-input"
                id="seoKeywords"
                placeholder="basis points, calculator, finance, interest rates"
              />
              <span class="input-hint">Separate keywords with commas</span>
            </div>
          </div>

          <!-- Schema / JSON-LD -->
          <div class="form-section">
            <div class="section-label">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><polyline points="16 18 22 12 16 6"></polyline><polyline
                  points="8 6 2 12 8 18"></polyline></svg
              >
              Structured Data (JSON-LD)
            </div>
            <div class="input-wrap">
              <textarea
                class="seo-input seo-code"
                id="seoSchema"
                placeholder='{"@type": "WebPage", "name": "..."}'></textarea>
              <span class="input-hint"
                >Valid JSON-LD schema for rich search results</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ seoData: JSON.stringify(seoData) }}>
    const data = JSON.parse(seoData);
    let currentPath = "";

    // ── Search/Filter ──
    document.getElementById("pageSearch")?.addEventListener("input", (e) => {
      const q = e.target.value.toLowerCase();
      document.querySelectorAll(".page-item").forEach((item) => {
        const path = item.dataset.path.toLowerCase();
        const label = (item.dataset.label || "").toLowerCase();
        item.style.display =
          path.includes(q) || label.includes(q) ? "" : "none";
      });
    });

    // ── Page selection ──
    document.querySelectorAll(".page-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".page-item")
          .forEach((b) => b.classList.remove("selected"));
        btn.classList.add("selected");
        currentPath = btn.dataset.path;
        loadPageSeo(currentPath);
      });
    });

    function loadPageSeo(path) {
      document.getElementById("editorEmpty").style.display = "none";
      document.getElementById("editorForm").style.display = "block";
      document.getElementById("editorPath").textContent = path;

      const seo = data[path] || {};
      document.getElementById("seoTitle").value = seo.title || "";
      document.getElementById("seoDescription").value = seo.description || "";
      document.getElementById("seoKeywords").value = seo.keywords || "";
      document.getElementById("seoSchema").value = seo.schema
        ? JSON.stringify(seo.schema, null, 2)
        : "";
      updatePreview();
      updateCounts();
      updateScore();
    }

    // ── Live SERP preview ──
    const titleInput = document.getElementById("seoTitle");
    const descInput = document.getElementById("seoDescription");
    const kwInput = document.getElementById("seoKeywords");
    const schemaInput = document.getElementById("seoSchema");

    [titleInput, descInput, kwInput, schemaInput].forEach((el) => {
      el?.addEventListener("input", () => {
        updatePreview();
        updateCounts();
        updateScore();
      });
    });

    function updatePreview() {
      document.getElementById("serpTitle").textContent =
        titleInput.value || "Page Title";
      document.getElementById("serpUrl").textContent =
        "basispointcalculator.com" + currentPath;
      document.getElementById("serpDesc").textContent =
        descInput.value ||
        "Page description will appear here. Keep it under 160 characters for best results.";
    }

    function updateCounts() {
      const tLen = titleInput.value.length;
      const dLen = descInput.value.length;
      document.getElementById("titleCount").textContent = tLen;
      document.getElementById("descCount").textContent = dLen;
      const tPct = Math.min((tLen / 60) * 100, 100);
      const dPct = Math.min((dLen / 160) * 100, 100);
      const tFill = document.getElementById("titleProgress");
      const dFill = document.getElementById("descProgress");
      tFill.style.width = tPct + "%";
      dFill.style.width = dPct + "%";
      // Color coding: green=good, yellow=warning, red=over
      tFill.className =
        "char-fill " + (tLen > 60 ? "over" : tLen > 45 ? "good" : "");
      dFill.className =
        "char-fill " + (dLen > 160 ? "over" : dLen > 120 ? "good" : "");
    }

    function updateScore() {
      let score = 0;
      const checks = {
        "check-title":
          titleInput.value.length > 0 && titleInput.value.length <= 60,
        "check-desc":
          descInput.value.length > 0 && descInput.value.length <= 160,
        "check-keywords": kwInput.value.trim().length > 0,
        "check-schema": schemaInput.value.trim().length > 0,
      };
      Object.entries(checks).forEach(([id, ok]) => {
        const el = document.getElementById(id);
        el.className = "score-check " + (ok ? "pass" : "fail");
        if (ok) score += 25;
      });
      document.getElementById("scoreNum").textContent = score;
      const ring = document.getElementById("scoreRingFill");
      const circumference = 163.36;
      ring.style.strokeDashoffset =
        circumference - (score / 100) * circumference;
      ring.style.stroke =
        score >= 75
          ? "var(--accent-green)"
          : score >= 50
            ? "#fbbf24"
            : "var(--accent-red)";
      document.getElementById("scoreNum").style.color =
        score >= 75
          ? "var(--accent-green)"
          : score >= 50
            ? "#fbbf24"
            : "var(--accent-red)";
    }

    // ── Save ──
    document
      .getElementById("saveSeoBtn")
      ?.addEventListener("click", async () => {
        const btn = document.getElementById("saveSeoBtn");
        const msg = document.getElementById("seoMsg");
        btn.disabled = true;
        btn.innerHTML = '<span class="save-spinner"></span> Saving...';

        let schema = null;
        const schemaStr = document.getElementById("seoSchema").value.trim();
        if (schemaStr) {
          try {
            schema = JSON.parse(schemaStr);
          } catch {
            msg.className = "seo-msg error";
            msg.textContent = "Invalid JSON in schema field";
            msg.style.display = "block";
            btn.disabled = false;
            btn.innerHTML =
              '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17,21 17,13 7,13 7,21"/><polyline points="7,3 7,8 15,8"/></svg> Save Changes';
            return;
          }
        }

        try {
          const res = await fetch("/api/pages/save/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              path: currentPath,
              title: titleInput.value,
              description: descInput.value,
              keywords: kwInput.value,
              schema,
            }),
          });
          if (res.ok) {
            msg.className = "seo-msg success";
            msg.textContent = "✓ Settings saved successfully";
            data[currentPath] = {
              title: titleInput.value,
              description: descInput.value,
              keywords: kwInput.value,
              schema,
            };
            // Update the page item status
            const item = document.querySelector(
              `.page-item[data-path="${currentPath}"]`,
            );
            if (item)
              item
                .querySelector(".page-item-icon")
                ?.classList.add("configured");
            if (item) {
              const badge = item.querySelector(".seo-badge");
              if (badge) {
                badge.className = "seo-badge ok";
                badge.innerHTML =
                  '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>';
              }
            }
          } else {
            const d = await res.json();
            msg.className = "seo-msg error";
            msg.textContent = d.error || "Failed to save";
          }
        } catch {
          msg.className = "seo-msg error";
          msg.textContent = "Network error — please try again";
        }
        msg.style.display = "block";
        btn.disabled = false;
        btn.innerHTML =
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17,21 17,13 7,13 7,21"/><polyline points="7,3 7,8 15,8"/></svg> Save Changes';
        setTimeout(() => {
          msg.style.display = "none";
        }, 3500);
      });

    // ── Add custom page ──
    document.getElementById("addPageBtn")?.addEventListener("click", () => {
      const input = document.getElementById("newPagePath");
      let path = input.value.trim();
      if (!path) return;
      if (!path.startsWith("/")) path = "/" + path;
      if (!path.endsWith("/")) path += "/";

      const btn = document.createElement("button");
      btn.className = "page-item";
      btn.dataset.path = path;
      btn.dataset.label = path;
      btn.innerHTML = `
        <div class="page-item-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
        </div>
        <div class="page-item-text">
          <span class="page-item-label">${path}</span>
          <span class="page-item-path">${path}</span>
        </div>
        <div class="page-item-status">
          <span class="seo-badge missing">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="1"/></svg>
          </span>
        </div>
      `;
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".page-item")
          .forEach((b) => b.classList.remove("selected"));
        btn.classList.add("selected");
        currentPath = path;
        loadPageSeo(path);
      });
      document.getElementById("pageList").appendChild(btn);
      input.value = "";
    });
  </script>
</AdminLayout>

