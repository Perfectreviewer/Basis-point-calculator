---
import AdminLayout from "@admin/components/AdminLayout.astro";

export const prerender = false;
// Force rebuild
---

<AdminLayout title="Menu Management" activeNav="menus">
  <div class="page-header">
    <h1>Menu Management</h1>
    <p class="text-muted">
      Manage header and footer menus with drag-and-drop reordering.
    </p>
  </div>

  <div class="menu-manager-container">
    <!-- Tabs -->
    <div class="tabs">
      <button class="tab-btn active" data-tab="header">Header Menu</button>
      <button class="tab-btn" data-tab="footer">Footer Menu</button>
    </div>

    <div class="menu-workspace">
      <!-- Left: Add/Edit Items -->
      <div class="menu-controls card">
        <h3>Add Custom Link</h3>
        <form id="add-link-form" class="menu-form">
          <div class="form-group">
            <label for="link-label">Navigation Label</label>
            <input
              type="text"
              id="link-label"
              class="form-input"
              placeholder="e.g. Home"
              required
            />
          </div>
          <div class="form-group">
            <label for="link-url">URL</label>
            <input
              type="text"
              id="link-url"
              class="form-input"
              placeholder="e.g. / or https://..."
              required
            />
          </div>
          <button type="submit" class="btn-primary w-full">Add to Menu</button>
        </form>

        <div class="divider"></div>

        <div class="tips">
          <h4>💡 Tips</h4>
          <ul>
            <li>Drag items to reorder</li>
            <li>Drag right to nest as child</li>
            <li>Click <span class="icon-toggle">▼</span> to edit settings</li>
            <li>Edit Label & URL inline</li>
          </ul>
        </div>

        <div class="divider"></div>

        <button id="save-menu-btn" class="btn-primary success w-full">
          <span class="btn-text">Save Menu</span>
          <span class="loader" style="display:none"></span>
        </button>
      </div>

      <!-- Right: Tree Editor -->
      <div class="menu-tree-wrapper card">
        <div id="header-editor" class="menu-editor active">
          <div class="empty-state">Loading header menu...</div>
        </div>
        <div id="footer-editor" class="menu-editor" style="display: none;">
          <div class="empty-state">Loading footer menu...</div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<!-- Global Styles: Essential for dynamically created SortableJS elements -->
<style is:global>
  /* Page Layout Styles */
  .page-header {
    margin-bottom: 24px;
    animation: fadeIn 0.4s ease-out;
  }
  .page-header h1 {
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 8px;
    background: linear-gradient(135deg, #fff 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .menu-manager-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0;
    position: relative;
  }
  .tabs::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--border-subtle);
    z-index: 0;
  }

  .tab-btn {
    padding: 12px 24px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    z-index: 1;
    font-size: 14px;
  }
  .tab-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.02);
  }
  .tab-btn.active {
    color: var(--accent-blue);
    border-bottom-color: var(--accent-blue);
  }

  .menu-workspace {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 32px;
    align-items: start;
  }

  .menu-controls {
    position: sticky;
    top: 90px;
    backdrop-filter: blur(20px);
  }

  .menu-form {
    margin-top: 20px;
  }

  .menu-form .form-group {
    margin-bottom: 16px;
  }

  .divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 24px 0;
  }
  .w-full {
    width: 100%;
  }

  .tips {
    background: rgba(56, 152, 236, 0.05);
    border: 1px solid rgba(56, 152, 236, 0.1);
    border-radius: var(--radius-sm);
    padding: 16px;
  }
  .tips h4 {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .tips ul {
    padding-left: 20px;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .tips li {
    margin-bottom: 4px;
  }

  /* Reset lists for Sortable */
  .menu-editor ul,
  ul.sortable-list {
    list-style: none !important;
    padding-left: 0 !important;
    margin: 0 !important;
  }

  .menu-editor {
    min-height: 300px;
    background: rgba(19, 28, 46, 0.5);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--border-medium);
    padding: 24px;
  }

  .sortable-list {
    min-height: 50px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* --- Item Card Styling --- */
  .sortable-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    /* overflow: hidden; Removed to allow dropdowns if needed, though accordion stays inside */
  }

  .sortable-item.dragging {
    opacity: 0.5;
    background: var(--bg-hover);
  }

  /* Content Row */
  .item-content {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    gap: 16px;
    background: var(--bg-elevated);
    position: relative;
    z-index: 2;
    justify-content: space-between; /* Ensure toggle is projected to right */
    width: 100%;
    box-sizing: border-box;
  }
  .item-content:hover {
    background: var(--bg-hover);
  }

  /* Drag Handle */
  .item-handle {
    color: var(--text-muted);
    cursor: grab;
    padding: 6px;
    border-radius: 4px;
    font-size: 18px;
    line-height: 1;
    opacity: 0.6;
    display: flex;
    align-items: center;
  }
  .item-handle:hover {
    background: rgba(255, 255, 255, 0.05);
    opacity: 1;
    color: var(--text-primary);
  }

  /* Item Meta (Label + URL) */
  .item-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px; /* Space between label and url */
    min-width: 0; /* Allow text truncate */
  }

  .item-label-display {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .item-url-display {
    font-size: 11px;
    color: var(--text-muted);
    font-family: monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Toggle Arrow */
  .toggle-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 12px;
  }
  .toggle-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-subtle);
    background: var(--bg-surface);
  }
  .toggle-btn.active {
    background: var(--bg-hover);
    color: var(--accent-blue);
    transform: rotate(180deg);
  }

  /* --- Settings Panel (WordPress Style) --- */
  .item-settings {
    display: none;
    padding: 16px;
    background: var(--bg-base); /* Slightly darker than item */
    border-top: 1px solid var(--border-subtle);
    animation: slideDown 0.2s ease-out;
  }
  .item-settings.active {
    display: block;
  }
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .settings-group label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  .settings-input {
    width: 100%;
    padding: 8px 12px;
    background: var(--bg-deep);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    color: var(--text-primary);
    font-size: 13px;
    transition: all 0.2s;
    box-sizing: border-box;
  }
  .settings-input:focus {
    border-color: var(--accent-blue);
    outline: none;
    box-shadow: 0 0 0 2px rgba(56, 152, 236, 0.1);
  }

  .settings-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .remove-link {
    color: var(--accent-red);
    font-size: 13px;
    text-decoration: none;
    cursor: pointer;
    font-weight: 500;
  }
  .remove-link:hover {
    text-decoration: underline;
  }

  .cancel-link {
    color: var(--text-muted);
    font-size: 13px;
    text-decoration: none;
    cursor: pointer;
    font-weight: 500;
  }
  .cancel-link:hover {
    color: var(--text-primary);
  }

  /* --- Nested Sub-menus --- */
  .sub-menu {
    border-top: 1px solid var(--border-subtle);
    padding: 16px 0 16px 20px !important; /* Indent sub items */
    background: rgba(0, 0, 0, 0.1);
    margin-top: 0;
    width: 100%;
    box-sizing: border-box;
  }

  /* Style mostly empty drop zones */
  .sub-menu:empty {
    padding: 12px !important;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--border-subtle);
    margin: 0;
    border-radius: 0 0 6px 6px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sub-menu:empty::after {
    content: "Drop items here to nest";
    display: block;
    text-align: center;
    color: var(--text-muted);
    font-size: 12px;
    font-style: italic;
    opacity: 0.6;
  }

  /* Dragging States */
  .sortable-ghost {
    opacity: 0.4;
    background: var(--accent-blue);
    border: 1px dashed var(--accent-blue);
  }
  .sortable-drag {
    cursor: grabbing;
    opacity: 1;
    background: var(--bg-elevated);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--accent-blue);
    transform: scale(1.02);
    z-index: 1000;
  }

  @media (max-width: 768px) {
    .menu-workspace {
      grid-template-columns: 1fr;
    }
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import Sortable from "sortablejs";

  let menuData = { header: [], footer: [] };
  let activeTab = "header";

  // DOM Elements
  const headerEditor = document.getElementById("header-editor");
  const footerEditor = document.getElementById("footer-editor");
  const addForm = document.getElementById("add-link-form");
  const labelInput = document.getElementById("link-label") as HTMLInputElement;
  const urlInput = document.getElementById("link-url") as HTMLInputElement;
  const saveBtn = document.getElementById("save-menu-btn");
  const tabBtns = document.querySelectorAll(".tab-btn");

  // Initialize
  async function init() {
    await fetchMenuData();
    renderMenu("header", menuData.header, headerEditor);
    renderMenu("footer", menuData.footer, footerEditor);
    setupTabs();
    setupForm();
    setupSave();
  }

  async function fetchMenuData() {
    try {
      const res = await fetch("/api/admin/menu/");
      if (res.ok) {
        menuData = await res.json();
      } else {
        console.error("Failed to load menu");
        showError("Server returned " + res.status);
      }
    } catch (e) {
      console.error(e);
      showError("Network error: " + e);
    }
  }

  function showError(msg: string) {
    const errContent = `<div class="empty-state" style="color: var(--accent-red)">Error: ${msg}</div>`;
    if (headerEditor) headerEditor.innerHTML = errContent;
    if (footerEditor) footerEditor.innerHTML = errContent;
  }

  function setupTabs() {
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeTab = btn.getAttribute("data-tab") || "header";

        if (activeTab === "header") {
          headerEditor!.style.display = "block";
          footerEditor!.style.display = "none";
        } else {
          headerEditor!.style.display = "none";
          footerEditor!.style.display = "block";
        }
      });
    });
  }

  function setupForm() {
    addForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const label = labelInput.value.trim();
      const url = urlInput.value.trim();

      if (!label || !url) return;

      // Create new item DOM - append to currently active list
      const newItem = createMenuItem(label, url);
      const activeContainer =
        activeTab === "header" ? headerEditor : footerEditor;
      const list = activeContainer?.querySelector(".sortable-list");

      if (list) {
        list.appendChild(newItem);
      } else {
        // If it's empty state
        activeContainer!.innerHTML = `<ul class="sortable-list root-list"></ul>`;
        const root = activeContainer!.querySelector(
          ".sortable-list",
        ) as HTMLElement;
        root.appendChild(newItem);
        initSortable(root);
      }

      // Reset form
      labelInput.value = "";
      urlInput.value = "";
    });
  }

  function createMenuItem(name: string, url: string, children: any[] = []) {
    const li = document.createElement("li");
    li.className = "sortable-item";

    // Header content
    const content = document.createElement("div");
    content.className = "item-content";
    content.innerHTML = `
        <span class="item-handle">☰</span>
        <div class="item-meta">
            <span class="item-label-display">${name}</span>
            <span class="item-url-display">${url}</span>
        </div>
        <button type="button" class="toggle-btn" title="Edit Item">▼</button>
    `;
    li.appendChild(content);

    // Settings Panel (Initially Hidden)
    const settings = document.createElement("div");
    settings.className = "item-settings";
    settings.innerHTML = `
        <div class="settings-grid">
            <div class="settings-group">
                <label>Navigation Label</label>
                <input type="text" class="settings-input edit-label" value="${name}">
            </div>
            <div class="settings-group">
                <label>URL</label>
                <input type="text" class="settings-input edit-url" value="${url}">
            </div>
        </div>
        <div class="settings-footer">
            <span class="remove-link">Remove</span>
            <span class="cancel-link">Close</span>
        </div>
    `;
    li.appendChild(settings);

    // --- Logic ---

    // Toggle Settings
    const toggleBtn = content.querySelector(".toggle-btn") as HTMLElement;
    const cancelLink = settings.querySelector(".cancel-link") as HTMLElement;

    const toggleSettings = () => {
      const isActive = settings.classList.contains("active");
      if (isActive) {
        settings.classList.remove("active");
        toggleBtn.classList.remove("active");
        toggleBtn.style.transform = "rotate(0deg)";
      } else {
        settings.classList.add("active");
        toggleBtn.classList.add("active");
        toggleBtn.style.transform = "rotate(180deg)";
      }
    };

    toggleBtn.addEventListener("click", toggleSettings);
    cancelLink.addEventListener("click", toggleSettings);

    // Remove Item
    const removeLink = settings.querySelector(".remove-link");
    removeLink?.addEventListener("click", () => {
      if (confirm("Remove this menu item?")) {
        li.remove();
      }
    });

    // Live Review Update
    // When inputs vary, update the "visible" collapsed state title
    const labelInput = settings.querySelector(
      ".edit-label",
    ) as HTMLInputElement;
    const urlInput = settings.querySelector(".edit-url") as HTMLInputElement;
    const labelDisplay = content.querySelector(".item-label-display");
    const urlDisplay = content.querySelector(".item-url-display");

    labelInput.addEventListener("input", (e) => {
      if (labelDisplay)
        labelDisplay.textContent = (e.target as HTMLInputElement).value;
    });

    urlInput.addEventListener("input", (e) => {
      if (urlDisplay)
        urlDisplay.textContent = (e.target as HTMLInputElement).value;
    });

    // Sub-menu container
    const subMenu = document.createElement("ul");
    subMenu.className = "sortable-list sub-menu";

    // Render children if any
    if (children && children.length > 0) {
      children.forEach((child) => {
        subMenu.appendChild(
          createMenuItem(child.name, child.url, child.children),
        );
      });
    }

    li.appendChild(subMenu);

    // Make submenu sortable immediately
    initSortable(subMenu);

    return li;
  }

  function renderMenu(
    type: string,
    data: any[],
    container: HTMLElement | null,
  ) {
    if (!container) return;
    container.innerHTML = "";
    const ul = document.createElement("ul");
    ul.className = "sortable-list root-list";

    if (data && data.length > 0) {
      data.forEach((item) => {
        ul.appendChild(createMenuItem(item.name, item.url, item.children));
      });
    }

    container.appendChild(ul);
    initSortable(ul);
  }

  function initSortable(el: HTMLElement) {
    new Sortable(el, {
      group: "nested", // allow dragging between lists
      animation: 150,
      fallbackOnBody: true,
      swapThreshold: 0.65,
      handle: ".item-handle",
      ghostClass: "sortable-ghost",
      dragClass: "sortable-drag",
      onEnd: function (evt: any) {
        // Potential logic to handle drops
      },
    });
  }

  function setupSave() {
    saveBtn?.addEventListener("click", async () => {
      const btn = saveBtn as HTMLButtonElement;
      const originalText = btn.innerHTML;
      btn.innerHTML = "Saving...";
      btn.disabled = true;

      const headerData = serializeMenu(headerEditor!);
      const footerData = serializeMenu(footerEditor!);

      try {
        const res = await fetch("/api/admin/menu/", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ header: headerData, footer: footerData }),
        });

        if (res.ok) {
          alert("Menu saved successfully!");
        } else {
          alert("Failed to save menu.");
        }
      } catch (e) {
        console.error(e);
        alert("An error occurred.");
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    });
  }

  function serializeMenu(container: HTMLElement) {
    const rootUl = container.querySelector(".root-list");
    if (!rootUl) return [];
    return serializeList(rootUl as HTMLElement);
  }

  // Updated Serialize to read from Inputs
  function serializeList(ul: HTMLElement) {
    const items: any[] = [];
    Array.from(ul.children).forEach((li: any) => {
      // Only process direct children that are LI
      if (li.tagName === "LI") {
        // Read directly from the settings inputs
        const nameInput = li.querySelector(".edit-label") as HTMLInputElement;
        const urlInput = li.querySelector(".edit-url") as HTMLInputElement;

        const item = {
          name: nameInput ? nameInput.value : li.dataset.name,
          url: urlInput ? urlInput.value : li.dataset.url,
          children: [] as any[],
        };

        // Find the sub-menu UL within this LI
        const subMenu = li.querySelector(".sub-menu");
        if (subMenu && subMenu.children.length > 0) {
          // Check if it has actual list items
          // Filter out non-LI children just in case
          const hasChildren = Array.from(subMenu.children).some(
            (c: any) => c.tagName === "LI",
          );
          if (hasChildren) {
            item.children = serializeList(subMenu as HTMLElement);
          }
        }

        if (item.children.length === 0) {
          delete (item as any).children;
        }

        items.push(item);
      }
    });
    return items;
  }

  // Run
  init();
</script>
