---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
  ];
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Calculator Usage FAQ | How to Use Our Tools";
const pageDescription =
  "Learn how to use our financial calculators effectively with these frequently asked questions.";

const faqs = [
  {
    q: "Are your calculators free to use?",
    a: "Yes! All our financial calculators are completely free. No registration, no hidden fees, no limits on usage.",
  },
  {
    q: "Do you store my calculation data?",
    a: "No. All calculations happen in your browser. We don't store, track, or have access to any numbers you enter.",
  },
  {
    q: "How accurate are the calculations?",
    a: "Our calculators use standard financial formulas and are accurate for educational and planning purposes. For legally binding or official calculations, please consult a financial professional.",
  },
  {
    q: "Can I use the calculators on my phone?",
    a: "Yes! All our calculators are mobile-responsive and work on smartphones, tablets, and desktop computers.",
  },
  {
    q: "Why do my results differ from my bank's calculations?",
    a: "Banks may use different compounding methods, rounding rules, or include fees not reflected in our general calculations. Our tools provide estimates based on standard formulas.",
  },
  {
    q: "Can I embed your calculators on my website?",
    a: "Please contact us about embedding options. We may be able to provide widget versions for educational or non-commercial use.",
  },
  {
    q: "Which browser works best?",
    a: "Our calculators work in all modern browsers including Chrome, Firefox, Safari, and Edge. We recommend keeping your browser updated for the best experience.",
  },
  {
    q: "How do I report a bug or calculation error?",
    a: "Please use our contact form to report any issues. Include the calculator name, values you entered, and the result you received vs. what you expected.",
  },
  {
    q: "Do you offer calculators in other languages?",
    a: "Yes! We support English, Spanish, French, and German. Use the language selector in the navigation to switch.",
  },
  {
    q: "Can I suggest a new calculator?",
    a: "Absolutely! We're always looking to add useful tools. Use our contact form to submit your suggestions.",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-slate-500 mb-6">
      <a href={getLocalizedUrl("/faq/", locale)} class="hover:text-sky-600"
        >FAQ</a
      >
      <span class="mx-2">/</span>
      <span class="text-slate-800">Calculator Usage FAQ</span>
    </nav>

    <div class="mb-12">
      <h1 class="text-3xl font-bold text-slate-800 mb-4">
        Calculator Usage FAQ
      </h1>
      <p class="text-slate-600">
        Everything you need to know about using our financial calculators.
      </p>
    </div>

    <div class="space-y-4">
      {
        faqs.map((faq) => (
          <details class="bg-white rounded-xl border border-slate-200 group">
            <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-slate-50">
              <span class="font-medium text-slate-800 pr-4">{faq.q}</span>
              <svg
                class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-slate-600">{faq.a}</div>
          </details>
        ))
      }
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4">
      <a
        href={getLocalizedUrl("/basis-point-calculators/", locale)}
        class="p-4 bg-sky-50 rounded-lg border border-sky-200 hover:border-sky-400 transition-colors text-center"
      >
        <span class="text-2xl">📐</span>
        <div class="font-medium text-slate-800 mt-2">Basis Points</div>
      </a>
      <a
        href={getLocalizedUrl("/interest-rate-calculators/", locale)}
        class="p-4 bg-green-50 rounded-lg border border-green-200 hover:border-green-400 transition-colors text-center"
      >
        <span class="text-2xl">📈</span>
        <div class="font-medium text-slate-800 mt-2">Interest Rates</div>
      </a>
      <a
        href={getLocalizedUrl("/loan-calculators/", locale)}
        class="p-4 bg-purple-50 rounded-lg border border-purple-200 hover:border-purple-400 transition-colors text-center"
      >
        <span class="text-2xl">💰</span>
        <div class="font-medium text-slate-800 mt-2">Loans</div>
      </a>
    </div>
  </main>
</Layout>
