---
import CalculatorLayout, {
  getStaticPaths as getStaticPathsCalc,
} from "@theme/layouts/CalculatorLayout.astro";
import { getTranslations, type Locale } from "@theme/i18n/utils";

export const getStaticPaths = getStaticPathsCalc;

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = t.bp_to_pct_title || "Basis Points to Percentage Calculator";
const pageDescription =
  t.bp_to_pct_desc ||
  "Convert basis points (bps) to percentage (%) instantly. Free online calculator with formula and examples.";

const relatedCalculators = [
  {
    name: t.pct_to_bp_title || "Percentage to Basis Points",
    url: "/basis-point-calculators/percentage-to-basis-point/",
  },
  {
    name: t.bp_change_title || "Basis Point Change Calculator",
    url: "/basis-point-calculators/basis-point-change-calculator/",
  },
  {
    name: t.bp_diff_title || "Basis Point Difference Calculator",
    url: "/basis-point-calculators/basis-point-difference-calculator/",
  },
];

const faqs = t.bp_to_pct_faqs || [
  {
    question: "How do I convert basis points to percentage?",
    answer:
      "Divide the basis points by 100. For example, 50 basis points = 50 ÷ 100 = 0.50%",
  },
  {
    question: "What is 1 basis point in percentage?",
    answer:
      "1 basis point equals 0.01%. Therefore, 100 basis points equals 1%.",
  },
  {
    question: "Why are basis points used instead of percentages?",
    answer:
      "Basis points provide precision and clarity when discussing small changes in interest rates, yields, or fees. They avoid confusion between 'percent' and 'percentage point' changes.",
  },
];
---

<CalculatorLayout
  title={pageTitle}
  description={pageDescription}
  calculatorType="conversion"
  relatedCalculators={relatedCalculators}
  faqs={faqs}
>
  <section class="bg-white rounded-2xl shadow-lg p-6">
    <h1 class="text-2xl font-semibold text-slate-800">{pageTitle}</h1>
    <p class="text-sm text-slate-500 mt-1">
      {
        t.bp_to_pct_subtitle ||
          "Convert basis points to percentage quickly and accurately."
      }
    </p>

    <div class="mt-6 space-y-5">
      <!-- Input: Basis Points -->
      <div>
        <label for="bps-input" class="block text-sm mb-2 text-slate-600">
          {t.enter_basis_points || "Enter Basis Points"}
        </label>
        <div class="relative">
          <input
            id="bps-input"
            type="number"
            inputmode="decimal"
            class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pr-14 focus:outline-none focus:ring-2 focus:ring-sky-200"
            placeholder="100"
          />
          <span
            class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"
            >bps</span
          >
        </div>
      </div>

      <!-- Output: Percentage -->
      <div>
        <label for="pct-output" class="block text-sm mb-2 text-slate-600">
          {t.result_percentage || "Result in Percentage"}
        </label>
        <div class="relative">
          <input
            id="pct-output"
            type="text"
            class="w-full bg-slate-50 border border-slate-200 rounded-lg py-3 px-4 pr-10 text-slate-700 font-medium"
            placeholder="1.00"
            readonly
          />
          <span
            class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"
            >%</span
          >
        </div>
      </div>

      <!-- Result Explanation -->
      <div
        id="result-explanation"
        class="hidden p-4 bg-sky-50 rounded-lg border border-sky-100"
      >
        <p class="text-slate-700 text-sm" id="result-text"></p>
      </div>
    </div>
  </section>

  <!-- Formula Section -->
  <section class="bg-white rounded-2xl shadow-lg p-6 mt-6">
    <h2 class="text-xl font-semibold text-slate-800">
      {t.formula_title || "Formula"}
    </h2>
    <div class="mt-4 p-4 bg-slate-50 rounded-lg">
      <code class="text-lg text-slate-800">
        {t.bp_to_pct_formula || "Percentage = Basis Points ÷ 100"}
      </code>
    </div>
    <div class="mt-4 text-slate-600 text-sm space-y-2">
      <p>
        {
          t.bp_to_pct_formula_explain ||
            "Since 1 basis point equals 0.01%, simply divide the number of basis points by 100 to get the percentage value."
        }
      </p>
    </div>
  </section>

  <!-- Examples Section -->
  <section class="bg-white rounded-2xl shadow-lg p-6 mt-6">
    <h2 class="text-xl font-semibold text-slate-800">
      {t.examples_title || "Examples"}
    </h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="text-left py-2 px-3 font-medium text-slate-600"
              >{t.basis_points || "Basis Points"}</th
            >
            <th class="text-left py-2 px-3 font-medium text-slate-600"
              >{t.percent || "Percentage"}</th
            >
            <th class="text-left py-2 px-3 font-medium text-slate-600"
              >{t.decimal_value || "Decimal"}</th
            >
          </tr>
        </thead>
        <tbody class="text-slate-700">
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">1 bps</td><td class="py-2 px-3">0.01%</td><td
              class="py-2 px-3">0.0001</td
            ></tr
          >
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">5 bps</td><td class="py-2 px-3">0.05%</td><td
              class="py-2 px-3">0.0005</td
            ></tr
          >
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">10 bps</td><td class="py-2 px-3">0.10%</td
            ><td class="py-2 px-3">0.001</td></tr
          >
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">25 bps</td><td class="py-2 px-3">0.25%</td
            ><td class="py-2 px-3">0.0025</td></tr
          >
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">50 bps</td><td class="py-2 px-3">0.50%</td
            ><td class="py-2 px-3">0.005</td></tr
          >
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">75 bps</td><td class="py-2 px-3">0.75%</td
            ><td class="py-2 px-3">0.0075</td></tr
          >
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">100 bps</td><td class="py-2 px-3">1.00%</td
            ><td class="py-2 px-3">0.01</td></tr
          >
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">150 bps</td><td class="py-2 px-3">1.50%</td
            ><td class="py-2 px-3">0.015</td></tr
          >
          <tr class="border-b border-slate-100"
            ><td class="py-2 px-3">200 bps</td><td class="py-2 px-3">2.00%</td
            ><td class="py-2 px-3">0.02</td></tr
          >
          <tr
            ><td class="py-2 px-3">500 bps</td><td class="py-2 px-3">5.00%</td
            ><td class="py-2 px-3">0.05</td></tr
          >
        </tbody>
      </table>
    </div>
  </section>

  <!-- How to Use Section -->
  <section class="bg-white rounded-2xl shadow-lg p-6 mt-6">
    <h2 class="text-xl font-semibold text-slate-800">
      {t.how_to_use_title || "How to Use This Calculator"}
    </h2>
    <div class="mt-4 text-slate-600 text-sm space-y-3">
      <ol class="list-decimal pl-5 space-y-2">
        <li>
          {
            t.bp_to_pct_step1 ||
              "Enter the number of basis points in the input field above."
          }
        </li>
        <li>
          {
            t.bp_to_pct_step2 ||
              "The percentage value will be calculated and displayed instantly."
          }
        </li>
        <li>
          {
            t.bp_to_pct_step3 ||
              "Use the result for your financial calculations, rate comparisons, or yield analysis."
          }
        </li>
      </ol>
    </div>
  </section>

  <script>
    const bpsInput = document.getElementById("bps-input") as HTMLInputElement;
    const pctOutput = document.getElementById("pct-output") as HTMLInputElement;
    const resultExplanation = document.getElementById("result-explanation");
    const resultText = document.getElementById("result-text");

    function calculate() {
      const bps = parseFloat(bpsInput.value);

      if (isNaN(bps)) {
        pctOutput.value = "";
        resultExplanation?.classList.add("hidden");
        return;
      }

      const percentage = bps / 100;
      pctOutput.value = percentage.toFixed(4).replace(/\.?0+$/, "");

      // Show explanation
      if (resultExplanation && resultText) {
        resultExplanation.classList.remove("hidden");
        resultText.innerHTML = `<strong>${bps} basis points</strong> = <strong>${percentage.toFixed(4).replace(/\.?0+$/, "")}%</strong> (calculated as ${bps} ÷ 100 = ${percentage.toFixed(4).replace(/\.?0+$/, "")})`;
      }
    }

    bpsInput.addEventListener("input", calculate);

    // Initialize with default value
    bpsInput.value = "100";
    calculate();
  </script>
</CalculatorLayout>
