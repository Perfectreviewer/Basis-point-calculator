---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
  ];
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "About Us | BasisPointCalculator.com";
const pageDescription =
  "Learn about our mission to make financial education and calculations accessible to everyone.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-slate-500 mb-6">
      <a href={getLocalizedUrl("/about/", locale)} class="hover:text-sky-600"
        >About</a
      >
      <span class="mx-2">/</span>
      <span class="text-slate-800">About Us</span>
    </nav>

    <article class="prose prose-slate max-w-none">
      <h1>About BasisPointCalculator.com</h1>

      <p class="lead text-xl text-slate-600">
        We believe everyone deserves access to clear, accurate financial
        calculations without needing a finance degree.
      </p>

      <h2>Our Mission</h2>
      <p>
        BasisPointCalculator.com was created to demystify financial calculations and make
        them accessible to everyone. Whether you're a first-time homebuyer
        trying to understand mortgage payments, an investor analyzing bond
        yields, or simply curious about what a basis point is, we're here to
        help.
      </p>

      <h2>What We Offer</h2>
      <div class="not-prose grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
        <div class="bg-sky-50 rounded-lg p-4">
          <h3 class="font-semibold text-slate-800 mb-2">📐 Free Calculators</h3>
          <p class="text-sm text-slate-600">
            Accurate, easy-to-use tools for basis points, interest rates, loans,
            bonds, and investments.
          </p>
        </div>
        <div class="bg-green-50 rounded-lg p-4">
          <h3 class="font-semibold text-slate-800 mb-2">
            📚 Educational Content
          </h3>
          <p class="text-sm text-slate-600">
            Guides and articles that explain financial concepts in plain
            language.
          </p>
        </div>
        <div class="bg-purple-50 rounded-lg p-4">
          <h3 class="font-semibold text-slate-800 mb-2">
            🌍 Multi-Language Support
          </h3>
          <p class="text-sm text-slate-600">
            Available in English, Spanish, French, and German to serve a global
            audience.
          </p>
        </div>
        <div class="bg-orange-50 rounded-lg p-4">
          <h3 class="font-semibold text-slate-800 mb-2">🔒 Privacy First</h3>
          <p class="text-sm text-slate-600">
            All calculations happen in your browser. We don't store or track
            your data.
          </p>
        </div>
      </div>

      <h2>Our Commitment</h2>
      <p>We are committed to:</p>
      <ul>
        <li>
          <strong>Accuracy:</strong> Using industry-standard formulas verified by
          financial professionals
        </li>
        <li>
          <strong>Clarity:</strong> Explaining not just the "what" but the "why" behind
          every calculation
        </li>
        <li>
          <strong>Accessibility:</strong> Keeping all tools free and available to
          everyone
        </li>
        <li>
          <strong>Privacy:</strong> Never collecting or selling your personal data
        </li>
      </ul>

      <h2>Join Our Community</h2>
      <p>
        Have feedback, suggestions, or questions? We'd love to hear from you.
        Our calculators are constantly improving based on user input.
      </p>
    </article>

    <div class="mt-12 flex gap-4">
      <a
        href={getLocalizedUrl("/about/contact/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 text-white rounded-lg hover:bg-sky-700 transition-colors text-sm"
      >
        Contact Us
      </a>
      <a
        href={getLocalizedUrl("/about/editorial-policy/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-lg hover:border-sky-400 transition-colors text-sm"
      >
        Editorial Policy
      </a>
    </div>
  </main>
</Layout>
