---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
  ];
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Editorial Policy | BasisPointCalculator.com";
const pageDescription =
  "Learn how BasisPointCalculator.com creates, reviews, and maintains accurate financial content and calculator tools.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-slate-500 mb-6">
      <a href={getLocalizedUrl("/about-us/", locale)} class="hover:text-sky-600"
        >About</a
      >
      <span class="mx-2">/</span>
      <span class="text-slate-800">Editorial Policy</span>
    </nav>

    <article class="prose prose-slate max-w-none">
      <h1>Editorial Policy</h1>
      <p class="text-sm text-slate-500">Last updated: April 2025</p>

      <p>
        At BasisPointCalculator.com, our goal is to provide accurate, unbiased,
        and easy-to-understand financial tools and content. This editorial policy
        explains how we create, review, and maintain the calculators, guides, and
        articles on our site.
      </p>

      <h2>Our Commitment to Accuracy</h2>
      <p>
        Every calculator and piece of content published on BasisPointCalculator.com
        is built on verified financial formulas and industry-standard definitions.
        We cross-reference our calculations against authoritative sources —
        including central bank publications, academic finance literature, and
        established financial data providers — before publishing.
      </p>
      <p>
        If you believe any figure or formula on our site is incorrect, please
        <a href={getLocalizedUrl("/contact-us/", locale)}>contact us</a>. We
        investigate all reported errors and publish corrections promptly.
      </p>

      <h2>Content Creation Process</h2>
      <p>Our content goes through the following stages before it is published:</p>
      <ol>
        <li>
          <strong>Research</strong> — topics are chosen based on genuine user need
          and verified against primary financial sources.
        </li>
        <li>
          <strong>Drafting</strong> — content is written in plain language to make
          complex financial concepts accessible to a general audience.
        </li>
        <li>
          <strong>Formula verification</strong> — all calculator logic and numerical
          examples are independently checked for correctness.
        </li>
        <li>
          <strong>Review</strong> — a second team member reviews the draft for
          accuracy, clarity, and completeness before publication.
        </li>
        <li>
          <strong>Publishing</strong> — once approved, content is published with a
          clear date stamp.
        </li>
      </ol>

      <h2>Updates and Corrections</h2>
      <p>
        Financial rules, tax rates, and regulatory figures change over time. We
        review our calculators and guides periodically and update them when
        underlying data changes. Significant updates are reflected in a revised
        "Last updated" date on the relevant page.
      </p>
      <p>
        Corrections to factual errors are made as quickly as possible. We do not
        silently alter content — material corrections are noted on the affected
        page.
      </p>

      <h2>Sources and References</h2>
      <p>
        Where possible, our guides cite or link to primary sources such as:
      </p>
      <ul>
        <li>Central bank publications (Federal Reserve, ECB, Bank of England)</li>
        <li>Peer-reviewed academic finance research</li>
        <li>Official government financial and tax authority publications</li>
        <li>Established financial textbooks and standards bodies</li>
      </ul>
      <p>
        We do not accept payment to feature, link to, or endorse any external
        product, service, or website.
      </p>

      <h2>Editorial Independence</h2>
      <p>
        BasisPointCalculator.com is an independent website. Our content is not
        influenced by advertisers, sponsors, or commercial partners. Calculator
        results and guide conclusions are based solely on the underlying
        mathematics and publicly available information.
      </p>
      <p>
        We display third-party advertisements on some pages. Advertisers have no
        editorial input and no ability to influence the calculators or written
        content on this site.
      </p>

      <h2>Not Financial Advice</h2>
      <div class="not-prose bg-amber-50 border-l-4 border-amber-400 p-4 my-4">
        <p class="font-medium text-amber-800">Important</p>
        <p class="text-amber-700 mt-2">
          The calculators and content on this site are for educational and
          informational purposes only. They do not constitute financial, investment,
          tax, or legal advice. Always consult a qualified professional before
          making financial decisions.
        </p>
      </div>

      <h2>Feedback</h2>
      <p>
        We welcome feedback on any content or calculator. If you spot an error,
        have a question, or want to suggest a topic, please use our
        <a href={getLocalizedUrl("/contact-us/", locale)}>contact page</a>.
      </p>
    </article>

    <div class="mt-12 flex gap-4">
      <a
        href={getLocalizedUrl("/legal/disclaimer/", locale)}
        class="text-sm text-sky-600 hover:underline">Disclaimer</a
      >
      <a
        href={getLocalizedUrl("/legal/privacy-policy/", locale)}
        class="text-sm text-sky-600 hover:underline">Privacy Policy</a
      >
      <a
        href={getLocalizedUrl("/legal/terms-and-conditions/", locale)}
        class="text-sm text-sky-600 hover:underline">Terms & Conditions</a
      >
    </div>
  </main>
</Layout>
