---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
  ];
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Contact Us | BasisPointCalculator.com";
const pageDescription =
  "Get in touch with the BasisPointCalculator.com team for questions, feedback, or support.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-slate-500 mb-6">
      <a href={getLocalizedUrl("/about/", locale)} class="hover:text-sky-600"
        >About</a
      >
      <span class="mx-2">/</span>
      <span class="text-slate-800">Contact</span>
    </nav>

    <div class="mb-12">
      <h1 class="text-3xl font-bold text-slate-800 mb-4">Contact Us</h1>
      <p class="text-slate-600">
        We'd love to hear from you. Choose the best way to reach us below.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-3xl mb-4">📧</div>
        <h2 class="font-semibold text-slate-800 mb-2">General Inquiries</h2>
        <p class="text-slate-600 text-sm mb-4">
          Questions, feedback, or suggestions about our calculators or content.
        </p>
        <a
          href="mailto:hello@basispoint.org"
          class="text-sky-600 hover:underline">hello@basispoint.org</a
        >
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-3xl mb-4">🐛</div>
        <h2 class="font-semibold text-slate-800 mb-2">Report an Issue</h2>
        <p class="text-slate-600 text-sm mb-4">
          Found a bug or calculation error? Let us know so we can fix it.
        </p>
        <a
          href="mailto:support@basispoint.org"
          class="text-sky-600 hover:underline">support@basispoint.org</a
        >
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-3xl mb-4">🤝</div>
        <h2 class="font-semibold text-slate-800 mb-2">Partnerships</h2>
        <p class="text-slate-600 text-sm mb-4">
          Interested in collaborating or embedding our calculators?
        </p>
        <a
          href="mailto:partners@basispoint.org"
          class="text-sky-600 hover:underline">partners@basispoint.org</a
        >
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-3xl mb-4">📰</div>
        <h2 class="font-semibold text-slate-800 mb-2">Press & Media</h2>
        <p class="text-slate-600 text-sm mb-4">
          Media inquiries and interview requests.
        </p>
        <a
          href="mailto:press@basispoint.org"
          class="text-sky-600 hover:underline">press@basispoint.org</a
        >
      </div>
    </div>

    <section class="bg-slate-50 rounded-xl p-6">
      <h2 class="font-semibold text-slate-800 mb-4">
        Frequently Asked Questions
      </h2>
      <p class="text-slate-600 text-sm mb-4">
        Before reaching out, you might find your answer in our FAQ section.
      </p>
      <a
        href={getLocalizedUrl("/faq/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-lg hover:border-sky-400 transition-colors text-sm"
      >
        Browse FAQ →
      </a>
    </section>

    <section class="mt-8 text-sm text-slate-500">
      <p>
        <strong>Response Time:</strong> We typically respond within 1-2 business days.
      </p>
    </section>
  </main>
</Layout>
