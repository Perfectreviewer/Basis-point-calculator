---
import CalculatorLayout, {
  getStaticPaths as getStaticPathsCalc,
} from "@theme/layouts/CalculatorLayout.astro";
import { getTranslations, type Locale } from "@theme/i18n/utils";

export const getStaticPaths = getStaticPathsCalc;

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Future Value Calculator";
const pageDescription =
  "Calculate the future value of an investment based on present value, interest rate, and time period.";

const relatedCalculators = [
  {
    name: "Present Value Calculator",
    url: "/investment-calculators/present-value-calculator/",
  },
  { name: "ROI Calculator", url: "/investment-calculators/roi-calculator/" },
  {
    name: "Compound Interest Calculator",
    url: "/interest-rate-calculators/compound-interest-calculator/",
  },
];

const faqs = [
  {
    question: "What is future value?",
    answer:
      "Future value is what an investment will be worth at a specific point in the future, given a rate of return.",
  },
  {
    question: "How does compounding affect future value?",
    answer:
      "More frequent compounding results in higher future values because interest earns interest more often.",
  },
  {
    question: "Why is future value important?",
    answer:
      "It helps with retirement planning, comparing investments, and understanding the time value of money.",
  },
];
---

<CalculatorLayout
  title={pageTitle}
  description={pageDescription}
  calculatorType="investment"
  relatedCalculators={relatedCalculators}
  faqs={faqs}
>
  <section class="bg-white rounded-2xl shadow-lg p-6">
    <h1 class="text-2xl font-semibold text-slate-800">{pageTitle}</h1>
    <p class="text-sm text-slate-500 mt-1">
      See how your money will grow over time.
    </p>

    <div class="mt-6 space-y-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="present-value" class="block text-sm mb-2 text-slate-600"
            >Present Value (Initial Amount)</label
          >
          <div class="relative">
            <span
              class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
              >$</span
            >
            <input
              id="present-value"
              type="number"
              step="1000"
              class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pl-8 focus:outline-none focus:ring-2 focus:ring-sky-200"
              placeholder="10000"
            />
          </div>
        </div>
        <div>
          <label
            for="monthly-contribution"
            class="block text-sm mb-2 text-slate-600"
            >Monthly Contribution</label
          >
          <div class="relative">
            <span
              class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
              >$</span
            >
            <input
              id="monthly-contribution"
              type="number"
              step="50"
              class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pl-8 focus:outline-none focus:ring-2 focus:ring-sky-200"
              placeholder="500"
            />
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="interest-rate" class="block text-sm mb-2 text-slate-600"
            >Annual Interest Rate</label
          >
          <div class="relative">
            <input
              id="interest-rate"
              type="number"
              step="0.1"
              class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pr-10 focus:outline-none focus:ring-2 focus:ring-sky-200"
              placeholder="7"
            />
            <span
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"
              >%</span
            >
          </div>
        </div>
        <div>
          <label for="time-years" class="block text-sm mb-2 text-slate-600"
            >Time Period (Years)</label
          >
          <input
            id="time-years"
            type="number"
            step="1"
            class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-sky-200"
            placeholder="20"
          />
        </div>
        <div>
          <label
            for="compound-frequency"
            class="block text-sm mb-2 text-slate-600">Compounding</label
          >
          <select
            id="compound-frequency"
            class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4"
          >
            <option value="1">Annually</option>
            <option value="4">Quarterly</option>
            <option value="12" selected>Monthly</option>
            <option value="365">Daily</option>
          </select>
        </div>
      </div>

      <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl p-6">
        <div class="text-center">
          <span class="text-sm text-slate-600">Future Value</span>
          <div id="future-value" class="text-4xl font-bold text-green-600 mt-1">
            $0
          </div>
        </div>
        <div class="grid grid-cols-3 gap-4 mt-4 text-center">
          <div class="bg-white rounded-lg p-3">
            <div class="text-xs text-slate-500">Initial Investment</div>
            <div id="initial-display" class="font-semibold text-slate-800">
              $0
            </div>
          </div>
          <div class="bg-white rounded-lg p-3">
            <div class="text-xs text-slate-500">Total Contributions</div>
            <div id="total-contributions" class="font-semibold text-slate-800">
              $0
            </div>
          </div>
          <div class="bg-white rounded-lg p-3">
            <div class="text-xs text-slate-500">Interest Earned</div>
            <div id="interest-earned" class="font-semibold text-green-600">
              $0
            </div>
          </div>
        </div>
      </div>

      <!-- Visual breakdown bar -->
      <div>
        <div class="flex justify-between text-sm text-slate-600 mb-2">
          <span>Principal</span>
          <span>Interest</span>
        </div>
        <div class="h-4 rounded-full overflow-hidden flex">
          <div
            id="bar-principal"
            class="bg-sky-400 h-full transition-all"
            style="width: 50%"
          >
          </div>
          <div
            id="bar-interest"
            class="bg-green-400 h-full transition-all"
            style="width: 50%"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white rounded-2xl shadow-lg p-6 mt-6">
    <h2 class="text-xl font-semibold text-slate-800">Future Value Formulas</h2>
    <div class="mt-4 space-y-4 text-sm">
      <div class="p-4 bg-slate-50 rounded-lg">
        <h3 class="font-medium text-slate-700 mb-2">Lump Sum</h3>
        <code class="text-slate-800">FV = PV × (1 + r/n)^(n×t)</code>
      </div>
      <div class="p-4 bg-slate-50 rounded-lg">
        <h3 class="font-medium text-slate-700 mb-2">
          With Periodic Contributions
        </h3>
        <code class="text-slate-800"
          >FV = PV × (1 + r/n)^(n×t) + PMT × [((1 + r/n)^(n×t) - 1) / (r/n)]</code
        >
      </div>
    </div>
  </section>

  <script>
    const presentValue = document.getElementById(
      "present-value",
    ) as HTMLInputElement;
    const monthlyContribution = document.getElementById(
      "monthly-contribution",
    ) as HTMLInputElement;
    const interestRate = document.getElementById(
      "interest-rate",
    ) as HTMLInputElement;
    const timeYears = document.getElementById("time-years") as HTMLInputElement;
    const compoundFrequency = document.getElementById(
      "compound-frequency",
    ) as HTMLSelectElement;

    const futureValueEl = document.getElementById("future-value");
    const initialDisplayEl = document.getElementById("initial-display");
    const totalContributionsEl = document.getElementById("total-contributions");
    const interestEarnedEl = document.getElementById("interest-earned");
    const barPrincipal = document.getElementById("bar-principal");
    const barInterest = document.getElementById("bar-interest");

    function formatCurrency(v: number) {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      }).format(v);
    }

    function calculate() {
      const PV = parseFloat(presentValue.value) || 0;
      const PMT = parseFloat(monthlyContribution.value) || 0;
      const rate = parseFloat(interestRate.value) || 0;
      const years = parseFloat(timeYears.value) || 0;
      const n = parseInt(compoundFrequency.value) || 12;

      const r = rate / 100;
      const periodsPerYear = n;
      const totalPeriods = years * periodsPerYear;
      const ratePerPeriod = r / periodsPerYear;

      // Adjust PMT based on contribution frequency vs compound frequency
      const monthlyRate = r / 12;
      let totalContribs = PMT * 12 * years;

      // FV of lump sum
      const fvLumpSum = PV * Math.pow(1 + ratePerPeriod, totalPeriods);

      // FV of annuity (assuming monthly contributions with monthly compounding simplified)
      let fvAnnuity = 0;
      if (PMT > 0 && monthlyRate > 0) {
        const monthlyPeriods = years * 12;
        fvAnnuity =
          PMT * ((Math.pow(1 + monthlyRate, monthlyPeriods) - 1) / monthlyRate);
      }

      const fv = fvLumpSum + fvAnnuity;
      const totalInvested = PV + totalContribs;
      const interestEarned = fv - totalInvested;

      if (futureValueEl) futureValueEl.textContent = formatCurrency(fv);
      if (initialDisplayEl) initialDisplayEl.textContent = formatCurrency(PV);
      if (totalContributionsEl)
        totalContributionsEl.textContent = formatCurrency(totalContribs);
      if (interestEarnedEl)
        interestEarnedEl.textContent = formatCurrency(interestEarned);

      if (fv > 0 && barPrincipal && barInterest) {
        const pctPrincipal = (totalInvested / fv) * 100;
        const pctInterest = (interestEarned / fv) * 100;
        barPrincipal.style.width = `${pctPrincipal}%`;
        barInterest.style.width = `${pctInterest}%`;
      }
    }

    [presentValue, monthlyContribution, interestRate, timeYears].forEach((el) =>
      el.addEventListener("input", calculate),
    );
    compoundFrequency.addEventListener("change", calculate);

    presentValue.value = "10000";
    monthlyContribution.value = "500";
    interestRate.value = "7";
    timeYears.value = "20";
    calculate();
  </script>
</CalculatorLayout>
