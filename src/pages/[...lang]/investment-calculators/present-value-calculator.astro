---
import CalculatorLayout, {
  getStaticPaths as getStaticPathsCalc,
} from "@theme/layouts/CalculatorLayout.astro";
import { getTranslations, type Locale } from "@theme/i18n/utils";

export const getStaticPaths = getStaticPathsCalc;

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Present Value Calculator";
const pageDescription =
  "Calculate the present value of a future amount based on discount rate and time period.";

const relatedCalculators = [
  {
    name: "Future Value Calculator",
    url: "/investment-calculators/future-value-calculator/",
  },
  { name: "ROI Calculator", url: "/investment-calculators/roi-calculator/" },
  {
    name: "Inflation Calculator",
    url: "/investment-calculators/inflation-calculator/",
  },
];

const faqs = [
  {
    question: "What is present value?",
    answer:
      "Present value is today's value of a future sum of money, discounted at a specific rate of return.",
  },
  {
    question: "Why is present value important?",
    answer:
      "It helps compare investments with different timing, evaluate opportunities, and understand the time value of money.",
  },
  {
    question: "What discount rate should I use?",
    answer:
      "Use your required rate of return, opportunity cost, or inflation rate depending on the analysis.",
  },
];
---

<CalculatorLayout
  title={pageTitle}
  description={pageDescription}
  calculatorType="investment"
  relatedCalculators={relatedCalculators}
  faqs={faqs}
>
  <section class="bg-white rounded-2xl shadow-lg p-6">
    <h1 class="text-2xl font-semibold text-slate-800">{pageTitle}</h1>
    <p class="text-sm text-slate-500 mt-1">
      Find out what a future amount is worth today.
    </p>

    <div class="mt-6 space-y-5">
      <div>
        <label for="future-value" class="block text-sm mb-2 text-slate-600"
          >Future Value</label
        >
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
            >$</span
          >
          <input
            id="future-value"
            type="number"
            step="1000"
            class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pl-8 focus:outline-none focus:ring-2 focus:ring-sky-200"
            placeholder="100000"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="discount-rate" class="block text-sm mb-2 text-slate-600"
            >Discount Rate / Return</label
          >
          <div class="relative">
            <input
              id="discount-rate"
              type="number"
              step="0.1"
              class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pr-10 focus:outline-none focus:ring-2 focus:ring-sky-200"
              placeholder="6"
            />
            <span
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"
              >%</span
            >
          </div>
        </div>
        <div>
          <label for="time-years" class="block text-sm mb-2 text-slate-600"
            >Time Period (Years)</label
          >
          <input
            id="time-years"
            type="number"
            step="1"
            class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-sky-200"
            placeholder="10"
          />
        </div>
        <div>
          <label
            for="compound-frequency"
            class="block text-sm mb-2 text-slate-600">Compounding</label
          >
          <select
            id="compound-frequency"
            class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4"
          >
            <option value="1">Annually</option>
            <option value="4">Quarterly</option>
            <option value="12" selected>Monthly</option>
            <option value="365">Daily</option>
          </select>
        </div>
      </div>

      <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl p-6">
        <div class="text-center">
          <span class="text-sm text-slate-600">Present Value</span>
          <div
            id="present-value"
            class="text-4xl font-bold text-purple-600 mt-1"
          >
            $0
          </div>
          <p id="interpretation" class="text-sm text-slate-600 mt-2"></p>
        </div>
        <div class="grid grid-cols-2 gap-4 mt-4 text-center">
          <div class="bg-white rounded-lg p-3">
            <div class="text-xs text-slate-500">Interest/Growth</div>
            <div id="interest-amount" class="font-semibold text-green-600">
              $0
            </div>
          </div>
          <div class="bg-white rounded-lg p-3">
            <div class="text-xs text-slate-500">Discount Factor</div>
            <div id="discount-factor" class="font-semibold text-slate-800">
              0.000
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white rounded-2xl shadow-lg p-6 mt-6">
    <h2 class="text-xl font-semibold text-slate-800">Present Value Formula</h2>
    <div class="mt-4 p-4 bg-slate-50 rounded-lg">
      <code class="text-slate-800">PV = FV / (1 + r/n)^(n×t)</code>
    </div>
    <div class="mt-4 text-slate-600 text-sm space-y-2">
      <p><strong>PV</strong> = Present value (what you need today)</p>
      <p><strong>FV</strong> = Future value (target amount)</p>
      <p><strong>r</strong> = Annual discount rate</p>
      <p><strong>n</strong> = Compounding periods per year</p>
      <p><strong>t</strong> = Time in years</p>
    </div>
  </section>

  <section class="bg-white rounded-2xl shadow-lg p-6 mt-6">
    <h2 class="text-xl font-semibold text-slate-800">Use Cases</h2>
    <div
      class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-600"
    >
      <div class="p-4 bg-sky-50 rounded-lg">
        <h3 class="font-medium text-slate-700 mb-1">Retirement Planning</h3>
        <p>How much do you need to invest today to have $1M in 30 years?</p>
      </div>
      <div class="p-4 bg-green-50 rounded-lg">
        <h3 class="font-medium text-slate-700 mb-1">Investment Comparison</h3>
        <p>Compare the true value of cash flows at different times.</p>
      </div>
      <div class="p-4 bg-purple-50 rounded-lg">
        <h3 class="font-medium text-slate-700 mb-1">Project Valuation</h3>
        <p>Evaluate future returns in today's dollars.</p>
      </div>
      <div class="p-4 bg-orange-50 rounded-lg">
        <h3 class="font-medium text-slate-700 mb-1">Lottery/Settlement</h3>
        <p>Choose between lump sum now vs payments over time.</p>
      </div>
    </div>
  </section>

  <script>
    const futureValue = document.getElementById(
      "future-value",
    ) as HTMLInputElement;
    const discountRate = document.getElementById(
      "discount-rate",
    ) as HTMLInputElement;
    const timeYears = document.getElementById("time-years") as HTMLInputElement;
    const compoundFrequency = document.getElementById(
      "compound-frequency",
    ) as HTMLSelectElement;

    const presentValueEl = document.getElementById("present-value");
    const interpretationEl = document.getElementById("interpretation");
    const interestAmountEl = document.getElementById("interest-amount");
    const discountFactorEl = document.getElementById("discount-factor");

    function formatCurrency(v: number) {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      }).format(v);
    }

    function calculate() {
      const FV = parseFloat(futureValue.value) || 0;
      const rate = parseFloat(discountRate.value) || 0;
      const years = parseFloat(timeYears.value) || 0;
      const n = parseInt(compoundFrequency.value) || 12;

      const r = rate / 100;
      const totalPeriods = years * n;
      const ratePerPeriod = r / n;

      const discountFactor = Math.pow(1 + ratePerPeriod, -totalPeriods);
      const PV = FV * discountFactor;
      const interest = FV - PV;

      if (presentValueEl) presentValueEl.textContent = formatCurrency(PV);
      if (interestAmountEl)
        interestAmountEl.textContent = formatCurrency(interest);
      if (discountFactorEl)
        discountFactorEl.textContent = discountFactor.toFixed(4);

      if (interpretationEl) {
        interpretationEl.textContent = `Invest ${formatCurrency(PV)} today at ${rate}% to have ${formatCurrency(FV)} in ${years} years.`;
      }
    }

    [futureValue, discountRate, timeYears].forEach((el) =>
      el.addEventListener("input", calculate),
    );
    compoundFrequency.addEventListener("change", calculate);

    futureValue.value = "100000";
    discountRate.value = "6";
    timeYears.value = "10";
    calculate();
  </script>
</CalculatorLayout>
