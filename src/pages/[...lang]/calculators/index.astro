---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
  ];
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Free Financial Calculators | BasisPointCalculator.com";
const pageDescription =
  "25+ free financial calculators for basis points, interest rates, loans, bonds, and investments. Accurate, instant results — no signup required.";

const categories = [
  {
    name: "Basis Point Calculators",
    description:
      "Convert between basis points and percentages, calculate spreads, and explore real-world bps examples.",
    url: "/basis-point-calculators/",
    icon: "📐",
    color: "sky",
    count: 7,
    tools: [
      "BPS to Percentage",
      "Percentage to BPS",
      "BPS Change Calculator",
      "BPS Difference",
    ],
  },
  {
    name: "Interest Rate Calculators",
    description:
      "Calculate APR, APY, compound interest, simple interest, and compare rates side-by-side.",
    url: "/interest-rate-calculators/",
    icon: "📊",
    color: "green",
    count: 5,
    tools: [
      "APR Calculator",
      "APY Calculator",
      "Compound Interest",
      "Simple Interest",
    ],
  },
  {
    name: "Loan Calculators",
    description:
      "Estimate monthly payments, build amortization schedules, and compare mortgage, auto, and personal loans.",
    url: "/loan-calculators/",
    icon: "💰",
    color: "orange",
    count: 5,
    tools: ["Loan Payment", "Mortgage Calculator", "Auto Loan", "Amortization"],
  },
  {
    name: "Bond Calculators",
    description:
      "Price bonds, calculate yield to maturity, measure duration, and analyze bond yields.",
    url: "/bond-calculators/",
    icon: "📈",
    color: "purple",
    count: 4,
    tools: ["Bond Price", "Yield to Maturity", "Bond Duration", "Bond Yield"],
  },
  {
    name: "Investment Calculators",
    description:
      "Project future value, discount to present value, calculate ROI, and measure inflation's impact.",
    url: "/investment-calculators/",
    icon: "🚀",
    color: "indigo",
    count: 4,
    tools: [
      "Future Value",
      "Present Value",
      "ROI Calculator",
      "Inflation Calculator",
    ],
  },
];

const colorClasses: Record<string, { card: string; badge: string }> = {
  sky: {
    card: "bg-sky-50 border-sky-200 hover:border-sky-400 hover:shadow-sky-100",
    badge: "bg-sky-100 text-sky-700",
  },
  green: {
    card: "bg-green-50 border-green-200 hover:border-green-400 hover:shadow-green-100",
    badge: "bg-green-100 text-green-700",
  },
  orange: {
    card: "bg-orange-50 border-orange-200 hover:border-orange-400 hover:shadow-orange-100",
    badge: "bg-orange-100 text-orange-700",
  },
  purple: {
    card: "bg-purple-50 border-purple-200 hover:border-purple-400 hover:shadow-purple-100",
    badge: "bg-purple-100 text-purple-700",
  },
  indigo: {
    card: "bg-indigo-50 border-indigo-200 hover:border-indigo-400 hover:shadow-indigo-100",
    badge: "bg-indigo-100 text-indigo-700",
  },
};

const faqs = [
  {
    question: "Are these calculators really free?",
    answer:
      "Yes, all calculators on BasisPointCalculator.com are 100% free with no signup, no ads, and no hidden fees. Every calculation runs instantly in your browser.",
  },
  {
    question: "How accurate are the results?",
    answer:
      "Our calculators use standard financial formulas and are accurate to multiple decimal places. However, they are for educational purposes — always consult a financial professional for important decisions.",
  },
  {
    question: "Is my data stored or shared?",
    answer:
      "No. All calculations happen locally in your browser. We never store, transmit, or share any numbers you enter.",
  },
  {
    question: "What is a basis point?",
    answer:
      "A basis point (bps) is 1/100th of 1 percent, or 0.01%. Financial professionals use basis points to describe small changes in interest rates, fees, and yields. 100 basis points = 1%.",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- FAQPage Schema -->
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    })}
  />

  <!-- Hero Section -->
  <section class="text-center mb-12">
    <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href={getLocalizedUrl("/", locale)} class="hover:text-sky-600">Home</a>
      <span class="mx-2">›</span>
      <span class="text-slate-700">Calculators</span>
    </nav>
    <h1 class="text-4xl font-bold text-slate-800 mb-4">
      Free Financial Calculators
    </h1>
    <p class="text-lg text-slate-600 max-w-3xl mx-auto">
      25+ free tools for basis points, interest rates, loans, bonds, and
      investments. Instant results, zero signup — built for students,
      professionals, and anyone making financial decisions.
    </p>
  </section>

  <!-- Intro Content -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-4">
      Why Use Our Calculators?
    </h2>
    <div class="text-slate-600 space-y-3 text-sm leading-relaxed">
      <p>
        Whether you're comparing mortgage rates, analyzing bond yields, or
        converting basis points for a finance exam, BasisPointCalculator.com gives you the
        tools to get accurate answers fast. Every calculator runs entirely in
        your browser — your data never leaves your device.
      </p>
      <p>
        Our calculators are designed with clarity in mind: enter your values,
        see results instantly, and read plain-language explanations of the math
        behind each answer. No financial jargon left unexplained.
      </p>
    </div>
  </section>

  <!-- Category Cards -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-slate-800 mb-6">Browse by Category</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        categories.map((cat) => (
          <a
            href={getLocalizedUrl(cat.url, locale)}
            class={`block p-6 rounded-xl border-2 transition-all duration-200 hover:shadow-lg hover:-translate-y-1 ${colorClasses[cat.color].card}`}
          >
            <div class="flex items-start gap-4">
              <span class="text-4xl">{cat.icon}</span>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-lg font-semibold text-slate-800">
                    {cat.name}
                  </h3>
                  <span
                    class={`text-xs font-medium px-2 py-0.5 rounded-full ${colorClasses[cat.color].badge}`}
                  >
                    {cat.count} tools
                  </span>
                </div>
                <p class="text-sm text-slate-600 mb-3">{cat.description}</p>
                <div class="flex flex-wrap gap-1.5">
                  {cat.tools.map((tool) => (
                    <span class="text-xs bg-white/80 px-2 py-0.5 rounded border border-slate-200 text-slate-500">
                      {tool}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- How to Use Section -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">
      How to Use Our Calculators
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="text-center">
        <div
          class="w-12 h-12 bg-sky-100 rounded-full flex items-center justify-center mx-auto mb-3"
        >
          <span class="text-sky-600 font-bold text-lg">1</span>
        </div>
        <h3 class="font-medium text-slate-800 mb-1">Choose a Calculator</h3>
        <p class="text-sm text-slate-600">
          Pick from 25+ tools organized by category above.
        </p>
      </div>
      <div class="text-center">
        <div
          class="w-12 h-12 bg-sky-100 rounded-full flex items-center justify-center mx-auto mb-3"
        >
          <span class="text-sky-600 font-bold text-lg">2</span>
        </div>
        <h3 class="font-medium text-slate-800 mb-1">Enter Your Values</h3>
        <p class="text-sm text-slate-600">
          Type in your numbers — results update instantly.
        </p>
      </div>
      <div class="text-center">
        <div
          class="w-12 h-12 bg-sky-100 rounded-full flex items-center justify-center mx-auto mb-3"
        >
          <span class="text-sky-600 font-bold text-lg">3</span>
        </div>
        <h3 class="font-medium text-slate-800 mb-1">Understand the Result</h3>
        <p class="text-sm text-slate-600">
          Read plain-language explanations alongside every answer.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">
      Frequently Asked Questions
    </h2>
    <div class="divide-y divide-slate-100">
      {
        faqs.map((faq) => (
          <details class="group py-4 first:pt-0 last:pb-0">
            <summary class="flex items-center justify-between cursor-pointer font-medium text-slate-800 hover:text-sky-600 transition-colors">
              {faq.question}
              <svg
                class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Cross-links -->
  <section
    class="bg-gradient-to-r from-slate-50 to-sky-50 rounded-2xl p-8 border border-slate-200"
  >
    <h2 class="text-lg font-semibold text-slate-800 mb-4">
      Learn More About Finance
    </h2>
    <p class="text-sm text-slate-600 mb-5">
      Deepen your understanding with our guides, articles, and FAQs.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href={getLocalizedUrl("/guides/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-slate-200 hover:border-sky-400 transition-colors text-sm"
      >
        <span>📚</span> Financial Guides
      </a>
      <a
        href={getLocalizedUrl("/blog/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-slate-200 hover:border-sky-400 transition-colors text-sm"
      >
        <span>📝</span> Blog Articles
      </a>
      <a
        href={getLocalizedUrl("/faq/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-slate-200 hover:border-sky-400 transition-colors text-sm"
      >
        <span>❓</span> FAQ
      </a>
    </div>
  </section>
</Layout>
