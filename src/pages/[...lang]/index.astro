        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                cta.style.transform = "translateY(100%)";
              } else {
                cta.style.transform = "translateY(0)";
              }
            });
          },
          { threshold: 0.3 },
        );
        obs.observe(calc);
