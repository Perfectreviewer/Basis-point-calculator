---
import IndexLayout, { getStaticPaths as getStaticPathsIndex } from "@theme/layouts/IndexLayout.astro";
import FAQs from "@theme/components/FAQs.astro";
import Chart from "@theme/components/Chart.astro";
import { getTranslations, type Locale } from "@theme/i18n/utils";
import HowItWorks from "@theme/components/HowItWorks.astro";

import seoConfig from "~/config/page-seo.json";

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);
const isEn = locale === "en";

export const getStaticPaths = getStaticPathsIndex;

const chartData: any[] = [];

const currentPath = "/";
const seo = (seoConfig as Record<string, any>)[currentPath] || {};

const pageTitle = seo.title || "Basis Point Calculator – Accurate Basis Points Calculation Online";
const pageDescription = seo.description || "Use our free basis point calculator to perform accurate basis points calculation. Easily calculate basis points, convert percentages, and understand interest rate changes online.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.basispointcalculator.com/#organization",
      "name": "Basis Point Calculator",
      "url": "https://www.basispointcalculator.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.basispointcalculator.com/logo.png"
      },
      "sameAs": []
    },
    {
      "@type": "WebSite",
      "@id": "https://www.basispointcalculator.com/#website",
      "url": "https://www.basispointcalculator.com/",
      "name": "Basis Point Calculator",
      "publisher": {
        "@id": "https://www.basispointcalculator.com/#organization"
      },
      "inLanguage": "en"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.basispointcalculator.com/#homepage",
      "url": "https://www.basispointcalculator.com/",
      "name": pageTitle,
      "isPartOf": {
        "@id": "https://www.basispointcalculator.com/#website"
      },
      "about": {
        "@type": "Thing",
        "name": "Basis Points Calculation"
      },
      "description": pageDescription
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.basispointcalculator.com/#faq",
      "mainEntity": t.faqs.map((faq: any) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
});
---

<IndexLayout
  title={isEn ? pageTitle : t.index_title}
  description={isEn ? pageDescription : t.index_description}
  schema={!isEn}
>
  <style is:global>
    html {
      visibility: visible;
      opacity: 1;
    }
    .text-balance {
      text-wrap: balance;
    }
    /* Reduce bottom spacing on home page */
    body > main {
      padding-bottom: 3rem !important;
    }
    @media (min-width: 768px) {
      body > main {
        padding-bottom: 4rem !important;
      }
    }
    body > footer {
      margin-top: 0 !important;
    }
  </style>

  {isEn && <script type="application/ld+json" set:html={schema} slot="head" />}

  <div class="relative mb-8" id="calculator">
    <!-- Background Decoration -->
    <div class="absolute inset-0 bg-gradient-to-b from-sky-50/50 to-white dark:from-slate-900 dark:to-slate-950 -z-10 rounded-3xl transform -skew-y-1 scale-105 pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <section class="bg-white dark:bg-slate-800 dark:border-slate-700 rounded-2xl shadow-[0_8px_40px_rgb(0,0,0,0.06)] p-6 md:p-8 border border-slate-100 ring-1 ring-slate-900/5 relative z-10 transition-transform hover:-translate-y-0.5 duration-300">
         <div class="absolute top-0 right-0 p-4 opacity-50 pointer-events-none">
            <svg class="w-24 h-24 text-slate-50" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
         </div>
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2 relative z-10">{t["basis_point_calculator"]}</h1>
        <p class="text-slate-500 dark:text-slate-400 mb-8 max-w-md relative z-10">{t["calculator_desc"]}</p>

        <div class="grid grid-cols-1 gap-6 relative z-10">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">{t["decimal_value"]}</label>
            <div class="relative group">
              <input id="dec" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-4 px-4 pr-16 focus:outline-none focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all font-mono text-lg text-slate-800 shadow-sm group-hover:bg-white" placeholder="0.01" />
              <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium text-sm bg-slate-100 px-2 py-0.5 rounded text-xs tracking-wide">{t["dec"]}</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">{t["percent"]}</label>
            <div class="relative group">
              <input id="pct" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-4 px-4 pr-12 focus:outline-none focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all font-mono text-lg text-slate-800 shadow-sm group-hover:bg-white" placeholder="1" />
              <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium text-lg">%</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">{t["permille"]}</label>
            <div class="relative group">
              <input id="permille" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-4 px-4 pr-12 focus:outline-none focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all font-mono text-lg text-slate-800 shadow-sm group-hover:bg-white" placeholder="10" />
              <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium text-lg">‰</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">{t["basis_points"]}</label>
            <div class="relative group">
              <input id="bps" inputmode="decimal" class="w-full bg-sky-50 border border-sky-200 rounded-xl py-4 px-4 pr-16 focus:outline-none focus:ring-4 focus:ring-sky-500/20 focus:border-sky-600 transition-all font-mono text-xl font-bold text-sky-900 shadow-sm" placeholder="100" />
              <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-sky-600 font-bold text-sm bg-sky-100 px-2 py-0.5 rounded">{t["bps"]}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-white/90 dark:bg-slate-800/90 dark:border-slate-700 backdrop-blur-xl rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-6 md:p-8 border border-slate-100 ring-1 ring-slate-900/5 flex flex-col justify-center h-full relative z-10">
        <h2 class="text-xl font-bold text-slate-800 dark:text-white mb-8 pb-4 border-b border-slate-100 dark:border-slate-700 flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg">🧮</span>
          {t["what_is_x_bps_of_y"]}
        </h2>

        <div class="grid grid-cols-1 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">{t["x_bps"]}</label>
            <div class="flex gap-3">
              <input id="xval" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 focus:outline-none focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all font-mono text-slate-800 shadow-sm group-hover:bg-white" placeholder="1.5" />
              <select id="xunit" class="min-w-[100px] bg-white border border-slate-200 rounded-xl py-3 px-3 text-sm font-medium text-slate-700 hover:bg-slate-50 cursor-pointer shadow-sm focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 outline-none">
                <option value="bps" selected>{t["bps"]}</option>
                <option value="pct">%</option>
                <option value="dec">{t["decimal"]}</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">{t["of_ellipsis"]}</label>
            <div class="relative">
              <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs bg-slate-100 px-1.5 py-0.5 rounded" id="cur-left">PKR</span>
              <input id="amount" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 pl-16 pr-24 focus:outline-none focus:ring-4 focus:ring-sky-500/10 focus:border-sky-500 transition-all font-mono text-slate-800 shadow-sm group-hover:bg-white" placeholder="65,000.00" />
              <div class="absolute right-2 top-1/2 -translate-y-1/2">
                 <select id="currency" class="bg-white border border-slate-200 rounded-lg py-1.5 px-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer shadow-sm focus:outline-none focus:border-sky-500 transition-colors">
                  <option>PKR</option>
                  <option>USD</option>
                  <option>EUR</option>
                  <option>GBP</option>
                  <option>AED</option>
                  <option>SAR</option>
                  <option>INR</option>
                  <option>CAD</option>
                  <option>AUD</option>
                  <option>JPY</option>
                  <option>CNY</option>
                </select>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">{t["equals_ellipsis"]}</label>
            <div class="relative">
              <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs bg-white/50 px-1.5 py-0.5 rounded" id="cur-left-2">PKR</span>
              <input id="equals" class="w-full bg-gradient-to-r from-slate-100 to-white border border-slate-200 rounded-xl py-3 pl-16 pr-4 text-slate-800 font-bold font-mono shadow-inner" readonly />
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100 text-sm text-slate-600 space-y-3 bg-slate-50/50 -mx-8 -mb-8 p-8 rounded-b-2xl border-t-2 border-dashed" id="explain">
          <p><span id="line1" class="font-bold text-slate-800 text-lg"></span></p>
          <div class="text-[10px] uppercase tracking-widest text-slate-400 font-bold flex items-center gap-2">
             <span class="w-8 h-[1px] bg-slate-300"></span>
             {t["example_label"]}
             <span class="w-full h-[1px] bg-slate-300"></span>
          </div>
          <p id="line2" class="leading-relaxed text-slate-700 font-medium"></p>
          <p id="line3" class="text-slate-500 leading-relaxed"></p>
        </div>
      </section>
    </div>
  </div>

  {
    isEn ? (
      <div class="space-y-12">
        <!-- Intro Section -->
        <div class="max-w-4xl mx-auto text-center px-4 mt-12">
          <span class="inline-block px-4 py-1.5 rounded-full bg-sky-50 text-sky-700 text-xs font-bold uppercase tracking-wider mb-6 border border-sky-100">Professional Financial Tools</span>
          <h2 class="text-4xl font-extrabold text-slate-900 dark:text-white sm:text-5xl text-balance mb-6 tracking-tight">Accurate & Easy Basis Points Calculation Tool</h2>
          <p class="text-xl text-slate-600 dark:text-slate-300 leading-relaxed text-balance max-w-2xl mx-auto">
            Welcome to <strong>BasisPointCalculator.com</strong>, a professional platform for accurate financial analysis.
            Whether you are dealing with interest rates, loans, bonds, or investments, get instant results without confusion.
          </p>
        </div>

        <!-- What & Why Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto px-4">
          <div class="bg-white dark:bg-slate-800 dark:border-slate-700 p-8 rounded-3xl shadow-lg shadow-slate-200/50 dark:shadow-none border border-slate-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-64 h-64 bg-sky-50/50 rounded-full blur-3xl -translate-y-32 translate-x-16 transition-transform group-hover:scale-110"></div>
            
            <div class="w-14 h-14 bg-sky-50 rounded-2xl flex items-center justify-center mb-6 text-sky-600 ring-1 ring-sky-100 group-hover:scale-110 transition-transform duration-300 shadow-sm relative z-10">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4 relative z-10">What Are Basis Points?</h3>
            <p class="text-slate-600 dark:text-slate-300 mb-6 leading-relaxed relative z-10">
              A basis point (bp) is a standard unit of measurement in finance used to describe small changes in percentages.
            </p>
            <ul class="space-y-2 text-sm text-slate-600 font-mono bg-slate-50 p-5 rounded-xl border border-slate-100 relative z-10">
              <li class="flex justify-between items-center border-b border-slate-100 pb-2 mb-2 last:mb-0 last:pb-0 last:border-0">
                <span class="text-slate-500">1 basis point</span> <span class="font-bold text-slate-800 bg-white px-2 py-0.5 rounded shadow-sm">0.01%</span>
              </li>
              <li class="flex justify-between items-center border-b border-slate-100 pb-2 mb-2 last:mb-0 last:pb-0 last:border-0">
                <span class="text-slate-500">10 basis points</span> <span class="font-bold text-slate-800 bg-white px-2 py-0.5 rounded shadow-sm">0.10%</span>
              </li>
              <li class="flex justify-between items-center border-b border-slate-100 pb-2 mb-2 last:mb-0 last:pb-0 last:border-0">
                <span class="text-slate-500">100 basis points</span> <span class="font-bold text-slate-800 bg-white px-2 py-0.5 rounded shadow-sm">1.00%</span>
              </li>
              <li class="flex justify-between items-center">
                <span class="text-slate-500">1000 basis points</span> <span class="font-bold text-slate-800 bg-white px-2 py-0.5 rounded shadow-sm">10.00%</span>
              </li>
            </ul>
          </div>

          <div class="bg-white dark:bg-slate-800 dark:border-slate-700 p-8 rounded-3xl shadow-lg shadow-slate-200/50 dark:shadow-none border border-slate-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-50/50 rounded-full blur-3xl -translate-y-32 translate-x-16 transition-transform group-hover:scale-110"></div>
            
            <div class="w-14 h-14 bg-emerald-50 rounded-2xl flex items-center justify-center mb-6 text-emerald-600 ring-1 ring-emerald-100 group-hover:scale-110 transition-transform duration-300 shadow-sm relative z-10">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4 relative z-10">Why Basis Points Are Important</h3>
            <p class="text-slate-600 dark:text-slate-300 mb-6 leading-relaxed relative z-10">
              Financial markets deal with tiny percentage movements. Using basis points avoids ambiguity—saying "25 basis points" is clearer than "0.25%".
            </p>
            <div class="mt-auto relative z-10">
              <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">Used By Professionals</h4>
              <div class="flex flex-wrap gap-2">
                {["Banks", "Investors", "Loan Providers", "Bond Traders", "Central Banks"].map((item) => (
                  <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-semibold bg-white text-slate-700 border border-slate-200 shadow-sm hover:border-emerald-200 hover:text-emerald-700 transition-colors cursor-default">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- How to Calculate Section -->
        <div class="bg-slate-900 py-12 relative overflow-hidden my-12">
          <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] bg-fixed"></div>
           <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-sky-500/20 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3"></div>
           <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-500/20 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/3"></div>

          <div class="max-w-5xl mx-auto px-4 relative z-10">
            <h2 class="text-3xl md:text-4xl font-extrabold text-white text-center mb-12">How to Calculate Basis Points</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
              <div class="space-y-6">
                <div class="bg-white/10 backdrop-blur-lg p-8 rounded-3xl border border-white/10 shadow-2xl">
                  <h4 class="font-bold text-sky-300 mb-4 text-sm uppercase tracking-wider">The Formula</h4>
                  <code class="block bg-black/30 text-white p-6 rounded-2xl text-center font-mono text-lg md:text-xl leading-relaxed border border-white/5 shadow-inner">
                    Basis Points = Percentage × 100
                  </code>
                </div>
                <div class="text-slate-300 text-lg">
                  <p class="mb-4 font-medium">It works both ways:</p>
                  <ul class="space-y-3">
                    <li class="flex items-center gap-3">
                      <span class="w-6 h-6 rounded-full bg-sky-500/20 flex items-center justify-center text-sky-400 font-bold text-xs">×</span>
                      Multiply percentage by 100 to get bps.
                    </li>
                    <li class="flex items-center gap-3">
                      <span class="w-6 h-6 rounded-full bg-sky-500/20 flex items-center justify-center text-sky-400 font-bold text-xs">÷</span>
                      Divide bps by 100 to get percentage.
                    </li>
                  </ul>
                </div>
              </div>

              <div class="bg-white p-8 rounded-3xl shadow-xl border border-slate-100">
                <h4 class="font-bold text-slate-900 mb-6 text-sm uppercase tracking-wider flex items-center gap-2">
                   <svg class="w-5 h-5 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                   Real World Examples
                </h4>
                 <div class="space-y-3">
                    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100 transition-colors hover:border-sky-200">
                      <span class="font-mono text-slate-600 font-bold text-lg">2.00%</span>
                       <div class="flex-1 border-b-2 border-dashed border-slate-200 mx-4 relative top-0.5"></div>
                      <span class="font-bold text-slate-800 text-lg">200 bps</span>
                    </div>
                    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100 transition-colors hover:border-sky-200">
                      <span class="font-mono text-slate-600 font-bold text-lg">0.50%</span>
                       <div class="flex-1 border-b-2 border-dashed border-slate-200 mx-4 relative top-0.5"></div>
                      <span class="font-bold text-slate-800 text-lg">50 bps</span>
                    </div>
                    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100 transition-colors hover:border-sky-200">
                      <span class="font-mono text-slate-600 font-bold text-lg">1.25%</span>
                       <div class="flex-1 border-b-2 border-dashed border-slate-200 mx-4 relative top-0.5"></div>
                      <span class="font-bold text-slate-800 text-lg">125 bps</span>
                    </div>
                 </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Comparison Table -->
        <div class="max-w-4xl mx-auto px-4">
          <h2 class="text-3xl font-bold text-slate-900 text-center mb-10">Percentage vs Basis Points</h2>
          <div class="bg-white dark:bg-slate-800 dark:border-slate-700 shadow-xl shadow-slate-200/50 dark:shadow-none rounded-2xl overflow-hidden border border-slate-200">
            <table class="w-full text-left">
              <thead class="bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-700">
                <tr>
                  <th class="p-5 font-bold text-slate-700 text-sm uppercase tracking-wider">Percentage</th>
                  <th class="p-5 font-bold text-slate-700 text-sm uppercase tracking-wider">Basis Points</th>
                  <th class="p-5 font-bold text-slate-700 hidden sm:table-cell text-sm uppercase tracking-wider">Meaning</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-700 text-slate-600 dark:text-slate-300">
                <tr class="hover:bg-sky-50/30 dark:hover:bg-slate-700/30 transition-colors">
                  <td class="p-5 font-mono">1.00%</td>
                  <td class="p-5 font-bold text-slate-900 dark:text-white">100 bps</td>
                  <td class="p-5 hidden sm:table-cell">One percent</td>
                </tr>
                <tr class="hover:bg-sky-50/30 transition-colors">
                  <td class="p-5 font-mono">0.10%</td>
                  <td class="p-5 font-bold text-slate-900">10 bps</td>
                  <td class="p-5 hidden sm:table-cell">One tenth of a percent</td>
                </tr>
                <tr class="hover:bg-sky-50/30 transition-colors">
                  <td class="p-5 font-mono">0.01%</td>
                  <td class="p-5 font-bold text-slate-900">1 bp</td>
                  <td class="p-5 hidden sm:table-cell">One hundredth of a percent</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Features Grid -->
        <div class="max-w-6xl mx-auto px-4 py-10">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white text-center mb-12">Advanced Capabilities</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="p-6 bg-white dark:bg-slate-800 dark:border-slate-700 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:border-blue-200 hover:-translate-y-2 transition-all duration-300 group">
              <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
