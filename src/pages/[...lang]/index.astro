<script define:vars={{ t }}>
  const el = (id) => document.getElementById(id);

  // Simple translation interpolation helper
  const tr = (key, variables = {}) => {
    let text = t[key] || key;
    if (!t[key]) console.warn("Missing translation for:", key);
    for (const [k, v] of Object.entries(variables)) {
      text = text.replaceAll(`{${k}}`, v);
    }
    return text;
  };

  // Inputs (converter)
  const $dec = el("dec");
  const $pct = el("pct");
  const $permille = el("permille");
  const $bps = el("bps");
  const $slider = el("home-slider");

  // Live strip elements
  const $stripPct = el("strip-pct");
  const $stripDec = el("strip-dec");
  const $stripPml = el("strip-pml");
  const $strip1m = el("strip-1m");

  // x bps of y
  const $xval = el("xval");
  const $xunit = el("xunit");
  const $amount = el("amount");
  const $equals = el("equals");
  const $currency = el("currency");

  const $curLeft2 = el("cur-left-2");

  const $line1 = el("line1");
  const $line2 = el("line2");
  const $line3 = el("line3");

  // Dynamic UI helpers
  function popVal(elem) {
    if (!elem) return;
    elem.classList.remove("pop");
    void elem.offsetWidth;
    elem.classList.add("pop");
  }
  function setStrip(elem, val) {
    if (!elem) return;
    elem.textContent = val;
    popVal(elem);
  }
  function pulseResult() {
    const el = document.querySelector(".animate-gradient");
    if (!el) return;
    el.classList.remove("result-glow");
    void el.offsetWidth;
    el.classList.add("result-glow");
  }
  const fmtStrip = (n, d) => n.toFixed(d).replace(/\.?0+$/, "");
  const fmtUSD = (n) => n.toLocaleString("en-US", { maximumFractionDigits: 2 });

  // === NEON SPACE ENGINE ===
  
  // Spotlight effect
  const wrapper = document.getElementById('calc-wrapper');
  function enableSpotlight() { if(wrapper) wrapper.classList.add('spotlight-active'); }
  function disableSpotlight() { if(wrapper) wrapper.classList.remove('spotlight-active'); }
  
  if ($bps) {
    $bps.addEventListener('focus', enableSpotlight);
    $bps.addEventListener('blur', disableSpotlight);
  }
  if ($slider) {
    $slider.addEventListener('mousedown', enableSpotlight);
    $slider.addEventListener('touchstart', enableSpotlight);
    document.addEventListener('mouseup', disableSpotlight);
    document.addEventListener('touchend', disableSpotlight);
  }

  // Reactive Neon Glow based on BPS intensity (maxes out around 500 bps)
  const neonEls = [
    { el: el('pct'), color: 'rgba(56, 189, 248, ' }, // sky
    { el: el('dec'), color: 'rgba(129, 140, 248, ' }, // indigo
    { el: el('permille'), color: 'rgba(192, 132, 252, ' }, // violet
    { el: el('strip-1m'), color: 'rgba(52, 211, 153, ' } // emerald
  ];
  
  function updateNeonIntensity(currentBps) {
    const intensity = Math.min(Math.abs(currentBps) / 500, 1);
    // Glow blur radius
    const glowRadius = Math.max(5, intensity * 25);
    // Opacity
    const opacity = 0.2 + (intensity * 0.6);
    
    neonEls.forEach(function(item) {
      if (!item.el) return;
      item.el.style.textShadow = '0 0 ' + glowRadius + 'px ' + item.color + opacity + ')';
      if (intensity > 0.8) {
        item.el.style.color = '#fff';
      } else {
        item.el.style.color = '';
      }
    });

    // Also update tiny strip values
    const stripPct = el('strip-pct'); if(stripPct) stripPct.style.textShadow = '0 0 ' + (glowRadius/2) + 'px ' + neonEls[0].color + opacity + ')';
    const stripDec = el('strip-dec'); if(stripDec) stripDec.style.textShadow = '0 0 ' + (glowRadius/2) + 'px ' + neonEls[1].color + opacity + ')';
    const stripPml = el('strip-pml'); if(stripPml) stripPml.style.textShadow = '0 0 ' + (glowRadius/2) + 'px ' + neonEls[2].color + opacity + ')';
  }

  // High-Precision Smooth Roll Engine Trackers
  const _rollTimers = new Map();

  function fastRoll(elem, from, to, formatter, suffix) {
    suffix = suffix || '';
    if (!elem) return;
    if (_rollTimers.has(elem)) cancelAnimationFrame(_rollTimers.get(elem));
    
    elem.classList.add('rolling-num');
    const startTime = performance.now();
    const diff = to - from;
    const duration = 250; // VERY fast, like a high-end digital meter
    
    // Custom cubic bezier (sharp start, extremely smooth stop)
    function easeOutQuart(t) { return 1 - (--t) * t * t * t; }

    function tick(now) {
      const p = Math.min((now - startTime) / duration, 1);
      const current = from + diff * easeOutQuart(p);
      elem.textContent = formatter(current) + suffix;

      if (p < 1) {
        _rollTimers.set(elem, requestAnimationFrame(tick));
      } else {
        elem.textContent = formatter(to) + suffix;
        elem.classList.remove('rolling-num');
        _rollTimers.delete(elem);
      }
    }
    _rollTimers.set(elem, requestAnimationFrame(tick));
  }

  function fastRollInput(inputEl, from, to, formatter) {
    if (!inputEl) return;
    if (_rollTimers.has(inputEl)) cancelAnimationFrame(_rollTimers.get(inputEl));
    inputEl.classList.add('rolling-num');
    const startTime = performance.now();
    const diff = to - from;
    const duration = 250;
    function easeOutQuart(t) { return 1 - (--t) * t * t * t; }
    
    function tick(now) {
      const p = Math.min((now - startTime) / duration, 1);
      inputEl.value = formatter(from + diff * easeOutQuart(p));
      if (p < 1) {
        _rollTimers.set(inputEl, requestAnimationFrame(tick));
      } else {
        inputEl.value = formatter(to);
        inputEl.classList.remove('rolling-num');
        _rollTimers.delete(inputEl);
      }
    }
    _rollTimers.set(inputEl, requestAnimationFrame(tick));
  }

  let prevBps = 100;

  // Helpers
  const toNum = (v) => {
    if (v === "" || v == null) return NaN;
    // strip everything except digits, dot, sign, and exponent
    const n = Number(String(v).replace(/[^0-9+\-\.eE]/g, ""));
    return Number.isFinite(n) ? n : NaN;
  };

  const fmt = (n, d = 2) => {
    if (!Number.isFinite(n)) return "—";
    return n.toLocaleString(undefined, {
      minimumFractionDigits: d,
      maximumFractionDigits: d,
    });
  };

  const fmtPlain = (n, d = 2) => {
    if (!Number.isFinite(n)) return "";
    return n.toLocaleString(undefined, {
      minimumFractionDigits: d,
      maximumFractionDigits: d,
    });
  };

  const cur = () => $currency.value || "USD";

  // State: represent everything in bps internally
  let state = { bps: 100 }; // 100 bps = 1% default like the screenshot

  function reflectFromBps() {
    const b = state.bps; // may be negative
    const pct = b / 100; // %
    const pm = b / 10; // ‰
    const dec = b / 10000; // decimal
    $pct.value = fmtPlain(pct, 6).replace(/,/g, "");
    $permille.value = fmtPlain(pm, 6).replace(/,/g, "");
    $dec.value = fmtPlain(dec, 8).replace(/,/g, "");
    $bps.value = String(b);

    // Sync slider
    if ($slider) $slider.value = Math.max(1, Math.min(500, b));

    // Update live strip
    setStrip($stripPct, fmtStrip(pct, 4) + "%");
    setStrip($stripDec, fmtStrip(dec, 6));
    setStrip($stripPml, fmtStrip(pm, 3) + "‰");
    setStrip($strip1m, "$" + fmtUSD(dec * 1000000));

    // also nudge secondary card if xunit=bps and xval empty
    if (
      ($xval.value === "" || !Number.isFinite(toNum($xval.value))) &&
      $xunit.value === "bps"
    ) {
      $xval.value = "1.5";
    }
    computeXofY();
  }

  function setFromDecimal() {
    const v = toNum($dec.value);
    if (!Number.isFinite(v)) return;
    state.bps = v * 10000;
    reflectFromBps();
  }
  function setFromPercent() {
    const v = toNum($pct.value);
    if (!Number.isFinite(v)) return;
    state.bps = v * 100;
    reflectFromBps();
  }
  function setFromPermille() {
    const v = toNum($permille.value);
    if (!Number.isFinite(v)) return;
    state.bps = v * 10;
    reflectFromBps();
  }
  function setFromBps() {
    const v = toNum($bps.value);
    if (!Number.isFinite(v)) return;
    state.bps = v;
    reflectFromBps();
  }

  // x bps of y
  function computeXofY() {
    const x = toNum($xval.value);
    const amount = toNum($amount.value);
    const unit = $xunit.value; // bps | pct | dec
    const code = cur();

    $curLeft2.textContent = code;
    if (!Number.isFinite(x) || !Number.isFinite(amount)) {
      $equals.value = "";
      $line1.textContent = "";
      $line2.textContent = "";
      $line3.textContent = "";
      return;
    }
    let ratio = 0;
    if (unit === "bps") ratio = x / 10000;
    else if (unit === "pct") ratio = x / 100;
    else ratio = x; // decimal

    const delta = amount * ratio; // the absolute amount change
    const newAmt = amount + delta; // increased value (can be lower if delta negative)

    $equals.value = fmtPlain(delta, 2);

    const xLabel =
      unit === "bps"
        ? `${x} bps`
        : unit === "pct"
          ? `${x}%`
          : `${x} (${t["decimal"] || "decimal"})`;

    // Line 1
    $line1.textContent = tr("result_line1", {
      xLabel: xLabel,
      code: code,
      amount: fmt(amount, 2),
      delta: fmt(delta, 2),
    });

    const assets = [
      t["asset_stock"] || "A stock",
      t["asset_bond"] || "A bond",
      t["asset_portfolio"] || "A portfolio",
      t["asset_property"] || "A property",
      t["asset_investment"] || "An investment",
    ];
    // Simple hash of x+amount to keep it consistent for same inputs, or just random
    // User asked for "dynamic", random is better to show variety
    const noun = assets[Math.floor(Math.random() * assets.length)];

    const verb = delta >= 0 ? t["increased"] : t["decreased"];

    // Line 2
    $line2.innerHTML = tr("result_line2", {
      noun: noun,
      code: code,
      amount: fmt(amount, 2),
      verb: verb,
      xLabel: xLabel,
    });

    // Line 3
    $line3.innerHTML = tr("result_line3", {
      noun: noun.toLowerCase(),
      verb: `<strong>${verb}</strong>`,
      code: code,
      delta: fmt(Math.abs(delta), 2),
      newAmt: fmt(newAmt, 2),
    });
  }

  // Wire events
  $dec.addEventListener("input", setFromDecimal);
  $pct.addEventListener("input", setFromPercent);
  $permille.addEventListener("input", setFromPermille);
  $bps.addEventListener("input", setFromBps);

  // Slider drives BPS
  if ($slider) {
    $slider.addEventListener("input", () => {
      state.bps = parseInt($slider.value, 10);
      reflectFromBps();
    });
  }

  $xval.addEventListener("input", () => {
    computeXofY();
    pulseResult();
  });
  $xunit.addEventListener("change", () => {
    computeXofY();
    pulseResult();
  });
  $amount.addEventListener("input", () => {
    computeXofY();
    pulseResult();
  });
  $currency.addEventListener("change", () => {
    computeXofY();
    pulseResult();
  });

  // Init with screenshot-like values
  function init() {
    updateNeonIntensity(100);
    // Converter defaults ~ 1%
    state.bps = 100; // 1%
    reflectFromBps();
    // x bps of y defaults like screenshot
    $xval.value = "1.5";
    $xunit.value = "bps";
    $currency.value = "PKR";
    $amount.value = "65000.00";
    computeXofY();
  }
  init();

  // Console self‑tests
  (function tests() {
    const eps = 1e-12;
    const eq = (a, b) => Math.abs(a - b) <= eps;
    console.assert(eq(100 / 100, 1), "100 bps should be 1%");
    console.assert(
      eq((150 / 10000) * 65000, 9.75),
      "1.5 bps of 65k should be 9.75",
    );
  })();
</script>
