---
import IndexLayout, {
  getStaticPaths as getStaticPathsIndex,
} from "@theme/layouts/IndexLayout.astro";
import FAQs from "@theme/components/FAQs.astro";
import Chart from "@theme/components/Chart.astro";
import { getTranslations, type Locale } from "@theme/i18n/utils";
import HowItWorks from "@theme/components/HowItWorks.astro";
import AdSlot from "@theme/components/AdSlot.astro";

import seoConfig from "~/config/page-seo.json";

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

export const getStaticPaths = getStaticPathsIndex;

const chartData: any[] = [];

const currentPath = "/";
const seo = (seoConfig as Record<string, any>)[currentPath] || {};

const pageTitle =
  seo.title ||
  "Basis Point Calculator – Accurate Basis Points Calculation Online";
const pageDescription =
  seo.description ||
  "Use our free basis point calculator to perform accurate basis points calculation. Easily calculate basis points, convert percentages, and understand interest rate changes online.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.basispointcalculator.com/#organization",
      name: "Basis Point Calculator",
      url: "https://www.basispointcalculator.com/",
      logo: {
        "@type": "ImageObject",
        url: "https://www.basispointcalculator.com/logo.png",
      },
      sameAs: [],
    },
    {
      "@type": "WebSite",
      "@id": "https://www.basispointcalculator.com/#website",
      url: "https://www.basispointcalculator.com/",
      name: "Basis Point Calculator",
      publisher: {
        "@id": "https://www.basispointcalculator.com/#organization",
      },
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": "https://www.basispointcalculator.com/#homepage",
      url: "https://www.basispointcalculator.com/",
      name: pageTitle,
      isPartOf: {
        "@id": "https://www.basispointcalculator.com/#website",
      },
      about: {
        "@type": "Thing",
        name: "Basis Points Calculation",
      },
      description: pageDescription,
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.basispointcalculator.com/#faq",
      mainEntity: t.faqs.map((faq: any) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
  ],
});
---

<IndexLayout
  title={locale === "en" ? pageTitle : t.index_title}
  description={locale === "en" ? pageDescription : t.index_description}
  schema={locale !== "en"}
>
  <style is:global>
    html {
      visibility: visible;
      opacity: 1;
    }
    .text-balance {
      text-wrap: balance;
    }
    /* Prevent horizontal overflow on mobile from decorative blobs */
    html,
    body {
      overflow-x: hidden;
    }
    /* Reduce bottom spacing on home page */
    body > main {
      padding-bottom: 3rem !important;
    }
    @media (max-width: 767px) {
      /* Extra bottom padding so sticky CTA doesn't cover content */
      body > main {
        padding-bottom: 5rem !important;
      }
    }
    @media (min-width: 768px) {
      body > main {
        padding-bottom: 4rem !important;
      }
    }
    body > footer {
      margin-top: 0 !important;
    }
  </style>

  {
    locale === "en" && (
      <script type="application/ld+json" set:html={schema} slot="head" />
    )
  }

  <div class="relative mb-8" id="calculator">
    <!-- Background Decoration: Premium Mesh Atmosphere -->
    <div
      class="absolute inset-0 overflow-hidden pointer-events-none -z-10 rounded-3xl"
    >
      <div class="absolute inset-0 bg-white/50 dark:bg-slate-900/50"></div>
      <div
        class="absolute top-0 right-0 w-[600px] h-[600px] bg-indigo-500/5 rounded-full blur-3xl opacity-50 dark:bg-indigo-500/10"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-sky-500/5 rounded-full blur-3xl opacity-50 dark:bg-sky-500/10"
      >
      </div>
    </div>

    <!-- Main Calculators: Luminous Modern -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start relative z-10 max-w-6xl mx-auto"
    >
      <!-- Left Card: Converter -->
      <!-- Left Card: Converter -->
      <section
        class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-2xl rounded-3xl p-8 lg:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.04)] dark:shadow-none border border-white/60 dark:border-slate-800 transition-all hover:shadow-[0_16px_48px_rgba(0,0,0,0.08)] hover:-translate-y-1 duration-500 relative group text-left ring-1 ring-white/50"
      >
        <div
          class="absolute inset-0 bg-gradient-to-br from-white/60 via-transparent to-transparent rounded-3xl pointer-events-none"
        >
        </div>

        <div class="mb-10 relative">
          <h2
            class="text-3xl font-bold font-serif text-slate-900 dark:text-white mb-2 tracking-tight"
          >
            {t["basis_point_calculator"]}
          </h2>
          <div class="flex items-center gap-2">
            <span
              class="h-px flex-1 bg-gradient-to-r from-indigo-500/50 to-transparent"
            ></span>
            <p
              class="text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-widest"
            >
              Precision Converter
            </p>
          </div>
        </div>

        <div class="space-y-6 relative">
          <!-- Decimal -->
          <div>
            <label
              class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1 opacity-90"
              >{t["decimal"]}</label
            >
            <div class="relative group">
              <input
                id="dec"
                inputmode="decimal"
                class="block w-full rounded-xl border-0 ring-1 ring-slate-200 dark:ring-slate-700 bg-white dark:bg-slate-800 py-4 px-5 text-lg font-mono text-slate-900 dark:text-white shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus:ring-2 focus:ring-indigo-500 focus:shadow-[0_0_0_4px_rgba(99,102,241,0.1)] transition-all duration-300 outline-none placeholder:text-slate-300"
                placeholder="0.01000000"
              />
              <span
                class="absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-xs font-bold uppercase pointer-events-none group-focus-within:text-indigo-500 transition-colors"
                >dec</span
              >
            </div>
          </div>

          <!-- Percent -->
          <div>
            <label
              class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1 opacity-90"
              >{t["percent"]}</label
            >
            <div class="relative group">
              <input
                id="pct"
                inputmode="decimal"
                class="block w-full rounded-xl border-0 ring-1 ring-slate-200 dark:ring-slate-700 bg-white dark:bg-slate-800 py-4 px-5 text-lg font-mono text-slate-900 dark:text-white shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus:ring-2 focus:ring-indigo-500 focus:shadow-[0_0_0_4px_rgba(99,102,241,0.1)] transition-all duration-300 outline-none placeholder:text-slate-300"
                placeholder="1.000000"
              />
              <span
                class="absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-xs font-bold uppercase pointer-events-none group-focus-within:text-indigo-500 transition-colors"
                >%</span
              >
            </div>
          </div>

          <!-- Permille -->
          <div>
            <label
              class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1 opacity-90"
              >{t["permille"]}</label
            >
            <div class="relative group">
              <input
                id="permille"
                inputmode="decimal"
                class="block w-full rounded-xl border-0 ring-1 ring-slate-200 dark:ring-slate-700 bg-white dark:bg-slate-800 py-4 px-5 text-lg font-mono text-slate-900 dark:text-white shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus:ring-2 focus:ring-indigo-500 focus:shadow-[0_0_0_4px_rgba(99,102,241,0.1)] transition-all duration-300 outline-none placeholder:text-slate-300"
                placeholder="10.000000"
              />
              <span
                class="absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-xs font-bold uppercase pointer-events-none group-focus-within:text-indigo-500 transition-colors"
                >‰</span
              >
            </div>
          </div>

          <!-- Basis Points (Highlighted) -->
          <div
            class="pt-6 mt-6 border-t border-slate-100 dark:border-slate-800/50"
          >
            <label
              class="flex justify-between items-center text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-[0.2em] mb-3 opacity-90"
            >
              {t["basis_points"]}
              <span
                class="px-2 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-900/30 text-[10px] text-indigo-600 dark:text-indigo-300 ring-1 ring-indigo-500/20 tracking-normal opacity-100"
                >Calculated</span
              >
            </label>
            <div class="relative group">
              <div
                class="absolute inset-0 bg-indigo-500/20 dark:bg-indigo-500/10 rounded-2xl blur-xl transition-opacity opacity-0 group-focus-within:opacity-100"
              >
              </div>
              <input
                id="bps"
                inputmode="decimal"
                class="block w-full rounded-2xl border-0 ring-1 ring-indigo-100 dark:ring-indigo-900/50 bg-white dark:bg-slate-800 py-6 px-6 text-4xl font-bold text-slate-900 dark:text-white shadow-[0_4px_20px_rgba(99,102,241,0.1)] dark:shadow-none focus:ring-2 focus:ring-indigo-500 focus:shadow-[0_0_0_8px_rgba(99,102,241,0.1)] transition-all duration-300 outline-none relative z-10"
                placeholder="100"
              />
              <span
                class="absolute right-6 top-1/2 -translate-y-1/2 text-indigo-500 dark:text-indigo-400 text-sm font-bold uppercase pointer-events-none tracking-widest z-10"
                >{t["bps"]}</span
              >
            </div>
          </div>
        </div>
      </section>

      <!-- Right Card: Scenario -->
      <!-- Right Card: Scenario -->
      <section
        class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-2xl rounded-3xl p-8 lg:p-10 border border-white/60 dark:border-slate-800 shadow-[0_8px_32px_rgba(0,0,0,0.04)] dark:shadow-none h-full flex flex-col relative overflow-hidden text-left ring-1 ring-white/50 transition-all hover:shadow-[0_16px_48px_rgba(0,0,0,0.08)] hover:-translate-y-1 duration-500"
      >
        <div class="mb-10 relative z-10">
          <h2
            class="text-3xl font-bold font-serif text-slate-900 dark:text-white mb-2 tracking-tight"
          >
            {t["what_is_x_bps_of_y"]}
          </h2>
          <div class="flex items-center gap-2">
            <span
              class="h-px flex-1 bg-gradient-to-r from-slate-300/50 to-transparent"
            ></span>
            <p
              class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest"
            >
              Scenario Simulation
            </p>
          </div>
        </div>

        <div class="space-y-8 flex-1 relative z-10">
          <!-- x bps -->
          <div>
            <label
              class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1 opacity-90"
              >{t["x_bps"]}</label
            >
            <div
              class="flex rounded-xl bg-white dark:bg-slate-800 ring-1 ring-slate-200 dark:ring-slate-700 shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus-within:ring-2 focus-within:ring-indigo-500 focus-within:shadow-[0_0_0_4px_rgba(99,102,241,0.1)] transition-all duration-300 group overflow-hidden"
            >
              <input
                id="xval"
                inputmode="decimal"
                class="block w-full border-0 py-4 px-5 text-xl font-medium text-slate-900 dark:text-white focus:ring-0 bg-transparent placeholder:text-slate-300 outline-none"
                placeholder="1.5"
              />
              <div class="relative my-1 mr-1">
                <select
                  id="xunit"
                  class="h-full rounded-lg border-0 bg-slate-50 dark:bg-slate-700 py-0 pl-3 pr-8 text-xs font-bold text-slate-600 dark:text-slate-300 focus:ring-0 cursor-pointer uppercase tracking-wider hover:bg-slate-100 dark:hover:bg-slate-600 transition-colors"
                >
                  <option value="bps" selected>{t["bps"]}</option>
                  <option value="pct">%</option>
                  <option value="dec">{t["decimal"]}</option>
                </select>
              </div>
            </div>
          </div>

          <!-- of... -->
          <div>
            <label
              class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1 opacity-90"
              >{t["of_ellipsis"]}</label
            >
            <div
              class="flex rounded-xl bg-white dark:bg-slate-800 ring-1 ring-slate-200 dark:ring-slate-700 shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus-within:ring-2 focus-within:ring-indigo-500 focus-within:shadow-[0_0_0_4px_rgba(99,102,241,0.1)] transition-all duration-300 group overflow-hidden"
            >
              <div class="relative my-1 ml-1">
                <select
                  id="currency"
                  class="h-full rounded-lg border-0 bg-slate-50 dark:bg-slate-700 py-0 pl-3 pr-8 text-xs font-bold text-slate-600 dark:text-slate-300 focus:ring-0 cursor-pointer uppercase tracking-wider hover:bg-slate-100 dark:hover:bg-slate-600 transition-colors"
                >
                  <option>PKR</option>
                  <option selected>USD</option>
                  <option>EUR</option>
                  <option>GBP</option>
                </select>
              </div>
              <input
                id="amount"
                inputmode="decimal"
                class="block w-full border-0 py-4 px-5 text-xl font-medium text-right text-slate-900 dark:text-white focus:ring-0 bg-transparent placeholder:text-slate-300 outline-none"
                placeholder="65,000.00"
              />
            </div>
          </div>

          <!-- equals... -->
          <!-- equals... -->
          <div class="pt-6">
            <label
              class="block text-[11px] font-bold text-indigo-500 dark:text-indigo-400 uppercase tracking-[0.2em] mb-3 opacity-90"
              >{t["equals_ellipsis"]}</label
            >
            <div
              class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-500 via-purple-500 to-indigo-500 bg-[length:200%_auto] animate-gradient p-0.5 shadow-lg shadow-indigo-500/30 group"
            >
              <!-- Shimmer effect -->
              <div
                class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full group-hover:translate-x-full duration-1000 transition-transform"
              >
              </div>

              <div
                class="relative bg-white/10 backdrop-blur-sm rounded-xl p-1 flex items-center"
              >
                <div class="pl-5 pr-2">
                  <span class="text-white/70 font-bold text-xs" id="cur-left-2"
                    >USD</span
                  >
                </div>
                <input
                  id="equals"
                  class="block w-full rounded-xl border-0 bg-transparent py-5 px-4 text-4xl font-bold text-white text-right focus:ring-0 cursor-default placeholder-white/50"
                  readonly
                  placeholder="9.75"
                />
              </div>
            </div>
          </div>
          <!-- Explanation -->
          <div
            class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800"
            id="explain"
          >
            <p
              class="font-bold text-slate-900 dark:text-white text-xs uppercase tracking-widest mb-3 flex items-center gap-2"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
              {t["example"]}
            </p>
            <div
              class="bg-indigo-50/50 dark:bg-slate-800/50 rounded-xl p-4 border border-indigo-100/50 dark:border-slate-700/50"
            >
              <p
                id="line1"
                class="text-slate-800 dark:text-slate-200 text-sm font-medium leading-relaxed mb-1"
              >
              </p>
              <p
                id="line2"
                class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed"
              >
              </p>
              <p id="line3" class="hidden"></p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="space-y-12">
    <!-- Intro Section -->
    <div class="max-w-4xl mx-auto text-center px-4 mt-12">
      <span
        class="inline-block px-4 py-1.5 rounded-full bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 text-xs font-bold uppercase tracking-wider mb-6 border border-sky-100 dark:border-sky-800"
        >{t["home_badge"]}</span
      >
      <h2
        class="text-4xl font-extrabold text-slate-900 dark:text-white sm:text-5xl text-balance mb-6 tracking-tight"
      >
        {t["home_hero_title"]}
      </h2>
      <p
        class="text-xl text-slate-600 dark:text-slate-300 leading-relaxed text-balance max-w-2xl mx-auto"
        set:html={t["home_hero_desc"]}
      />
    </div>

    <!-- What & Why Grid -->
    <div
      class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start max-w-6xl mx-auto"
    >
      <div
        class="bg-white dark:bg-slate-800 dark:border-slate-700 p-8 rounded-3xl shadow-lg shadow-slate-200/50 dark:shadow-none border border-slate-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 relative overflow-hidden group"
      >
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-sky-50/50 rounded-full blur-3xl -translate-y-32 translate-x-16 transition-transform group-hover:scale-110"
        >
        </div>

        <div
          class="w-14 h-14 bg-sky-50 dark:bg-sky-900/20 rounded-2xl flex items-center justify-center mb-6 text-sky-600 dark:text-sky-400 ring-1 ring-sky-100 dark:ring-sky-800 group-hover:scale-110 transition-transform duration-300 shadow-sm relative z-10"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path></svg
          >
        </div>
        <h3
          class="text-2xl font-bold text-slate-900 dark:text-white mb-4 relative z-10"
        >
          {t["home_what_title"]}
        </h3>
        <p
          class="text-slate-600 dark:text-slate-300 mb-6 leading-relaxed relative z-10"
        >
          {t["home_what_desc"]}
        </p>
        <ul class="space-y-3 mt-8">
          <li
            class="flex justify-between items-center bg-white/60 dark:bg-slate-800/40 p-4 rounded-2xl border border-slate-100 dark:border-slate-700/50 shadow-sm hover:shadow-md hover:border-indigo-100 dark:hover:border-indigo-900/30 transition-all duration-300 group cursor-default"
          >
            <div class="flex items-center gap-3">
              <span
                class="w-1.5 h-1.5 rounded-full bg-indigo-500/50 group-hover:bg-indigo-500 transition-colors"
              ></span>
              <span
                class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest"
                >{t["home_bp_1"]}</span
              >
            </div>
            <span
              class="font-mono text-sm font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/10 px-3 py-1 rounded-lg border border-indigo-100 dark:border-indigo-500/20 group-hover:scale-105 transition-transform"
              >0.01%</span
            >
          </li>
          <li
            class="flex justify-between items-center bg-white/60 dark:bg-slate-800/40 p-4 rounded-2xl border border-slate-100 dark:border-slate-700/50 shadow-sm hover:shadow-md hover:border-indigo-100 dark:hover:border-indigo-900/30 transition-all duration-300 group cursor-default"
          >
            <div class="flex items-center gap-3">
              <span
                class="w-1.5 h-1.5 rounded-full bg-indigo-500/50 group-hover:bg-indigo-500 transition-colors"
              ></span>
              <span
                class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest"
                >{t["home_bp_10"]}</span
              >
            </div>
            <span
              class="font-mono text-sm font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/10 px-3 py-1 rounded-lg border border-indigo-100 dark:border-indigo-500/20 group-hover:scale-105 transition-transform"
              >0.10%</span
            >
          </li>
          <li
            class="flex justify-between items-center bg-white/60 dark:bg-slate-800/40 p-4 rounded-2xl border border-slate-100 dark:border-slate-700/50 shadow-sm hover:shadow-md hover:border-indigo-100 dark:hover:border-indigo-900/30 transition-all duration-300 group cursor-default"
          >
            <div class="flex items-center gap-3">
              <span
                class="w-1.5 h-1.5 rounded-full bg-indigo-500/50 group-hover:bg-indigo-500 transition-colors"
              ></span>
              <span
                class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest"
                >{t["home_bp_100"]}</span
              >
            </div>
            <span
              class="font-mono text-sm font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/10 px-3 py-1 rounded-lg border border-indigo-100 dark:border-indigo-500/20 group-hover:scale-105 transition-transform"
              >1.00%</span
            >
          </li>
          <li
            class="flex justify-between items-center bg-white/60 dark:bg-slate-800/40 p-4 rounded-2xl border border-slate-100 dark:border-slate-700/50 shadow-sm hover:shadow-md hover:border-indigo-100 dark:hover:border-indigo-900/30 transition-all duration-300 group cursor-default"
          >
            <div class="flex items-center gap-3">
              <span
                class="w-1.5 h-1.5 rounded-full bg-indigo-500/50 group-hover:bg-indigo-500 transition-colors"
              ></span>
              <span
                class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest"
                >{t["home_bp_1000"]}</span
              >
            </div>
            <span
              class="font-mono text-sm font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/10 px-3 py-1 rounded-lg border border-indigo-100 dark:border-indigo-500/20 group-hover:scale-105 transition-transform"
              >10.00%</span
            >
          </li>
        </ul>
      </div>

      <div
        class="bg-white dark:bg-slate-800 dark:border-slate-700 p-8 rounded-3xl shadow-lg shadow-slate-200/50 dark:shadow-none border border-slate-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 relative overflow-hidden group"
      >
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-emerald-50/50 rounded-full blur-3xl -translate-y-32 translate-x-16 transition-transform group-hover:scale-110"
        >
        </div>

        <div
