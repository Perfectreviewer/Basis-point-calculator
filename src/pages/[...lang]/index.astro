---
import IndexLayout, { getStaticPaths as getStaticPathsIndex } from "@theme/layouts/IndexLayout.astro";
import FAQs from "@theme/components/FAQs.astro";
import Chart from "@theme/components/Chart.astro";
import { getTranslations, type Locale } from "@theme/i18n/utils";
import HowItWorks from "@theme/components/HowItWorks.astro";

import seoConfig from "~/config/page-seo.json";

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);
const isEn = locale === "en";

export const getStaticPaths = getStaticPathsIndex;

const chartData = [];

const currentPath = "/";
const seo = (seoConfig as Record<string, any>)[currentPath] || {};

const pageTitle = seo.title || "Basis Point Calculator – Accurate Basis Points Calculation Online";
const pageDescription = seo.description || "Use our free basis point calculator to perform accurate basis points calculation. Easily calculate basis points, convert percentages, and understand interest rate changes online.";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.basispointcalculator.com/#organization",
      "name": "Basis Point Calculator",
      "url": "https://www.basispointcalculator.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.basispointcalculator.com/logo.png"
      },
      "sameAs": []
    },
    {
      "@type": "WebSite",
      "@id": "https://www.basispointcalculator.com/#website",
      "url": "https://www.basispointcalculator.com/",
      "name": "Basis Point Calculator",
      "publisher": {
        "@id": "https://www.basispointcalculator.com/#organization"
      },
      "inLanguage": "en"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.basispointcalculator.com/#homepage",
      "url": "https://www.basispointcalculator.com/",
      "name": pageTitle,
      "isPartOf": {
        "@id": "https://www.basispointcalculator.com/#website"
      },
      "about": {
        "@type": "Thing",
        "name": "Basis Points Calculation"
      },
      "description": pageDescription
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.basispointcalculator.com/#faq",
      "mainEntity": t.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
});
---

<IndexLayout
  title={isEn ? pageTitle : t.index_title}
  description={isEn ? pageDescription : t.index_description}
  schema={!isEn}
>
  <style is:global>
    html {
      visibility: visible;
      opacity: 1;
    }
    .text-balance {
      text-wrap: balance;
    }
  </style>

  {isEn && <script type="application/ld+json" set:html={schema} slot="head" />}

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12" id="calculator">
    <section class="bg-white/80 backdrop-blur-xl rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-6 border border-white/20 ring-1 ring-slate-900/5">
      <h1 class="text-2xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent mb-2">{t["basis_point_calculator"]}</h1>
      <p class="text-sm text-slate-500 mb-6">{t["calculator_desc"]}</p>

      <div class="grid grid-cols-1 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">{t["decimal_value"]}</label>
          <div class="relative group">
            <input id="dec" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 pr-16 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-all font-mono text-slate-800 shadow-sm" placeholder="0.01" />
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium text-sm">{t["dec"]}</span>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">{t["percent"]}</label>
          <div class="relative group">
            <input id="pct" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 pr-10 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-all font-mono text-slate-800 shadow-sm" placeholder="1" />
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium text-sm">%</span>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">{t["permille"]}</label>
          <div class="relative group">
            <input id="permille" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 pr-10 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-all font-mono text-slate-800 shadow-sm" placeholder="10" />
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium text-sm">‰</span>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">{t["basis_points"]}</label>
          <div class="relative group">
            <input id="bps" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 pr-14 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-all font-mono text-slate-800 shadow-sm" placeholder="100" />
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium text-sm">{t["bps"]}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white/80 backdrop-blur-xl rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-6 border border-white/20 ring-1 ring-slate-900/5 flex flex-col justify-center">
      <h2 class="text-xl font-bold text-slate-800 mb-6">{t["what_is_x_bps_of_y"]}</h2>

      <div class="grid grid-cols-1 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">{t["x_bps"]}</label>
          <div class="flex gap-3">
            <input id="xval" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-all font-mono text-slate-800 shadow-sm" placeholder="1.5" />
            <select id="xunit" class="min-w-[100px] bg-white border border-slate-200 rounded-xl py-3 px-3 text-sm font-medium text-slate-700 hover:bg-slate-50 cursor-pointer shadow-sm">
              <option value="bps" selected>{t["bps"]}</option>
              <option value="pct">%</option>
              <option value="dec">{t["decimal"]}</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">{t["of_ellipsis"]}</label>
          <div class="relative">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 font-medium text-sm" id="cur-left">PKR</span>
            <input id="amount" inputmode="decimal" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 pl-14 pr-24 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-all font-mono text-slate-800 shadow-sm" placeholder="65,000.00" />
            <select id="currency" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white border border-slate-200 rounded-lg py-1.5 px-2 text-xs font-medium text-slate-600 hover:bg-slate-50 cursor-pointer shadow-sm">
              <option>PKR</option>
              <option>USD</option>
              <option>EUR</option>
              <option>GBP</option>
              <option>AED</option>
              <option>SAR</option>
              <option>INR</option>
              <option>CAD</option>
              <option>AUD</option>
              <option>JPY</option>
              <option>CNY</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">{t["equals_ellipsis"]}</label>
          <div class="relative">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 font-medium text-sm" id="cur-left-2">PKR</span>
            <input id="equals" class="w-full bg-slate-100/50 border border-slate-200 rounded-xl py-3 pl-14 pr-4 text-slate-700 font-bold font-mono shadow-inner" readonly />
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-100 text-sm text-slate-600 space-y-3" id="explain">
        <p><span id="line1" class="font-medium text-slate-800 text-base"></span></p>
        <div class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">{t["example_label"]}</div>
        <p id="line2" class="leading-relaxed text-slate-600"></p>
        <p id="line3" class="text-slate-500 leading-relaxed"></p>
      </div>
    </section>
  </div>

  {
    isEn ? (
      <div class="space-y-12">
        <!-- Intro Section -->
        <div class="max-w-3xl mx-auto text-center px-4">
          <h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl text-balance mb-4">Accurate & Easy Basis Points Calculation Tool</h2>
          <p class="text-lg text-slate-600 leading-relaxed text-balance">
            Welcome to <strong>BasisPointCalculator.com</strong>, a professional platform for accurate financial analysis.
            Whether you are dealing with interest rates, loans, bonds, or investments, get instant results without confusion.
          </p>
        </div>

        <!-- What & Why Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto px-4">
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-all hover:-translate-y-0.5">
            <div class="w-10 h-10 bg-sky-50 rounded-xl flex items-center justify-center mb-4 text-sky-600 ring-1 ring-sky-100">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">What Are Basis Points?</h3>
            <p class="text-slate-600 mb-4 text-sm leading-relaxed">
              A basis point (bp) is a standard unit of measurement in finance used to describe small changes in percentages.
            </p>
            <ul class="space-y-1.5 text-xs text-slate-600 font-mono bg-slate-50 p-3 rounded-lg border border-slate-100">
              <li class="flex justify-between"><span>1 basis point</span> <span>0.01%</span></li>
              <li class="flex justify-between"><span>10 basis points</span> <span>0.10%</span></li>
              <li class="flex justify-between"><span>100 basis points</span> <span>1.00%</span></li>
              <li class="flex justify-between"><span>1000 basis points</span> <span>10.00%</span></li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-all hover:-translate-y-0.5">
            <div class="w-10 h-10 bg-emerald-50 rounded-xl flex items-center justify-center mb-4 text-emerald-600 ring-1 ring-emerald-100">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Why Basis Points Are Important</h3>
            <p class="text-slate-600 mb-4 text-sm leading-relaxed">
              Financial markets deal with tiny percentage movements. Using basis points avoids ambiguity—saying "25 basis points" is clearer than "0.25%".
            </p>
            <div class="mt-4">
              <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">Used By Professionals</h4>
              <div class="flex flex-wrap gap-2">
                {["Banks", "Investors", "Loan Providers", "Bond Traders", "Central Banks"].map((item) => (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-medium bg-slate-50 text-slate-600 border border-slate-100">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- How to Calculate Section -->
        <div class="bg-slate-50/50 py-12 border-y border-slate-200/50">
          <div class="max-w-4xl mx-auto px-4">
            <h2 class="text-2xl font-bold text-slate-900 text-center mb-8">How to Calculate Basis Points</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
              <div class="space-y-4">
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                  <h4 class="font-semibold text-slate-900 mb-2 text-sm">The Formula</h4>
                  <code class="block bg-slate-900 text-slate-50 p-2.5 rounded-lg text-center font-mono text-sm leading-relaxed">
                    Basis Points = Percentage × 100
                  </code>
                </div>
                <div class="text-slate-600 text-sm">
                  <p class="mb-2">It works both ways:</p>
                  <ul class="space-y-1.5 list-disc list-inside marker:text-slate-400">
                    <li>Multiply percentage by 100 to get bps.</li>
                    <li>Divide bps by 100 to get percentage.</li>
                  </ul>
                </div>
              </div>

              <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <h4 class="font-semibold text-slate-900 mb-3 text-sm">Real World Examples</h4>
                 <div class="space-y-2">
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg border border-slate-100/50">
                      <span class="font-mono text-slate-600 text-sm">2.00%</span>
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      <span class="font-bold text-slate-800 text-sm">200 bps</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg border border-slate-100/50">
                      <span class="font-mono text-slate-600 text-sm">0.50%</span>
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      <span class="font-bold text-slate-800 text-sm">50 bps</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg border border-slate-100/50">
                      <span class="font-mono text-slate-600 text-sm">1.25%</span>
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      <span class="font-bold text-slate-800 text-sm">125 bps</span>
                    </div>
                 </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Comparison Table -->
        <div class="max-w-3xl mx-auto px-4">
          <h2 class="text-2xl font-bold text-slate-900 text-center mb-6">Percentage vs Basis Points</h2>
          <div class="bg-white shadow-sm rounded-xl overflow-hidden border border-slate-200 ring-1 ring-slate-900/5">
            <table class="w-full text-left">
              <thead class="bg-slate-50/80 border-b border-slate-200">
                <tr>
                  <th class="p-4 font-semibold text-slate-700 text-sm uppercase tracking-wider">Percentage</th>
                  <th class="p-4 font-semibold text-slate-700 text-sm uppercase tracking-wider">Basis Points</th>
                  <th class="p-4 font-semibold text-slate-700 hidden sm:table-cell text-sm uppercase tracking-wider">Meaning</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-600">
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="p-4 font-mono text-sm">1.00%</td>
                  <td class="p-4 font-bold text-slate-800 text-sm">100 bps</td>
                  <td class="p-4 hidden sm:table-cell text-sm">One percent</td>
                </tr>
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="p-4 font-mono text-sm">0.10%</td>
                  <td class="p-4 font-bold text-slate-800 text-sm">10 bps</td>
                  <td class="p-4 hidden sm:table-cell text-sm">One tenth of a percent</td>
                </tr>
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="p-4 font-mono text-sm">0.01%</td>
                  <td class="p-4 font-bold text-slate-800 text-sm">1 bp</td>
                  <td class="p-4 hidden sm:table-cell text-sm">One hundredth of a percent</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Features Grid -->
        <div class="max-w-5xl mx-auto px-4">
          <h2 class="text-2xl font-bold text-slate-900 text-center mb-8">Advanced Capabilities</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-5 bg-white rounded-xl shadow-sm border border-slate-100 ring-1 ring-slate-900/5 hover:-translate-y-1 transition-transform duration-300">
              <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center mb-3">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2 text-sm">BPS Difference</h3>
              <p class="text-xs text-slate-500 leading-relaxed">Calculate the precise difference between two interest rates in basis points.</p>
            </div>
            <div class="p-5 bg-white rounded-xl shadow-sm border border-slate-100 ring-1 ring-slate-900/5 hover:-translate-y-1 transition-transform duration-300">
              <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-lg flex items-center justify-center mb-3">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2 text-sm">Rate Change</h3>
              <p class="text-xs text-slate-500 leading-relaxed">Analyze financial movements using small rate changes instantly.</p>
            </div>
            <div class="p-5 bg-white rounded-xl shadow-sm border border-slate-100 ring-1 ring-slate-900/5 hover:-translate-y-1 transition-transform duration-300">
              <div class="w-10 h-10 bg-purple-50 text-purple-600 rounded-lg flex items-center justify-center mb-3">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2 text-sm">Unit Conversion</h3>
              <p class="text-xs text-slate-500 leading-relaxed">Convert freely between Basis Points, Percentage, Permille, and Decimal.</p>
            </div>
            <div class="p-5 bg-white rounded-xl shadow-sm border border-slate-100 ring-1 ring-slate-900/5 hover:-translate-y-1 transition-transform duration-300">
              <div class="w-10 h-10 bg-rose-50 text-rose-600 rounded-lg flex items-center justify-center mb-3">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2 text-sm">Educational</h3>
              <p class="text-xs text-slate-500 leading-relaxed">Learn finance concepts with our comprehensive guides and examples.</p>
            </div>
          </div>
        </div>

        <!-- Tools Suite -->
        <div class="bg-white border-y border-slate-100 py-12">
          <div class="max-w-5xl mx-auto px-4">
            <h2 class="text-2xl font-bold text-slate-900 text-center mb-3">Complete Suite of Financial Calculators</h2>
            <p class="text-slate-500 text-center mb-8 max-w-2xl mx-auto text-sm">Beyond the homepage calculator, discover our full ecosystem of financial tools designed for professionals.</p>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="space-y-3">
                <div class="flex items-center gap-3 mb-1">
                  <div class="p-1.5 bg-sky-50 rounded-lg text-sky-600">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                  </div>
                  <h4 class="font-bold text-slate-900 text-sm"><a href="/basis-point-calculators/" class="hover:text-sky-600 transition-colors">Basis Point Tools</a></h4>
                </div>
                <ul class="space-y-2">
                  <li><a href="/basis-point-calculators/basis-point-to-percentage/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-xs text-slate-700 hover:text-sky-700 transition-colors border border-slate-100">BPS to Percentage Calculator</a></li>
                  <li><a href="/basis-point-calculators/percentage-to-basis-point/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-xs text-slate-700 hover:text-sky-700 transition-colors border border-slate-100">Percentage to BPS Calculator</a></li>
                  <li><a href="/basis-point-calculators/basis-point-change-calculator/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-xs text-slate-700 hover:text-sky-700 transition-colors border border-slate-100">BPS Change Calculator</a></li>
