---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
  ];
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Terms and Conditions | BasisPointCalculator.com";
const pageDescription =
  "Terms and conditions for using BasisPointCalculator.com financial calculators and content.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-slate-500 mb-6">
      <a href={getLocalizedUrl("/legal/", locale)} class="hover:text-sky-600"
        >Legal</a
      >
      <span class="mx-2">/</span>
      <span class="text-slate-800">Terms & Conditions</span>
    </nav>

    <article class="prose prose-slate max-w-none">
      <h1>Terms and Conditions</h1>
      <p class="text-sm text-slate-500">Last updated: February 2024</p>

      <p>
        Welcome to BasisPointCalculator.com. By accessing and using this website, you
        accept and agree to be bound by these Terms and Conditions.
      </p>

      <h2>1. Acceptance of Terms</h2>
      <p>
        By using this website, you confirm that you have read, understood, and
        agree to these Terms and Conditions. If you do not agree, please do not
        use our website.
      </p>

      <h2>2. Use of Calculators</h2>
      <p>Our financial calculators are provided for:</p>
      <ul>
        <li>Educational and informational purposes only</li>
        <li>General calculations and estimates</li>
        <li>Personal financial planning exploration</li>
      </ul>
      <p>
        Calculator results are estimates and should not be relied upon for final
        financial decisions. Always consult qualified professionals for
        important financial matters.
      </p>

      <h2>3. No Financial Advice</h2>
      <p>
        Nothing on this website constitutes financial, investment, tax, or legal
        advice. We are not financial advisors, and our tools should not replace
        professional guidance.
      </p>

      <h2>4. Accuracy of Information</h2>
      <p>
        While we strive for accuracy, we make no guarantees about the accuracy,
        completeness, or reliability of:
      </p>
      <ul>
        <li>Calculator results</li>
        <li>Educational content</li>
        <li>Any information on this website</li>
      </ul>

      <h2>5. User Responsibilities</h2>
      <p>You agree to:</p>
      <ul>
        <li>Use the website lawfully and responsibly</li>
        <li>Verify important calculations independently</li>
        <li>Not attempt to harm or disrupt the website</li>
        <li>Not use automated tools to access the site excessively</li>
      </ul>

      <h2>6. Intellectual Property</h2>
      <p>
        All content on this website, including text, graphics, logos, and
        calculator code, is owned by BasisPointCalculator.com or its licensors. You may
        not copy, reproduce, or distribute our content without permission.
      </p>

      <h2>7. Third-Party Links</h2>
      <p>
        Our website may contain links to third-party websites. We are not
        responsible for the content, privacy practices, or accuracy of external
        sites.
      </p>

      <h2>8. Limitation of Liability</h2>
      <p>
        To the maximum extent permitted by law, BasisPointCalculator.com shall not be
        liable for any:
      </p>
      <ul>
        <li>Direct, indirect, or consequential damages</li>
        <li>Financial losses based on calculator results</li>
        <li>Errors or omissions in content</li>
        <li>Website downtime or technical issues</li>
      </ul>

      <h2>9. Indemnification</h2>
      <p>
        You agree to indemnify and hold harmless BasisPointCalculator.com from any claims
        arising from your use of the website or violation of these terms.
      </p>

      <h2>10. Modifications</h2>
      <p>
        We reserve the right to modify these Terms at any time. Continued use of
        the website after changes constitutes acceptance of the new terms.
      </p>

      <h2>11. Governing Law</h2>
      <p>
        These Terms shall be governed by and construed in accordance with
        applicable laws, without regard to conflict of law principles.
      </p>

      <h2>12. Contact</h2>
      <p>
        For questions about these Terms, contact us at: <a
          href="mailto:legal@basispoint.org">legal@basispoint.org</a
        >
      </p>
    </article>

    <div class="mt-12 flex gap-4">
      <a
        href={getLocalizedUrl("/legal/privacy-policy/", locale)}
        class="text-sm text-sky-600 hover:underline">Privacy Policy</a
      >
      <a
        href={getLocalizedUrl("/legal/disclaimer/", locale)}
        class="text-sm text-sky-600 hover:underline">Disclaimer</a
      >
    </div>
  </main>
</Layout>
