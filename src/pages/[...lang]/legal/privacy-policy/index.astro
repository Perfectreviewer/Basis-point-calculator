---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
  locales,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale === "en" ? undefined : locale },
  }));
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Privacy Policy | BasisPointCalculator.com";
const pageDescription =
  "Learn how BasisPointCalculator.com handles your data and protects your privacy.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-slate-500 mb-6">
      <a href={getLocalizedUrl("/legal/", locale)} class="hover:text-sky-600"
        >Legal</a
      >
      <span class="mx-2">/</span>
      <span class="text-slate-800">Privacy Policy</span>
    </nav>

    <article class="prose prose-slate max-w-none">
      <h1>Privacy Policy</h1>
      <p class="text-sm text-slate-500">Last updated: February 2024</p>

      <div class="not-prose bg-green-50 border-l-4 border-green-400 p-4 my-6">
        <p class="font-medium text-green-800">Privacy First</p>
        <p class="text-green-700 mt-2">
          All calculations happen in your browser. We don't collect, store, or
          have access to the numbers you enter in our calculators.
        </p>
      </div>

      <h2>Information We Collect</h2>
      <h3>Calculator Data</h3>
      <p>
        We do <strong>not</strong> collect any data you enter into our calculators.
        All calculations are performed locally in your web browser. Your financial
        data never leaves your device.
      </p>

      <h3>Analytics Data</h3>
      <p>We may collect anonymous usage data including:</p>
      <ul>
        <li>Pages visited</li>
        <li>Browser type and version</li>
        <li>Device type (mobile/desktop)</li>
        <li>General geographic region</li>
        <li>Referring website</li>
      </ul>
      <p>
        This data is used to improve our website and is not linked to any
        personally identifiable information.
      </p>

      <h3>Contact Information</h3>
      <p>
        If you contact us via email, we will store your email address and the
        content of your message to respond to your inquiry. We will not share
        this information with third parties or use it for marketing purposes.
      </p>

      <h2>Cookies</h2>
      <p>We use minimal cookies for:</p>
      <ul>
        <li>
          <strong>Essential cookies:</strong> To remember your language preference
        </li>
        <li>
          <strong>Analytics cookies:</strong> To understand how visitors use our site
          (can be disabled)
        </li>
      </ul>
      <p>
        We do not use cookies for advertising or tracking across other websites.
      </p>

      <h2>Third-Party Services</h2>
      <p>We may use the following third-party services:</p>
      <ul>
        <li><strong>Web hosting:</strong> To serve our website</li>
        <li>
          <strong>Analytics:</strong> To understand site usage (privacy-focused analytics)
        </li>
      </ul>
      <p>We do not sell your data to third parties.</p>

      <h2>Data Security</h2>
      <p>
        We implement appropriate security measures to protect any information we
        do collect. Since calculator data never leaves your browser, it remains
        secure on your device.
      </p>

      <h2>Your Rights</h2>
      <p>You have the right to:</p>
      <ul>
        <li>Know what data we have about you (if any)</li>
        <li>Request deletion of any data we may have</li>
        <li>Opt out of analytics tracking</li>
        <li>Contact us with privacy concerns</li>
      </ul>

      <h2>Children's Privacy</h2>
      <p>
        Our website is not directed at children under 13. We do not knowingly
        collect personal information from children.
      </p>

      <h2>Changes to This Policy</h2>
      <p>
        We may update this policy from time to time. Changes will be posted on
        this page with an updated revision date.
      </p>

      <h2>Contact Us</h2>
      <p>
        For privacy-related questions, please contact us at: <a
          href="mailto:privacy@basispoint.org">privacy@basispoint.org</a
        >
      </p>
    </article>

    <div class="mt-12 flex gap-4">
      <a
        href={getLocalizedUrl("/legal/terms-and-conditions/", locale)}
        class="text-sm text-sky-600 hover:underline">Terms & Conditions</a
      >
      <a
        href={getLocalizedUrl("/legal/disclaimer/", locale)}
        class="text-sm text-sky-600 hover:underline">Disclaimer</a
      >
    </div>
  </main>
</Layout>
