---
import CalculatorLayout, {
  getStaticPaths as getStaticPathsCalc,
} from "@theme/layouts/CalculatorLayout.astro";
import { getTranslations, type Locale } from "@theme/i18n/utils";

export const getStaticPaths = getStaticPathsCalc;

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Bond Duration Calculator";
const pageDescription =
  "Calculate Macaulay duration and modified duration to measure bond price sensitivity to interest rate changes.";

const relatedCalculators = [
  {
    name: "Bond Yield Calculator",
    url: "/bond-calculators/bond-yield-calculator/",
  },
  {
    name: "Bond Price Calculator",
    url: "/bond-calculators/bond-price-calculator/",
  },
  {
    name: "Yield to Maturity Calculator",
    url: "/bond-calculators/yield-to-maturity-calculator/",
  },
];

const faqs = [
  {
    question: "What is bond duration?",
    answer:
      "Duration measures a bond's sensitivity to interest rate changes. A duration of 5 means the bond price will change ~5% for each 1% change in interest rates.",
  },
  {
    question: "Macaulay vs Modified Duration?",
    answer:
      "Macaulay duration is the weighted average time to receive cash flows. Modified duration adjusts for yield and directly measures price sensitivity.",
  },
  {
    question: "Why does duration matter?",
    answer:
      "Duration helps you understand interest rate risk. Higher duration means more price volatility when rates change.",
  },
];
---

<CalculatorLayout
  title={pageTitle}
  description={pageDescription}
  calculatorType="bond"
  relatedCalculators={relatedCalculators}
  faqs={faqs}
>
  <section class="bg-white rounded-2xl shadow-lg p-6">
    <h1 class="text-2xl font-semibold text-slate-800">{pageTitle}</h1>
    <p class="text-sm text-slate-500 mt-1">
      Measure your bond's sensitivity to interest rate changes.
    </p>

    <div class="mt-6 space-y-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="face-value" class="block text-sm mb-2 text-slate-600"
            >Face Value</label
          >
          <div class="relative">
            <span
              class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
              >$</span
            >
            <input
              id="face-value"
              type="number"
              step="100"
              class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pl-8 focus:outline-none focus:ring-2 focus:ring-sky-200"
              placeholder="1000"
            />
          </div>
        </div>
        <div>
          <label for="coupon-rate" class="block text-sm mb-2 text-slate-600"
            >Coupon Rate</label
          >
          <div class="relative">
            <input
              id="coupon-rate"
              type="number"
              step="0.125"
              class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pr-10 focus:outline-none focus:ring-2 focus:ring-sky-200"
              placeholder="5"
            />
            <span
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"
              >%</span
            >
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="ytm" class="block text-sm mb-2 text-slate-600"
            >Yield to Maturity</label
          >
          <div class="relative">
            <input
              id="ytm"
              type="number"
              step="0.1"
              class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 pr-10 focus:outline-none focus:ring-2 focus:ring-sky-200"
              placeholder="6"
            />
            <span
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"
              >%</span
            >
          </div>
        </div>
        <div>
          <label
            for="years-to-maturity"
            class="block text-sm mb-2 text-slate-600">Years to Maturity</label
          >
          <input
            id="years-to-maturity"
            type="number"
            step="1"
            class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-sky-200"
            placeholder="10"
          />
        </div>
        <div>
          <label
            for="payments-per-year"
            class="block text-sm mb-2 text-slate-600">Payments/Year</label
          >
          <select
            id="payments-per-year"
            class="w-full bg-white border border-slate-200 rounded-lg py-3 px-4"
          >
            <option value="1">Annual (1)</option>
            <option value="2" selected>Semi-annual (2)</option>
            <option value="4">Quarterly (4)</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4">
        <div class="bg-sky-50 rounded-lg p-4">
          <label class="block text-sm text-slate-600 mb-1"
            >Macaulay Duration</label
          >
          <div id="macaulay-duration" class="text-2xl font-bold text-sky-600">
            0.00 years
          </div>
        </div>
        <div class="bg-green-50 rounded-lg p-4">
          <label class="block text-sm text-slate-600 mb-1"
            >Modified Duration</label
          >
          <div id="modified-duration" class="text-2xl font-bold text-green-600">
            0.00
          </div>
        </div>
      </div>

      <div class="bg-purple-50 rounded-lg p-4">
        <label class="block text-sm text-slate-600 mb-1">Bond Price</label>
        <div id="bond-price" class="text-xl font-bold text-purple-600">
          $0.00
        </div>
      </div>

      <div class="bg-amber-50 rounded-lg p-4">
        <h3 class="font-medium text-amber-800 mb-2">Price Sensitivity</h3>
        <p class="text-sm text-amber-700">
          If yields increase by 1%, this bond's price would decrease by
          approximately <strong id="price-change">0%</strong>.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white rounded-2xl shadow-lg p-6 mt-6">
    <h2 class="text-xl font-semibold text-slate-800">Duration Formulas</h2>
    <div class="mt-4 space-y-4 text-sm">
      <div class="p-4 bg-slate-50 rounded-lg">
        <h3 class="font-medium text-slate-700 mb-2">Macaulay Duration</h3>
        <code class="text-slate-800">D = Σ[t × PV(CFt)] / Price</code>
        <p class="text-xs text-slate-500 mt-1">
          Weighted average time to receive cash flows
        </p>
      </div>
      <div class="p-4 bg-slate-50 rounded-lg">
        <h3 class="font-medium text-slate-700 mb-2">Modified Duration</h3>
        <code class="text-slate-800"
          >ModD = Macaulay Duration / (1 + YTM/n)</code
        >
        <p class="text-xs text-slate-500 mt-1">Price sensitivity measure</p>
      </div>
    </div>
  </section>

  <script>
    const faceValue = document.getElementById("face-value") as HTMLInputElement;
    const couponRate = document.getElementById(
      "coupon-rate",
    ) as HTMLInputElement;
    const ytmInput = document.getElementById("ytm") as HTMLInputElement;
    const yearsToMaturity = document.getElementById(
      "years-to-maturity",
    ) as HTMLInputElement;
    const paymentsPerYear = document.getElementById(
      "payments-per-year",
    ) as HTMLSelectElement;

    const macaulayEl = document.getElementById("macaulay-duration");
    const modifiedEl = document.getElementById("modified-duration");
    const priceEl = document.getElementById("bond-price");
    const priceChangeEl = document.getElementById("price-change");

    function formatCurrency(v: number) {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 2,
      }).format(v);
    }

    function calculate() {
      const F = parseFloat(faceValue.value) || 0;
      const rate = parseFloat(couponRate.value) || 0;
      const ytm = parseFloat(ytmInput.value) || 0;
      const years = parseFloat(yearsToMaturity.value) || 0;
      const m = parseInt(paymentsPerYear.value) || 2;

      const C = (F * (rate / 100)) / m;
      const y = ytm / 100 / m;
      const periods = years * m;

      let price = 0;
      let weightedTime = 0;

      for (let t = 1; t <= periods; t++) {
        const pv = C / Math.pow(1 + y, t);
        price += pv;
        weightedTime += t * pv;
      }
      const pvFace = F / Math.pow(1 + y, periods);
      price += pvFace;
      weightedTime += periods * pvFace;

      const macaulayDuration = price > 0 ? weightedTime / price / m : 0;
      const modifiedDuration = macaulayDuration / (1 + y);

      if (macaulayEl)
        macaulayEl.textContent = macaulayDuration.toFixed(2) + " years";
      if (modifiedEl) modifiedEl.textContent = modifiedDuration.toFixed(2);
      if (priceEl) priceEl.textContent = formatCurrency(price);
      if (priceChangeEl)
        priceChangeEl.textContent = modifiedDuration.toFixed(2) + "%";
    }

    [faceValue, couponRate, ytmInput, yearsToMaturity].forEach((el) =>
      el.addEventListener("input", calculate),
    );
    paymentsPerYear.addEventListener("change", calculate);

    faceValue.value = "1000";
    couponRate.value = "5";
    ytmInput.value = "6";
    yearsToMaturity.value = "10";
    calculate();
  </script>
</CalculatorLayout>
