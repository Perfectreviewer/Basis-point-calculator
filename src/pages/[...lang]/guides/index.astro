---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
  ];
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Financial Guides — Learn About Basis Points, Rates & More";
const pageDescription =
  "In-depth guides on basis points, interest rates, central bank decisions, loans, and APR. Build your financial literacy with clear, practical explanations.";

const guides = [
  {
    title: "What are Basis Points?",
    description:
      "A complete primer on basis points (bps) — what they are, why finance uses them instead of percentages, and how to convert between the two.",
    url: "/guides/what-are-basis-points/",
    icon: "📐",
    color: "sky",
    readTime: "5 min read",
  },
  {
    title: "How Interest Rates Work",
    description:
      "Understand simple vs. compound interest, how banks set rates, and the real cost of borrowing over time.",
    url: "/guides/how-interest-rates-work/",
    icon: "📈",
    color: "green",
    readTime: "7 min read",
  },
  {
    title: "Central Bank Rate Changes",
    description:
      "How Federal Reserve and central bank decisions ripple through the economy — from mortgage rates to savings accounts.",
    url: "/guides/central-bank-rate-changes/",
    icon: "🏛️",
    color: "purple",
    readTime: "6 min read",
  },
  {
    title: "Basis Points Impact on Loans",
    description:
      "See the real dollar impact of a 25 or 50 basis point change on your mortgage, auto loan, and student debt payments.",
    url: "/guides/basis-points-impact-on-loans/",
    icon: "💵",
    color: "orange",
    readTime: "5 min read",
  },
  {
    title: "APR vs Interest Rate",
    description:
      "Learn the critical difference between APR and nominal interest rate, and why APR is the number that really matters when comparing loans.",
    url: "/guides/apr-vs-interest-rate/",
    icon: "⚖️",
    color: "indigo",
    readTime: "4 min read",
  },
];

const colorClasses: Record<string, { card: string; badge: string }> = {
  sky: {
    card: "bg-sky-50 border-sky-200 hover:border-sky-400 hover:shadow-sky-100",
    badge: "bg-sky-100 text-sky-700",
  },
  green: {
    card: "bg-green-50 border-green-200 hover:border-green-400 hover:shadow-green-100",
    badge: "bg-green-100 text-green-700",
  },
  purple: {
    card: "bg-purple-50 border-purple-200 hover:border-purple-400 hover:shadow-purple-100",
    badge: "bg-purple-100 text-purple-700",
  },
  orange: {
    card: "bg-orange-50 border-orange-200 hover:border-orange-400 hover:shadow-orange-100",
    badge: "bg-orange-100 text-orange-700",
  },
  indigo: {
    card: "bg-indigo-50 border-indigo-200 hover:border-indigo-400 hover:shadow-indigo-100",
    badge: "bg-indigo-100 text-indigo-700",
  },
};

const faqs = [
  {
    question: "What is a basis point in simple terms?",
    answer:
      "A basis point is one hundredth of one percent (0.01%). If an interest rate goes from 3.00% to 3.25%, that's a 25 basis point increase. Finance professionals use basis points to avoid ambiguity when discussing small rate changes.",
  },
  {
    question: "Why do I need to understand interest rates?",
    answer:
      "Interest rates directly affect the cost of every loan you take (mortgages, car loans, credit cards) and the return on every investment. Even a small rate change — measured in basis points — can mean thousands of dollars over the life of a loan.",
  },
  {
    question: "How often does the Federal Reserve change rates?",
    answer:
      "The Federal Open Market Committee (FOMC) meets 8 times per year and may adjust the federal funds rate at any meeting. Changes are typically 25 basis points, though larger moves of 50 or 75 bps happen during periods of economic stress.",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- FAQPage Schema -->
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    })}
  />

  <!-- Hero -->
  <section class="text-center mb-12">
    <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href={getLocalizedUrl("/", locale)} class="hover:text-sky-600">Home</a>
      <span class="mx-2">›</span>
      <span class="text-slate-700">Guides</span>
    </nav>
    <h1 class="text-4xl font-bold text-slate-800 mb-4">Financial Guides</h1>
    <p class="text-lg text-slate-600 max-w-3xl mx-auto">
      Build your financial knowledge with clear, practical explanations of the
      concepts that affect your money — from basis points to APR to central bank
      decisions.
    </p>
  </section>

  <!-- Intro -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-4">
      Why Financial Literacy Matters
    </h2>
    <div class="text-slate-600 space-y-3 text-sm leading-relaxed">
      <p>
        Financial literacy is the foundation of sound money decisions. When you
        understand how interest rates work, what basis points mean in a rate
        announcement, or how APR differs from a nominal rate, you can negotiate
        better loan terms, choose smarter investments, and avoid costly
        misunderstandings.
      </p>
      <p>
        Our guides break down complex financial concepts into plain language
        with real-world examples. Each guide is written to be read in under 10
        minutes, so you can build knowledge even on a busy schedule.
      </p>
    </div>
  </section>

  <!-- Guides Grid -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-slate-800 mb-6">Our Guides</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        guides.map((guide) => (
          <a
            href={getLocalizedUrl(guide.url, locale)}
            class={`block p-6 rounded-xl border-2 transition-all duration-200 hover:shadow-lg hover:-translate-y-1 ${colorClasses[guide.color].card}`}
          >
            <div class="flex items-start gap-4">
              <span class="text-4xl">{guide.icon}</span>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-lg font-semibold text-slate-800">
                    {guide.title}
                  </h3>
                </div>
                <p class="text-sm text-slate-600 mb-3">{guide.description}</p>
                <span
                  class={`text-xs font-medium px-2 py-0.5 rounded-full ${colorClasses[guide.color].badge}`}
                >
                  {guide.readTime}
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Quick Reference -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-4">Quick Reference</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-slate-50 rounded-lg p-4">
        <h3 class="font-medium text-slate-700 mb-2">1 Basis Point</h3>
        <code class="text-sky-600 text-lg">= 0.01%</code>
      </div>
      <div class="bg-slate-50 rounded-lg p-4">
        <h3 class="font-medium text-slate-700 mb-2">100 Basis Points</h3>
        <code class="text-sky-600 text-lg">= 1.00%</code>
      </div>
      <div class="bg-slate-50 rounded-lg p-4">
        <h3 class="font-medium text-slate-700 mb-2">Typical Fed Move</h3>
        <code class="text-sky-600 text-lg">25 bps (0.25%)</code>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">
      Frequently Asked Questions
    </h2>
    <div class="divide-y divide-slate-100">
      {
        faqs.map((faq) => (
          <details class="group py-4 first:pt-0 last:pb-0">
            <summary class="flex items-center justify-between cursor-pointer font-medium text-slate-800 hover:text-sky-600 transition-colors">
              {faq.question}
              <svg
                class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Cross-links -->
  <section
    class="bg-gradient-to-r from-slate-50 to-sky-50 rounded-2xl p-8 border border-slate-200"
  >
    <h2 class="text-lg font-semibold text-slate-800 mb-4">
      Put Knowledge Into Practice
    </h2>
    <p class="text-sm text-slate-600 mb-5">
      Ready to crunch some numbers? Try our free calculators or read the latest
      articles.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href={getLocalizedUrl("/calculators/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 text-white rounded-lg hover:bg-sky-700 transition-colors text-sm"
      >
        🧮 Open Calculators
      </a>
      <a
        href={getLocalizedUrl("/blog/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-slate-200 hover:border-sky-400 transition-colors text-sm"
      >
        📝 Blog Articles
      </a>
      <a
        href={getLocalizedUrl("/faq/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-slate-200 hover:border-sky-400 transition-colors text-sm"
      >
        ❓ FAQ
      </a>
    </div>
  </section>
</Layout>
