---
import CalculatorLayout, {
  getStaticPaths as getStaticPathsCalc,
} from "@theme/layouts/CalculatorLayout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export const getStaticPaths = getStaticPathsCalc;

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "BPS to Percentage Conversion: The Complete Guide";
const pageDescription =
  "Convert basis points to percentage instantly. Full formula, conversion chart (1 bps to 10,000 bps), step-by-step examples, and a free BPS-to-% calculator.";

const relatedCalculators = [
  {
    name: "BPS to Percentage",
    url: "/bps-calculators/basis-point-to-percentage/",
  },
  {
    name: "Percentage to BPS",
    url: "/bps-calculators/percentage-to-basis-point/",
  },
  {
    name: "BPS Difference",
    url: "/bps-calculators/basis-point-difference-calculator/",
  },
];

const faqs = [
  {
    question: "How many basis points is 0.5%?",
    answer: "0.5% × 100 = 50 basis points.",
  },
  {
    question: "How many basis points is 0.25%?",
    answer: "0.25% × 100 = 25 basis points (a quarter-point).",
  },
  {
    question: "Is 100 basis points equal to 1%?",
    answer: "Yes. 100 bps ÷ 100 = 1.00%. This is the fundamental relationship.",
  },
  {
    question: "What is 1000 basis points as a percentage?",
    answer: "1,000 ÷ 100 = 10.00%.",
  },
  {
    question: "What does 10 bps mean?",
    answer: "10 basis points = 0.10%, or one-tenth of one percent.",
  },
  {
    question: "How do I convert bps to decimal in Excel?",
    answer: "Use the formula =A1/10000 where A1 is your basis point cell.",
  },
  {
    question: "Can basis points be negative?",
    answer:
      "Yes. A rate decrease of 25 bps = −0.25%. You'll see negative bps used when rates fall or spreads tighten.",
  },
];
---

<CalculatorLayout
  title={pageTitle}
  description={pageDescription}
  calculatorType="guide"
  relatedCalculators={relatedCalculators}
  faqs={faqs}
>
  <article class="prose prose-slate max-w-none">
    <h1 class="text-3xl font-bold text-slate-800">{pageTitle}</h1>

    <!-- Quick Formula Box -->
    <div class="not-prose bg-sky-50 rounded-xl p-6 my-6">
      <p class="text-lg text-slate-700">
        <strong>The One Formula You Need:</strong> Percentage = Basis Points ÷ 100
      </p>
      <p class="text-sm text-slate-500 mt-2">
        And the reverse: Basis Points = Percentage × 100
      </p>
    </div>

    <h2>Quick Examples</h2>
    <div class="not-prose overflow-x-auto my-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-4 py-2 text-left">Calculation</th>
            <th class="px-4 py-2 text-left">Result</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b"
            ><td class="px-4 py-2">25 bps ÷ 100</td><td
              class="px-4 py-2 font-semibold">0.25%</td
            ></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">50 bps ÷ 100</td><td
              class="px-4 py-2 font-semibold">0.50%</td
            ></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">100 bps ÷ 100</td><td
              class="px-4 py-2 font-semibold">1.00%</td
            ></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">300 bps ÷ 100</td><td
              class="px-4 py-2 font-semibold">3.00%</td
            ></tr
          >
        </tbody>
      </table>
    </div>

    <!-- Low-Range Chart -->
    <h2>Complete BPS to Percentage Conversion Chart</h2>

    <h3>Low-Range BPS (1–100 bps)</h3>
    <div class="not-prose overflow-x-auto my-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-4 py-2 text-left">Basis Points</th>
            <th class="px-4 py-2 text-left">Percentage</th>
            <th class="px-4 py-2 text-left">Decimal</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b"
            ><td class="px-4 py-2">1 bps</td><td class="px-4 py-2">0.01%</td><td
              class="px-4 py-2">0.0001</td
            ></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">2 bps</td><td class="px-4 py-2">0.02%</td><td
