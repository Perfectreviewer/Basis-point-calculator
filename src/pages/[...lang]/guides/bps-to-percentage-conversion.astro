          >
          <tr class="border-b"
            ><td class="px-4 py-2">90 bps</td><td class="px-4 py-2">0.90%</td
            ><td class="px-4 py-2">0.009</td></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">100 bps</td><td class="px-4 py-2">1.00%</td
            ><td class="px-4 py-2">0.01</td></tr
          >
        </tbody>
      </table>
    </div>

    <!-- Mid-Range Chart -->
    <h3>Mid-Range BPS (100–1,000 bps)</h3>
    <div class="not-prose overflow-x-auto my-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-4 py-2 text-left">Basis Points</th>
            <th class="px-4 py-2 text-left">Percentage</th>
            <th class="px-4 py-2 text-left">Decimal</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b"
            ><td class="px-4 py-2">100 bps</td><td class="px-4 py-2">1.00%</td
            ><td class="px-4 py-2">0.01</td></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">125 bps</td><td class="px-4 py-2">1.25%</td
            ><td class="px-4 py-2">0.0125</td></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">150 bps</td><td class="px-4 py-2">1.50%</td
            ><td class="px-4 py-2">0.015</td></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">175 bps</td><td class="px-4 py-2">1.75%</td
            ><td class="px-4 py-2">0.0175</td></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">200 bps</td><td class="px-4 py-2">2.00%</td
            ><td class="px-4 py-2">0.02</td></tr
          >
          <tr class="border-b"
            ><td class="px-4 py-2">250 bps</td><td class="px-4 py-2">2.50%</td
            ><td class="px-4 py-2">0.025</td></tr
          >
          <tr class="border-b"
