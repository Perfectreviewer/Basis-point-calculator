---
import Layout from "@theme/layouts/Layout.astro";
import {
  getTranslations,
  type Locale,
  getLocalizedUrl,
} from "@theme/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
  ];
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const pageTitle = "Financial Education Blog | BasisPointCalculator.com";
const pageDescription =
  "Expert articles on basis points, interest rates, and investment strategies. Learn how financial concepts affect your money with clear, actionable insights.";

const categories = [
  {
    title: "Basis Point Articles",
    description:
      "Understand how basis points work in practice — from Fed rate announcements to bond trading spreads and fee comparisons.",
    url: "/blog/basis-point-articles/",
    icon: "📐",
    color: "sky",
    articles: [
      "What 25 Basis Points Really Means",
      "Fed Rate Changes Explained",
      "Basis Points in Bond Trading",
    ],
  },
  {
    title: "Interest Rate Articles",
    description:
      "Practical advice on navigating interest rates — when to lock in, when to refinance, and what rate movements mean for your wallet.",
    url: "/blog/interest-rate-articles/",
    icon: "📈",
    color: "green",
    articles: [
      "Fixed vs Variable Rates",
      "When to Refinance",
      "Rate Predictions",
    ],
  },
  {
    title: "Investment Articles",
    description:
      "Strategic insights on compound interest, bond investing, ROI measurement, and building long-term wealth.",
    url: "/blog/investment-articles/",
    icon: "💰",
    color: "purple",
    articles: [
      "Power of Compound Interest",
      "Bond Investing Basics",
      "ROI Explained",
    ],
  },
];

const colorClasses: Record<string, { card: string; tag: string }> = {
  sky: {
    card: "bg-sky-50 border-sky-200 hover:border-sky-400 hover:shadow-sky-100",
    tag: "bg-sky-100 text-sky-700",
  },
  green: {
    card: "bg-green-50 border-green-200 hover:border-green-400 hover:shadow-green-100",
    tag: "bg-green-100 text-green-700",
  },
  purple: {
    card: "bg-purple-50 border-purple-200 hover:border-purple-400 hover:shadow-purple-100",
    tag: "bg-purple-100 text-purple-700",
  },
};

const faqs = [
  {
    question: "How often do you publish new articles?",
    answer:
      "We publish new articles regularly as financial markets evolve. Each piece is reviewed for accuracy before publication. Subscribe to stay updated on the latest content.",
  },
  {
    question: "Who writes these articles?",
    answer:
      "Our articles are written and reviewed by our editorial team with a focus on accuracy and clarity. Read our Editorial Policy for more details on our standards.",
  },
  {
    question: "Can I use your articles for educational purposes?",
    answer:
      "Our content is intended for educational use. Please cite BasisPointCalculator.com when referencing our material, and review our Terms & Conditions for full usage guidelines.",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- FAQPage Schema -->
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    })}
  />

  <!-- Hero -->
  <section class="text-center mb-12">
    <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href={getLocalizedUrl("/", locale)} class="hover:text-sky-600">Home</a>
      <span class="mx-2">›</span>
      <span class="text-slate-700">Blog</span>
    </nav>
    <h1 class="text-4xl font-bold text-slate-800 mb-4">
      Financial Education Blog
    </h1>
    <p class="text-lg text-slate-600 max-w-3xl mx-auto">
      Expert insights on basis points, interest rates, and investment strategies
      to help you make informed financial decisions.
    </p>
  </section>

  <!-- Intro -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-4">
      Stay Ahead of the Numbers
    </h2>
    <div class="text-slate-600 space-y-3 text-sm leading-relaxed">
      <p>
        Financial markets move fast. A 25 basis point rate change from the Fed
        can ripple through mortgage rates, savings yields, and bond prices
        within hours. Our blog keeps you informed with clear, jargon-free
        explanations of the numbers that matter.
      </p>
      <p>
        Whether you're a student learning the fundamentals, an investor tracking
        rate movements, or a homeowner weighing refinancing options, our
        articles translate complex financial data into actionable knowledge.
      </p>
    </div>
  </section>

  <!-- Category Cards -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-slate-800 mb-6">Browse by Topic</h2>
    <div class="grid gap-5">
      {
        categories.map((cat) => (
          <a
            href={getLocalizedUrl(cat.url, locale)}
            class={`block p-6 rounded-xl border-2 transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5 ${colorClasses[cat.color].card}`}
          >
            <div class="flex items-start gap-4">
              <span class="text-4xl">{cat.icon}</span>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-slate-800 mb-1">
                  {cat.title}
                </h3>
                <p class="text-sm text-slate-600 mb-4">{cat.description}</p>
                <div class="flex flex-wrap gap-2">
                  {cat.articles.map((article) => (
                    <span
                      class={`text-xs px-2.5 py-1 rounded-full font-medium ${colorClasses[cat.color].tag}`}
                    >
                      {article}
                    </span>
                  ))}
                </div>
              </div>
              <svg
                class="w-6 h-6 text-slate-400 mt-1 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured Topics -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">Featured Topics</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-gradient-to-br from-sky-50 to-sky-100 rounded-lg p-4">
        <span class="text-2xl mb-2 block">🏛️</span>
        <h3 class="font-medium text-slate-800 mb-1">Fed Rate Decisions</h3>
        <p class="text-xs text-slate-600">
          How central bank announcements affect your finances day-to-day.
        </p>
      </div>
      <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-lg p-4">
        <span class="text-2xl mb-2 block">🏠</span>
        <h3 class="font-medium text-slate-800 mb-1">Mortgage Strategy</h3>
        <p class="text-xs text-slate-600">
          When to lock rates, refinance, and read your loan statement.
        </p>
      </div>
      <div
        class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg p-4"
      >
        <span class="text-2xl mb-2 block">📊</span>
        <h3 class="font-medium text-slate-800 mb-1">Investment Math</h3>
        <p class="text-xs text-slate-600">
          Compound interest, ROI, and the formulas behind wealth building.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">
      Frequently Asked Questions
    </h2>
    <div class="divide-y divide-slate-100">
      {
        faqs.map((faq) => (
          <details class="group py-4 first:pt-0 last:pb-0">
            <summary class="flex items-center justify-between cursor-pointer font-medium text-slate-800 hover:text-sky-600 transition-colors">
              {faq.question}
              <svg
                class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Cross-links -->
  <section
    class="bg-gradient-to-r from-slate-50 to-sky-50 rounded-2xl p-8 border border-slate-200"
  >
    <h2 class="text-lg font-semibold text-slate-800 mb-4">
      Explore More Resources
    </h2>
    <p class="text-sm text-slate-600 mb-5">
      Go deeper with in-depth guides or run the numbers with our free
      calculators.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href={getLocalizedUrl("/calculators/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 text-white rounded-lg hover:bg-sky-700 transition-colors text-sm"
      >
        🧮 Open Calculators
      </a>
      <a
        href={getLocalizedUrl("/guides/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-slate-200 hover:border-sky-400 transition-colors text-sm"
      >
        📚 Financial Guides
      </a>
      <a
        href={getLocalizedUrl("/faq/", locale)}
        class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-slate-200 hover:border-sky-400 transition-colors text-sm"
      >
        ❓ FAQ
      </a>
    </div>
  </section>
</Layout>
