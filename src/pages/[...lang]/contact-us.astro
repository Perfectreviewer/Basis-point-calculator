---
import Layout from "@theme/layouts/Layout.astro";
import ContactForm from "@theme/components/ContactForm.astro";
import { getTranslations, type Locale } from "@theme/i18n/utils";
import indexTranslations from "~/i18n/index.json";
import siteSettings from "~/config/site-settings.json";

export function getStaticPaths() {
  return Object.keys(indexTranslations).map((locale) => ({
    params: { lang: locale === "en" ? undefined : locale },
  }));
}

const locale = (Astro.params.lang || "en") as Locale;
const t = getTranslations(locale);

const cp = (siteSettings as any).contactPage || {};
const pageTitle = cp.pageTitle || t["Contact"] || "Contact Us";
const pageSubtitle = cp.pageSubtitle || "";
const seoTitle = cp.seoTitle || `${pageTitle} | ${t.site_title}`;
const seoDescription = cp.seoDescription || "";
---

<Layout title={seoTitle} description={seoDescription}>

  <div class="max-w-2xl mx-auto">

    <!-- Hero -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 bg-sky-50 border border-sky-100 rounded-2xl mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </div>
      <h1 class="text-4xl font-bold text-slate-900">{pageTitle}</h1>
      {pageSubtitle && (
        <p class="mt-3 text-slate-600 text-lg max-w-md mx-auto leading-relaxed">{pageSubtitle}</p>
      )}
    </div>

    <!-- Trust signals -->
    <div class="grid grid-cols-3 gap-3 mb-2">
      <div class="bg-white border border-slate-100 rounded-xl p-4 text-center shadow-sm">
        <div class="w-8 h-8 bg-green-50 rounded-lg flex items-center justify-center mx-auto mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <p class="text-xs text-slate-600 font-medium leading-snug">We read every message</p>
      </div>
      <div class="bg-white border border-slate-100 rounded-xl p-4 text-center shadow-sm">
        <div class="w-8 h-8 bg-sky-50 rounded-lg flex items-center justify-center mx-auto mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <p class="text-xs text-slate-600 font-medium leading-snug">Your data stays private</p>
      </div>
      <div class="bg-white border border-slate-100 rounded-xl p-4 text-center shadow-sm">
        <div class="w-8 h-8 bg-amber-50 rounded-lg flex items-center justify-center mx-auto mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <p class="text-xs text-slate-600 font-medium leading-snug">Bugs & ideas welcome</p>
      </div>
    </div>

    <!-- Form -->
    <ContactForm />

  </div>

</Layout>
